*.zip.building

# Historical deployment output stays local. Retain runtime entry sources,
# lockfiles, configuration examples, and the fixture script required by tests.
/deploy/cloudbase/*
!/deploy/cloudbase/.gitignore
!/deploy/cloudbase/api/
!/deploy/cloudbase/bridge/
!/deploy/cloudbase/pay-notify/
!/deploy/cloudbase/build.py
!/deploy/cloudbase/resources.json
!/deploy/cloudbase/cos-photo-policy.json
!/deploy/cloudbase/miniprogram.config.example.js
!/deploy/cloudbase/qa-controlled-load.js

# Generated visual matrices, browser previews and historical design mockups.
# Already tracked images remain tracked; this does not delete local files.
/docs/images/
/docs/design/
