/* Opaque by default. Only the material blurs; buttons and icons stay sharp. */
.tab-bar { position:fixed; z-index:90; left:18px; right:18px; bottom:calc(10px + env(safe-area-inset-bottom)); max-width:444px; margin:0 auto; padding:0 6px; display:flex; justify-content:space-between; align-items:center; height:64px; box-sizing:border-box; }
.glass-surface { position:absolute; top:0; right:0; bottom:0; left:0; border-radius:32px; background:rgba(255,255,255,.95); background-image:linear-gradient(140deg,rgba(255,255,255,.18),rgba(255,255,255,0) 55%,rgba(255,255,255,.08)); border:1px solid rgba(255,255,255,.85); box-shadow:0 5px 24px rgba(35,39,43,.10),inset 0 -1px 0 rgba(60,65,70,.05); pointer-events:none; }
@supports ((-webkit-backdrop-filter:blur(1px)) or (backdrop-filter:blur(1px))) {
  .glass-surface { background-color:rgba(255,255,255,.40); -webkit-backdrop-filter:blur(20px) saturate(120%); backdrop-filter:blur(20px) saturate(120%); }
}
/* Explicit fallback also lets the simulator verify the unsupported appearance. */
.glass-fallback .glass-surface { background-color:rgba(255,255,255,.95); -webkit-backdrop-filter:none; backdrop-filter:none; }
.glass-no-blur .glass-surface { -webkit-backdrop-filter:none; backdrop-filter:none; }
.nav-button, .new-entry-choice, .new-entry-close { margin:0; padding:0; border:0; background:transparent; color:#707070; font-family:inherit; line-height:1.2; }
.nav-button::after, .new-entry-choice::after, .new-entry-close::after { border:0; }
.tab-bar .tab { position:relative; flex:1 1 0; min-width:44px; width:0; height:48px; margin:0; border-radius:24px; display:flex; flex-direction:column; justify-content:center; align-items:center; gap:1px; font-size:11px; }
.tab-icon { width:26px; height:26px; opacity:.65; pointer-events:none; }
.tab.selected { color:#292929; background:rgba(255,225,90,.14); font-weight:600; }
.tab.selected .tab-icon { opacity:1; }
.tab-bar .add { position:relative; flex:0 0 64px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px; width:64px; min-width:64px; max-width:64px; height:64px; min-height:64px; max-height:64px; box-sizing:border-box; border-radius:50%; background:#FFE15A; color:#292929; margin-top:-20px; box-shadow:0 2px 8px rgba(125,107,35,.12),inset 0 1px 0 rgba(255,255,255,.65); }
.add-icon { display:block; width:32px; height:34px; pointer-events:none; }
.add-label { font-size:12px; font-weight:600; pointer-events:none; }
.tab-bar .add.pressed { background:#F6D643; transform:translateY(1px); }
.icon-fallback{width:24px;height:24px;border:1.5px solid #888;border-radius:7px;line-height:24px;text-align:center;font-size:14px;box-sizing:border-box;pointer-events:none}.paw-fallback{font-size:30px;line-height:34px}
.new-entry-panel{max-width:480px;margin:0 auto;padding:16px 18px calc(18px + env(safe-area-inset-bottom));border-radius:24px 24px 0 0;box-sizing:border-box;background:#FFFFFF;color:#292929}
.new-entry-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:14px}.new-entry-heading-copy{min-width:0}.new-entry-title{display:block;font-size:20px;font-weight:700;line-height:1.5;overflow-wrap:anywhere}
.new-entry-panel .new-entry-close{position:relative;flex:none;width:44px;min-width:44px;max-width:44px;height:44px;margin:-4px -6px 0 0;background:transparent}.new-entry-close-mark::before,.new-entry-close-mark::after{content:"";position:absolute;left:13px;top:21px;width:18px;height:2px;border-radius:2px;background:#777;transform:rotate(45deg)}.new-entry-close-mark::after{transform:rotate(-45deg)}
.new-entry-grid{display:flex;align-items:stretch;gap:12px;width:100%}
.new-entry-panel .new-entry-choice{display:flex;flex:1 1 0;flex-direction:column;align-items:center;justify-content:center;gap:10px;width:0;min-width:0;min-height:170px;box-sizing:border-box;padding:14px 10px;margin:0;border-radius:20px;white-space:normal;text-align:center;line-height:1.5;color:#292929;font-weight:400}.new-entry-ledger{background:#FFF6CF}.new-entry-item{background:#FFF0F3}.new-entry-icon{width:56px;height:56px;flex:none;pointer-events:none}.new-entry-copy{flex:none;min-width:0;max-width:100%}.new-entry-name{display:block;font-size:20px;font-weight:600;line-height:1.4}.new-entry-caption{display:block;font-size:12px;font-weight:400;color:#777;line-height:1.5;margin-top:4px;overflow-wrap:anywhere}.entry-pressed{opacity:.8}
@media(max-width:350px){.tab-bar{left:12px;right:12px}.tab-bar .add{flex-basis:56px;width:56px;min-width:56px;max-width:56px;height:56px;min-height:56px;max-height:56px;margin-top:-16px}.add-icon{width:28px;height:28px}.new-entry-panel{padding-left:14px;padding-right:14px}.new-entry-panel .new-entry-choice{min-height:156px}.new-entry-icon{width:48px;height:48px}}

.tab-bar .add{background:var(--member-accent,#FFE15A)}.tab.selected{background:var(--member-soft,rgba(255,225,90,.14))}
.nav-button,.new-entry-choice{transition:transform 120ms ease-out,background-color 160ms ease-out}
.tab-bar .tab:active,.tab-bar .add.pressed,.new-entry-choice.entry-pressed{transform:scale(var(--motion-press,.98))}
.tab.nav-bounce .tab-icon{animation:nav-paw-pop 220ms ease-out both}
@keyframes nav-paw-pop{0%{transform:translateY(0) scale(.96)}55%{transform:translateY(-3px) scale(1.06) rotate(-3deg)}100%{transform:translateY(0) scale(1) rotate(0)}}
@media(prefers-reduced-motion:reduce){.nav-button,.new-entry-choice{transition-duration:80ms}.tab.nav-bounce .tab-icon{animation:none}.tab-bar .tab:active,.tab-bar .add.pressed,.new-entry-choice.entry-pressed{transform:none}}
