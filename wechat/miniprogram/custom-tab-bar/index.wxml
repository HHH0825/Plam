<view style="{{memberThemeStyle}}" wx:if="{{!hidden && !menuOpen}}" class="tab-bar {{glassFallback ? 'glass-fallback' : ''}} {{glassNoBlur ? 'glass-no-blur' : ''}}">
  <view class="glass-surface" aria-hidden="true"></view>
  <button class="nav-button tab tab-ledger {{tabMotionRoute === 'pages/ledger/index' ? 'nav-bounce' : ''}} {{selectedRoute === 'pages/ledger/index' ? 'selected' : ''}}" data-route="pages/ledger/index" bindtap="switchTab" aria-label="记账" aria-current="{{selectedRoute === 'pages/ledger/index' ? 'page' : 'false'}}"><image wx:if="{{!iconErrors.ledger}}" class="tab-icon" src="/assets/ledger-nav/ledger.png" mode="aspectFit" data-key="ledger" binderror="iconFailed" aria-hidden="true"/><view wx:else class="icon-fallback" aria-hidden="true">账</view><text>记账</text></button>
  <button class="nav-button tab tab-items {{tabMotionRoute === 'pages/items/index' ? 'nav-bounce' : ''}} {{selectedRoute === 'pages/items/index' ? 'selected' : ''}}" data-route="pages/items/index" bindtap="switchTab" aria-label="物品" aria-current="{{selectedRoute === 'pages/items/index' ? 'page' : 'false'}}"><image wx:if="{{!iconErrors.items}}" class="tab-icon" src="/assets/white-doodle/compact-nav-items.png" mode="aspectFit" data-key="items" binderror="iconFailed" aria-hidden="true"/><view wx:else class="icon-fallback" aria-hidden="true">物</view><text>物品</text></button>
  <button class="nav-button add" bindtap="add" hover-class="pressed" aria-label="新增，选择记一笔或添物品"><image wx:if="{{!iconErrors.paw}}" class="add-icon" src="/assets/white-doodle/paw-button.png" mode="aspectFit" data-key="paw" binderror="iconFailed" aria-hidden="true"/><text wx:else class="paw-fallback" aria-hidden="true">＋</text><text class="add-label">新增</text></button>
  <button class="nav-button tab tab-statistics {{tabMotionRoute === 'pages/statistics/index' ? 'nav-bounce' : ''}} {{selectedRoute === 'pages/statistics/index' ? 'selected' : ''}}" data-route="pages/statistics/index" bindtap="switchTab" aria-label="统计" aria-current="{{selectedRoute === 'pages/statistics/index' ? 'page' : 'false'}}"><image wx:if="{{!iconErrors.statistics}}" class="tab-icon" src="/assets/ledger-nav/statistics.png" mode="aspectFit" data-key="statistics" binderror="iconFailed" aria-hidden="true"/><view wx:else class="icon-fallback" aria-hidden="true">图</view><text>统计</text></button>
  <button class="nav-button tab tab-me {{tabMotionRoute === 'pages/me/index' ? 'nav-bounce' : ''}} {{selectedRoute === 'pages/me/index' ? 'selected' : ''}}" data-route="pages/me/index" bindtap="switchTab" aria-label="我的" aria-current="{{selectedRoute === 'pages/me/index' ? 'page' : 'false'}}"><image wx:if="{{!iconErrors.me}}" class="tab-icon" src="/assets/white-doodle/compact-nav-me.png" mode="aspectFit" data-key="me" binderror="iconFailed" aria-hidden="true"/><view wx:else class="icon-fallback" aria-hidden="true">我</view><text>我的</text></button>
</view>
<page-container show="{{menuOpen}}" position="bottom" duration="{{motionReduced ? 80 : 180}}" z-index="130" round="{{true}}" close-on-slide-down="{{false}}" overlay-style="background:rgba(41,41,41,.28)" custom-style="background:transparent" bindclickoverlay="closeMenu" bindbeforeleave="beforeMenuLeave" bindafterleave="afterMenuLeave">
  <view class="new-entry-panel" role="dialog" aria-modal="true" aria-label="新增，选择记录内容">
    <view class="new-entry-heading"><view class="new-entry-heading-copy"><text class="new-entry-title">今天，记下什么？</text></view><button class="new-entry-close" bindtap="closeMenu" aria-label="关闭新增菜单"><view class="new-entry-close-mark" aria-hidden="true"/></button></view>
    <view class="new-entry-grid">
      <button class="new-entry-choice new-entry-ledger" data-action="ledger" bindtap="chooseEntry" hover-class="entry-pressed"><image wx:if="{{!iconErrors.ledger}}" class="new-entry-icon" src="/assets/ledger-nav/ledger.png" mode="aspectFit" data-key="ledger" binderror="iconFailed" aria-hidden="true"/><view class="new-entry-copy"><text class="new-entry-name">记一笔</text><text class="new-entry-caption">日常收支，慢慢记清楚</text></view></button>
      <button class="new-entry-choice new-entry-item" data-action="item" bindtap="chooseEntry" hover-class="entry-pressed"><image wx:if="{{!iconErrors.box}}" class="new-entry-icon" src="/assets/items-header/entry-storage.png" mode="aspectFit" data-key="box" binderror="iconFailed" aria-hidden="true"/><view class="new-entry-copy"><text class="new-entry-name">添物品</text><text class="new-entry-caption">给喜欢的小物建份档案</text></view></button>
    </view>
  </view>
</page-container>
