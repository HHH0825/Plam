@import "styles/page-dots.wxss";
@import "styles/motion.wxss";
page {
  --bg: #FFFFFF; --paper: #FFFFFF; --primary: #FFE15A; --accent: #292929;
  --peach: #FFDCE6; --peach-ink: #292929; --yellow: #FFE15A; --yellow-ink: #292929;
  --mint: #E5F1EA; --mint-ink: #292929; --lavender: #F3EDF6; --lavender-ink: #292929;
  --blue: #42657A; --blue-soft: #DDF0FF; --ink: #292929; --muted: #707070;
  --ink-soft: #5F5F5F; --danger: #A34E3B; --danger-soft: #FAEEEA;
  --neutral: #F4F4F4; --neutral-ink: #707070; --line: #EAEAEA; --ledger: #FFFFFF; --radius: 14px;
  --sage: #E5F1EA; --rose: #FFDCE6; --tape: #FFE15A;
  --glass-fill: rgba(255, 255, 255, 1);
  --glass-pressed: #FFF9DA;
  --glass-line: rgba(132, 86, 69, .20);
  --glass-highlight: rgba(255, 255, 255, .92);
  --glass-shadow: rgba(41,41,41, .07);
  --glass-selection-pressed: #D2DCCB;
  --glass-radius: 18px;
  background-color: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  font-size: 15px; line-height: 1.5;
}
.page { position: relative; z-index: 0; width: 100%; max-width: 480px; margin: 0 auto; padding: 18px 18px calc(28px + env(safe-area-inset-bottom)); box-sizing: border-box; }
.page-heading { position: relative; margin: 4px 0 14px; }
.eyebrow { color: var(--muted); font-size: 11px; letter-spacing: 1.5px; }
.title { font-size: 24px; line-height: 1.25; font-weight: 700; margin: 5px 0 6px; letter-spacing: 0.5px; overflow-wrap: anywhere; }
.subtitle { color: var(--muted); font-size: 13px; line-height: 1.65; }
.card { background: var(--paper); border: 0.5px solid var(--line); border-radius: var(--radius); padding: 14px; margin: 10px 0; box-shadow: 0 2px 0 rgba(41,41,41, .035); box-sizing: border-box; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.muted { color: var(--muted); font-size: 12px; }
.small { font-size: 12px; }
.pill { display: inline-block; color: var(--lavender-ink); background: var(--lavender); padding: 3px 8px; border-radius: 49.5px; font-size: 11px; line-height: 1.5; white-space: nowrap; }
.status-active { background:#FCE4ED; color:#93435F; }
.status-idle { color: var(--yellow-ink); background: var(--yellow); }
.status-disposed { color: var(--neutral-ink); background: var(--neutral); }
.button { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 8px 14px; box-sizing: border-box; background: var(--primary); color: var(--ink); border-radius: 10px; font-size: 14px; line-height: 1.4; font-weight: 600; margin: 0; transition: transform .12s ease; }
.button::after { border: 0; }
.button.light, .button.mint { background: var(--ledger); color: var(--ink-soft); border: 0.5px solid var(--line); }
.button.warn { background: var(--danger-soft); color: var(--danger); }
.button[disabled] { opacity: 1; color: var(--neutral-ink); background: var(--neutral); }
.button.block { width: 100%; margin-top: 12px; }
.button.paper-action { position: relative; width: 100%; max-width: 360px; height: 56px; min-height: 56px; padding: 0; margin: 12px auto 0; border: 0; border-radius: 0; background: transparent; }
.button.paper-action[disabled] { background: transparent; color: var(--ink); }
.paper-action paper-label { display: block; width: 100%; }
/* Custom-component hosts are decoration too; the native button handles taps. */
.paper-action paper-label, .add-button paper-label, paper-background { pointer-events: none; }
/* Keep the native loading spinner beside the text, without shifting the paper artwork. */
.paper-action::before { position: absolute; z-index: 2; left: calc(50% - 62px); top: 20px; margin: 0; }
.button-hover { transform: translateY(1px); }
/* The opaque-enough paper tint works without blur. Blur only enhances the surface. */
.warm-glass, .button.warm-glass {
  background: var(--glass-fill); color: var(--ink);
  border: .5px solid var(--glass-line); border-radius: var(--glass-radius);
  box-shadow: inset 0 1px 0 var(--glass-highlight), inset 0 -1px 0 rgba(255, 255, 255, .35), 0 3px 10px var(--glass-shadow);
  -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
  box-sizing: border-box; transition: background-color .12s ease;
}
.button.warm-glass::after { border: 0; }
.warm-glass.glass-pressed, .button.warm-glass.glass-pressed { background: var(--glass-pressed); }
.button.warm-glass[disabled] { background: var(--glass-fill); color: var(--neutral-ink); }
.button.warm-glass[disabled]::after { border: 0; }
@media (prefers-reduced-motion: reduce) { .warm-glass, .button.warm-glass { transition: none; } }
.text-button { padding: 8px 0; color: var(--accent); font-size: 12px; }
.field { display: block; margin: 12px 0; color: var(--ink); font-size: 13px; }
.field-label { display: block; margin-bottom: 6px; font-weight: 500; }
.optional { color: var(--muted); font-size: 11.5px; font-weight: 400; }
.field input, .field textarea, .field .picker { display: block; width: 100%; box-sizing: border-box; min-height: 44px; padding: 10px; color: var(--ink); background: var(--paper); border: 1px solid var(--line); border-radius: 8px; font-size: 15px; line-height: 1.5; }
.field input:focus, .field textarea:focus { border-color: var(--accent); }
.field .is-focused { border-color: var(--accent); box-shadow: 0 0 0 1.5px var(--peach); }
.field-placeholder { color: var(--muted); }
.field textarea { height: 90px; }
.field .picker { display: flex; align-items: center; justify-content: space-between; }
.picker-caret { color: var(--muted); font-size: 12px; margin-left: 6px; }
.field-note { color: var(--muted); font-size: 11.5px; margin-top: 5px; }
.empty { text-align: center; color: var(--muted); padding: 32px 12px; line-height: 1.7; }
.empty-mark { display: block; font-size: 23px; color: var(--accent); margin-bottom: 8px; }
.empty-title { display: block; color: var(--ink); font-size: 15px; font-weight: 600; margin-bottom: 6px; }
.empty .button { margin: 12px auto 0; max-width: 170px; }
.error { color: var(--danger); padding: 11px 0; font-size: 13px; overflow-wrap: anywhere; }
.error-panel { background: var(--danger-soft); padding: 14px; color: var(--danger); }
.error-panel .button { margin-top: 10px; }
.line { height: 0.5px; background: var(--line); margin: 11px 0; }
.icon { display: inline-flex; justify-content: center; align-items: center; width: 40px; height: 40px; border-radius: 11px; background: var(--blue-soft); color: var(--blue); font-size: 20px; flex: none; }
.item-name { font-size: 16px; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
.metric { flex: 1; min-width: 0; }
.metric-label { display: block; color: var(--muted); font-size: 11px; }
.metric-value { display: block; font-size: 16px; line-height: 1.3; font-weight: 600; color: var(--ink); margin-top: 4.5px; overflow-wrap: anywhere; }
.metric-unit { font-size: 11.5px; font-weight: 400; margin-left: 2px; }
.section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin: 16px 0 7px; }
.section-title { font-size: 16px; font-weight: 600; }
.section-note { color: var(--muted); font-size: 11.5px; }
.form-card { margin-top: 10px; }
.form-card .field:first-child { margin-top: 0; }
.form-card .field:last-child { margin-bottom: 0; }
.form-card paper-label { display: block; margin: -3px 0 12px; }
.form-footer { margin-top: 14px; }
@media (prefers-reduced-motion: reduce) { .button { transition: none; } .button-hover { transform: none; } }

/* Stickers sit in reserved space, never on top of interactive controls. */
.heading-layout { display: flex; align-items: center; gap: 12px; }
.heading-copy { flex: 1; min-width: 0; }
.heading-copy .row { flex-wrap: wrap; gap: 6px; }
.heading-cat { flex: none; width: 72px; height: 78px; pointer-events: none; }
.empty-cat { display: block; width: 132px; height: 120px; margin: 0 auto 16px; pointer-events: none; }
.tiny-cat { display: block; width: 44px; height: 44px; flex: none; pointer-events: none; }
.section-title { position: relative; padding-left: 10px; }
.section-title::before { content: ''; position: absolute; left: 0; top: 4px; width: 3px; height: 16px; background: var(--accent); border-radius: 1px; opacity: .55; }
.tone-holding { --metric-mark: var(--yellow); }
.tone-purchase { --metric-mark: var(--mint); }
.tone-net { --metric-mark: var(--lavender); }
.tone-total { --metric-mark: var(--peach); }
.metric .metric-label::before, .sample-caption::before { content: ''; display: inline-block; width: 12px; height: 4px; border-radius: 2px; background: var(--metric-mark); margin-right: 4px; vertical-align: middle; }
.tone-holding .metric-label, .tone-holding .metric-value, .tone-holding .metric-unit,
.tone-purchase .metric-label, .tone-purchase .metric-value, .tone-purchase .metric-unit,
.tone-net .metric-label, .tone-net .metric-value, .tone-net .metric-unit,
.tone-total .metric-label, .tone-total .metric-value, .tone-total .metric-unit { color: var(--ink); }
.metric .metric-label { color: var(--muted); }
@media (max-width: 350px) { .page { padding-left: 16px; padding-right: 16px; } .heading-cat { width: 58px; height: 68px; } .title { font-size: 25px; } .heading-copy .eyebrow { letter-spacing: .5px; } }
@media (min-width: 600px) { .page { padding-left: 24px; padding-right: 24px; } }

/* White doodle theme: surfaces stay white; accents identify actions and status. */
page { --radius:16px; --glass-line:#EAEAEA; --glass-shadow:rgba(41,41,41,.03); --glass-selection-pressed:#FFF9DA; }
.card { border-radius:16px; box-shadow:none; }
input, textarea { background:#FFFFFF; }
.heading-cat, .heading-postmark, .empty-cat { pointer-events:none; }
.button.light, .button.mint { background:#FFFFFF; }

/* Membership controls use the same quiet white / cat-doodle vocabulary. */
.member-custom-theme.ledger-home .ledger-journal-panel,.member-custom-theme.ledger-statistics .ledger-journal-panel,.member-custom-theme .ledger-summary,.member-custom-theme.me-page .profile-hero{background:var(--member-soft)}
.member-custom-theme .calendar-binding,.member-custom-theme .ledger-book-main-number::after,.member-custom-theme .ledger-panel-month-label::after,.member-custom-theme .ledger-segments .selected,.member-custom-theme.ledger-statistics .statistics-view-switch>button.selected,.member-custom-theme.collection-page .sheet-apply,.member-custom-theme.me-page .amount-dialog-close{background:var(--member-accent);border-color:var(--member-accent)}
.member-custom-theme .calendar-day.selected-day,.member-custom-theme .ledger-category.selected,.member-custom-theme .ledger-icon-button.is-active,.member-custom-theme .ledger-query-chip,.member-custom-theme.collection-page .view-button.selected,.member-custom-theme.collection-page .filter-choice.chosen,.member-custom-theme.collection-page .held-search-control.applied,.member-custom-theme.collection-page .filter-control.applied{background:var(--member-soft);border-color:var(--member-accent)}
.member-entry{display:flex;align-items:center;gap:10px;width:100%;padding:15px 12px;margin:16px 0;border:1px solid #F0CE5F;border-radius:16px;background:var(--member-soft,#FFFBE8);text-align:left;line-height:1.6;white-space:normal;color:#292929}.member-entry::after{border:0}.member-entry image{width:38px;height:44px;flex:none}.member-entry-copy{flex:1;min-width:0}.member-entry-title{font-size:16px;font-weight:600}.member-entry-badge{display:inline-block;font-size:10px;padding:1px 6px;border:1px solid #E5C95C;border-radius:12px;margin-left:6px}.member-entry .muted{font-size:11px;margin-top:4px}.member-entry-arrow{font-size:11px;flex:none}.member-ledger-toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin:4px 0 14px}.member-switch{font-size:13px;font-weight:600;padding:10px 12px;background:var(--member-soft,#FFF9DE);border-radius:14px}.member-shortcut{display:inline-block;background:transparent;font-size:12px;padding:8px 6px;margin:0;color:#655B38;line-height:1.6;white-space:normal}.member-shortcut::after{border:0}.member-tool-error{display:flex;align-items:center;font-size:11px;color:#795E16;margin:8px 0}.member-tool-error button{font-size:11px;background:transparent;padding:4px 8px;margin:0}.member-themed .button,.member-themed .ledger-primary{background:var(--member-accent,var(--primary))}.member-themed .button.light,.member-themed .button.mint,.member-themed .button[disabled]{background:var(--paper,#FFF)}.member-themed .button.warn{background:var(--danger-soft)}.member-themed .ledger-book,.member-themed .ledger-book-panel{background-color:var(--member-soft,#FFF9DE)}
.member-themed .member-entry{width:100%!important;max-width:none!important;box-sizing:border-box;font-weight:400}
.member-ledger-toolbar{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;align-items:stretch;margin:2px 0 10px;flex-wrap:nowrap;padding:5px;background:var(--member-soft,#FFF9DE);border:1px solid #EDE6CF;border-radius:17px;box-sizing:border-box}
.member-toolbar-picker{display:block;min-width:0}
.member-ledger-toolbar .member-switch,.member-ledger-toolbar .member-shortcut{display:flex;align-items:center;justify-content:center;gap:5px;box-sizing:border-box;width:100%!important;max-width:none!important;min-width:0;min-height:46px;height:100%;padding:9px 5px;margin:0!important;border:0;border-radius:0;background:transparent;color:#655E48;font-size:12px;font-weight:500;line-height:1.5;white-space:normal}
.member-ledger-toolbar .member-switch{background:rgba(255,255,255,.85);border-radius:12px;color:#423D2F;font-weight:600}.member-ledger-toolbar>.member-shortcut+.member-shortcut{border-left:1px solid #DAD3BF}.member-ledger-toolbar>.member-shortcut:last-child{border-radius:0 12px 12px 0}
.member-toolbar-icon{width:15px;height:17px;flex:none}.member-toolbar-label{min-width:0;overflow-wrap:anywhere}.member-book-label{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.member-toolbar-caret{flex:none;font-size:10px}.member-budget-summary{font-size:11px;color:#7C714D;line-height:1.5;margin:-4px 4px 10px;overflow-wrap:anywhere}
.member-custom-theme .ledger-calendar,.member-custom-theme .ledger-book-panel,.member-custom-theme .ledger-book{background-color:var(--member-soft)}
.member-custom-theme .statistics-view-switch .selected,.member-custom-theme .calendar-day.selected-day,.member-custom-theme .ledger-progress-fill{background:var(--member-accent)}

.page.member-custom-theme .ledger-calendar,.page.member-custom-theme .ledger-journal-panel,.page.member-custom-theme .ledger-book-panel,.page.member-custom-theme .ledger-book{background:var(--member-soft)}
.page.member-custom-theme .statistics-view-switch>button.selected,.page.member-custom-theme .calendar-day.selected-day,.page.member-custom-theme .ledger-progress-fill{background:var(--member-accent);border-color:var(--member-accent)}

.book-filter-caret{display:block;width:6px;height:6px;flex:none;border-right:1.5px solid #8B8575;border-bottom:1.5px solid #8B8575;transform:rotate(45deg);margin:0 2px 3px 6px}

/* Compact budget status: the whole card opens the current month and book. */
.ledger-budget-card{margin:0 0 14px;border:1px solid #ECE7D9;border-radius:14px;background:rgba(255,255,255,.82);overflow:hidden}.ledger-budget-card .budget-card-main{display:flex;position:relative;align-items:center;gap:10px;width:100%!important;min-height:66px;padding:11px 13px 15px;margin:0;border:0;border-radius:0;background:transparent;text-align:left;line-height:1.6;white-space:normal;color:#4D4735;font-weight:400;box-sizing:border-box}.budget-card-main::after{border:0}.budget-card-copy{flex:1;min-width:0}.budget-card-title{font-size:15px;font-weight:600;overflow-wrap:anywhere}.budget-card-note{font-size:11px;color:#89816C;margin-top:1px;overflow-wrap:anywhere}.budget-card-action{flex:none;font-size:12px;color:#977B32}.budget-card-track{position:absolute;bottom:0;left:0;right:0;height:4px;background:#F0EDE4}.budget-card-track>view{height:4px;background:var(--member-accent,#E4BD4C);border-radius:0 4px 4px 0}.budget-card-over .budget-card-title{color:#A34E3B}.budget-card-over .budget-card-track>view{background:#D18C70}.ledger-budget-card .budget-card-main[disabled]{opacity:1;color:#827A65}

.account-tools-group{margin:0 0 8px}.account-tools-heading{display:flex;align-items:center;gap:9px;width:100%!important;max-width:none!important;min-height:44px;box-sizing:border-box;padding:6px 3px;margin:0;border:0;border-radius:0;background:transparent;font-size:12px;font-weight:400;line-height:1.6;white-space:normal;text-align:left;color:#8A8067}.account-tools-heading::after{border:0}.account-tools-title{flex:none;color:#75684A;font-weight:500}.account-tools-scope{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px;text-align:right;color:#98907D}.account-tools-scope.is-filtered{color:#8E6C25;font-weight:600}.account-tools-sign{position:relative;flex:none;width:26px;height:26px;border-radius:50%;background:var(--member-soft,#FFF8DE)}.account-sign-horizontal,.account-sign-vertical{position:absolute;background:#AA9253;border-radius:1px;left:8px;right:8px;height:2px;top:12px}.account-sign-vertical{height:auto;width:2px;top:8px;bottom:8px;left:12px;right:auto}.account-tools-panel{padding-top:4px}.account-tools-panel .member-ledger-toolbar{margin-top:0}.account-tools-panel .ledger-budget-card{margin-bottom:8px}

/* Theme submit indicator keeps button labels aligned while requests run. */
.cat-loading-button{display:flex;align-items:center;justify-content:center;gap:6px}.cat-loading-button>cat-loading{flex:0 0 auto}
