/* Approved cat-in-a-box header. Only the held collection imports these styles. */
.held-page .collection-hero { padding:16px 18px 6px; margin-bottom:12px; }
.held-hero-wash { position:absolute; inset:0; pointer-events:none; background:radial-gradient(ellipse at 92% 16%,rgba(255,247,224,.92) 0%,rgba(255,247,224,.65) 30%,rgba(255,247,224,0) 76%); }
.held-page .collection-heading { min-height:154px; gap:8px; align-items:center; }
.held-page .heading-copy { padding-right:0; }
.held-page .collection-heading .eyebrow { font-size:12px; line-height:1.6; color:#777777; }
.held-page .heading-title { margin-top:7px; }
.held-page .title { font-size:34px; font-weight:700; line-height:1.3; color:#292929; white-space:nowrap; }
.held-page .title-underline { width:100%; height:12px; left:1px; bottom:-5px; }
.held-page .held-subtitle { margin-top:13px; font-size:14px; line-height:1.8; color:#777777; }
.held-count { font-size:30px; line-height:1.2; font-weight:700; color:#292929; }
.held-count.held-count-long { font-size:22px; }
.held-slow { white-space:nowrap; }
.held-page .held-kitten { flex:none; width:112px; max-width:32%; height:124px; margin:8px -2px 0 0; }
.held-page .hero-paw { display:none; }
.held-page .hero-star { top:15px; right:125px; width:14px; height:14px; opacity:.75; }
.held-page .hero-dot { top:20px; right:26px; width:6px; height:6px; }
.held-page .hero-dot-small { bottom:16px; right:137px; width:6px; height:6px; }
.held-page .search-wrap { min-height:50px; border-radius:18px; padding:0 14px; }
.held-page .search-symbol { position:relative; display:block; flex:none; width:18px; height:18px; margin-right:10px; font-size:0; }
.held-page .search-symbol::before { content:""; position:absolute; top:1px; left:1px; width:10px; height:10px; border:1.8px solid #888888; border-radius:50%; }
.held-page .search-symbol::after { content:""; position:absolute; top:12px; left:12px; width:7px; height:1.8px; border-radius:2px; background:#888888; transform:rotate(45deg); transform-origin:left center; }
.held-page .search { font-size:15px; }
.held-page .collection-tools { margin-top:12px; }
.held-page .purchase-entries { gap:8px; margin-bottom:10px; }
.held-page .purchase-entries button,
.held-page .purchase-entries.entries-stacked button { flex-direction:column; gap:4px; min-height:70px; padding:8px 5px; border-radius:16px; white-space:normal; font-size:14px; }
.held-page .purchase-entry-icon { width:30px; height:30px; }
.held-page .purchase-entry-label { flex:none; max-width:100%; overflow-wrap:anywhere; }
.held-page .collection-results-tools{justify-content:flex-end;margin:0 0 8px;min-height:44px}
.held-page .collection-filter-sort{gap:8px;max-width:100%;width:100%;min-width:0}
.held-search-region{display:flex;align-items:center;flex:1;min-width:0;gap:0}
.held-search-region.expanded{background:#FFF;border:1px solid #E7E6E1;border-radius:23px;box-sizing:border-box;min-height:44px}
.held-page .held-search-region.expanded .held-search-control{border:0;background:transparent;flex:0 0 42px;width:44px!important;min-width:44px}
.held-inline-input{flex:1;min-width:0;width:0;height:44px;font-size:14px;padding:0 3px;box-sizing:border-box}
.held-page .search-expanded .sort-picker{flex:0 0 44px;width:44px;min-width:44px;max-width:44px}
.held-page .search-expanded .sort-control{width:44px;height:44px;border-radius:50%;padding:0;background:white;border:1px solid #E7E6E1}
.held-page .search-expanded .sort-control .control-icon{width:19px;height:19px}
.held-page .held-search-control,.held-page .filter-control{position:relative;display:flex;align-items:center;justify-content:center;flex:0 0 44px;width:44px!important;min-width:44px;max-width:44px;height:44px;min-height:44px;margin:0;padding:0;background:#FFF;border:1px solid #E7E6E1;border-radius:50%;box-sizing:border-box}
.held-page .held-search-control::after,.held-page .filter-control::after{border:0}
.held-page .held-search-control.applied,.held-page .filter-control.applied{background:#FFF4CA;border-color:#E6D486}
.held-page .filter-surface{position:static;background:transparent!important;padding:0;min-height:0;gap:0}
.held-page .filter-control .control-icon{width:20px;height:20px}
.held-page .filter-count{position:absolute;right:-2px;top:-2px;min-width:15px;height:15px;box-sizing:border-box;border-radius:50%;padding:0 3px;font-size:10px;line-height:15px;justify-content:center}
.held-search-mark{position:relative;width:14px;height:14px;border:1.5px solid #555650;border-radius:50%;box-sizing:border-box;margin:-3px 3px 0 0;pointer-events:none}
.held-search-mark::after{content:"";position:absolute;right:-5px;bottom:-3px;width:7px;height:1.5px;background:#555650;transform:rotate(45deg);border-radius:2px}
.held-page .sort-picker{padding:0;min-height:44px;min-width:0;flex:0 1 auto}
.held-page .sort-control{min-height:44px;padding:8px 11px;border-radius:22px;white-space:nowrap}
.held-page .held-inline-search{min-height:44px;padding-right:0;margin:0 0 8px}
.held-page .held-inline-search input{min-height:44px;min-width:0;flex:1}
.held-search-close{display:flex;align-items:center;justify-content:center;width:44px!important;min-width:44px;max-width:44px;height:44px;padding:0;margin:0;background:transparent;font-size:23px;color:#888}
.held-query-chip{display:flex;align-items:center;justify-content:space-between;gap:8px;width:auto!important;max-width:100%;min-height:44px;margin:0 0 8px!important;padding:8px 12px;background:#FFF6DB;border-radius:14px;font-size:12px;text-align:left;line-height:1.5;box-sizing:border-box}
.held-query-chip>text:first-child{min-width:0;overflow-wrap:anywhere}
@media(max-width:350px) {
 .held-page .collection-heading { min-height:150px; gap:6px; }
 .held-page .title { font-size:30px; }
 .held-page .held-kitten { width:92px; height:106px; }
 .held-page .held-subtitle { font-size:13px; }
 .held-page .purchase-entries button,
 .held-page .purchase-entries.entries-stacked button { min-height:68px; font-size:13px; }
}

.held-page .eyebrow.with-update{display:flex;align-items:center;gap:3px;min-height:44px;min-width:0}.held-page .collection-eyebrow-label{min-width:0;overflow-wrap:anywhere}.held-page .title{white-space:normal;word-break:normal}.held-page .heading-copy{min-width:0}.held-page .item-update-entry{position:relative;flex-shrink:0;align-self:center}.item-update-entry .update-unread{position:absolute;right:1px;top:1px;width:13px;height:13px;border:1.5px solid #fffdf5;border-radius:50%;background:#eab263;color:#654318;font-size:10px;font-weight:700;line-height:13px;text-align:center;pointer-events:none}.update-icon-fallback{font-size:11px;color:#937437}.update-notice-host .member-announcement-mask{z-index:1800}.update-notice-host .member-announcement-flight{z-index:1802}.update-notice-host .member-announcement-scroll{height:300px;max-height:calc(78vh - 165px)}.update-notice-host .member-announcement-body{font-size:14px}.update-notice-host button{box-sizing:border-box;white-space:normal}.update-notice-host .member-feedback-link{padding:8px 0;line-height:28px}.update-notice-host .member-announcement-footer{flex-wrap:wrap}.update-notice-host .member-announcement-close{display:flex;align-items:center;justify-content:center}

.held-title-word{display:inline-block;white-space:nowrap}
