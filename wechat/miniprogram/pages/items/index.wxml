<page-meta page-style="{{announcementOpen ? 'overflow:hidden;' : ''}}"/>
<view wx:if="{{entryBlocked}}" class="startup-entry"><view class="startup-title">我的物品</view><view class="startup-paper"><view class="startup-line"/><view class="startup-line startup-short"/></view><view class="startup-card"/><view class="startup-card"/><text>{{sessionBusy ? '正在打开你的物品…' : '连接失败，点击重试'}}</text><text wx:if="{{sessionError}}" class="startup-error">{{sessionError}}</text><button wx:if="{{!sessionBusy}}" disabled="{{sessionBusy}}" bindtap="retrySession">重新连接</button></view>
<block wx:else>
<include src="../../templates/item-list.wxml"/>

<cat-feedback id="cat-feedback"/>

<view class="announcement-host update-notice-host">
 <image wx:if="{{announcementOpen && announcementClosing && announcementFlightStyle && !announcementFading}}" class="member-announcement-flight" src="/assets/membership/letter.png" mode="aspectFit" style="{{announcementFlightStyle}}" aria-hidden="true"/>
 <view wx:if="{{announcementOpen && updateNotice}}" class="member-announcement-mask {{announcementClosing ? 'announcement-closing' : ''}} {{announcementFading ? 'announcement-fading' : ''}}" catchtouchmove="ignoreUpdateNoticeTouch">
  <view class="member-announcement-window" role="dialog" aria-modal="true" aria-label="更新公告">
   <view class="member-announcement-heading"><view><text class="member-announcement-eyebrow">猫爪更新小信</text><view>{{updateNotice.title}}</view></view><button class="member-announcement-close" bindtap="closeUpdateNotice" disabled="{{announcementBusy}}" aria-label="关闭更新公告">×</button></view>
   <scroll-view scroll-y class="member-announcement-scroll"><view class="member-announcement-body"><view wx:for="{{updateNotice.paragraphs}}" wx:key="index">{{item}}</view></view></scroll-view>
   <view class="member-announcement-footer"><button class="member-feedback-link" open-type="feedback">反馈与建议 ›</button><button class="member-announcement-done" bindtap="closeUpdateNotice" disabled="{{announcementBusy}}">我知道了</button></view>
  </view>
 </view>
</view>

</block>

<include src="../../templates/session-status.wxml"/>
