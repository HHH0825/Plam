.local-page{padding:24px 20px 48px;background:#fffdf5;min-height:100vh;box-sizing:border-box;color:#36352f}.hero{padding:12px 4px 24px}.eyebrow{font-size:13px;color:#8f7b4a;line-height:1.6}.title{font-size:29px;font-weight:700;line-height:1.5;margin:10px 0}.note{font-size:14px;line-height:1.8;color:#7e796e;overflow-wrap:anywhere}.card{padding:20px;background:white;border:1px solid #eae4d5;border-radius:20px;margin-bottom:18px;box-shadow:0 4px 0 #fff1bd}.heading{font-size:19px;font-weight:650;line-height:1.6;margin-bottom:10px}.amount{font-size:30px;margin:10px 0}.local-page button{font-size:15px;line-height:1.6;padding:13px 12px;white-space:normal;margin-top:14px;border-radius:13px;background:#f8f6ee;color:#554b34}.local-page button::after{border:0}.local-page .primary{background:#ffe260;font-weight:650}.local-page .danger{background:#fff0f0;color:#ba4b5e}.error{color:#ba4b5e;line-height:1.8}.filename{font-size:12px;line-height:1.8;overflow-wrap:anywhere;margin-top:12px;color:#8b8069}.reminder{padding:10px;background:#fff6cf;border-radius:10px;font-size:14px;line-height:1.7;margin-top:12px}.footer{padding:8px 4px}.title .hero-piece{display:inline-block}
