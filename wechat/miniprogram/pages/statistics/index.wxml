<import src="../../templates/ledger.wxml"/>
<view class="member-themed {{memberThemeClass}} page ledger-page ledger-tab ledger-statistics" style="{{memberThemeStyle}}">
 <view class="ledger-segments statistics-view-switch" role="group" aria-label="统计视图"><button id="statistics-view-cash" class="{{view === 'cash' ? 'selected' : ''}}" bindtap="switchView" data-key="cash" aria-pressed="{{view === 'cash'}}"><image src="/assets/theme-refresh/wallet.png" mode="aspectFit" aria-hidden="true"/><text>收支</text></button><button id="statistics-view-items" class="{{view === 'items' ? 'selected' : ''}}" bindtap="switchView" data-key="items" aria-pressed="{{view === 'items'}}"><image src="/assets/theme-refresh/box.png" mode="aspectFit" aria-hidden="true"/><text>物品</text></button></view>
 <block wx:if="{{view === 'items'}}"><include src="../../templates/item-dashboard.wxml"/></block>
 <block wx:else>
 <view wx:if="{{memberBooksState !== 'unsupported'}}" class="account-tools-group"><button class="account-tools-heading" bindtap="toggleAccountTools" aria-expanded="{{accountToolsExpanded}}" aria-controls="account-tools-panel" aria-label="账本工具，{{accountToolsHint}}，{{accountToolsExpanded ? '收起' : '展开'}}"><text class="account-tools-title">账本工具</text><text class="account-tools-scope {{accountToolsFiltered ? 'is-filtered' : ''}}">{{accountToolsHint}}</text><view class="account-tools-sign" aria-hidden="true"><view class="account-sign-horizontal"/><view wx:if="{{!accountToolsExpanded}}" class="account-sign-vertical"/></view></button><view wx:if="{{accountToolsExpanded}}" id="account-tools-panel" class="account-tools-panel motion-fold" style="{{motionFolds.accountToolsExpanded}}"><view id="account-tools-inner" class="motion-fold-inner">
 <view wx:if="{{memberSupported}}" class="member-ledger-toolbar statistics-book-toolbar"><picker class="member-toolbar-picker" range="{{memberBooks}}" range-key="name" value="{{memberBookIndex}}" bindchange="memberBookChange" aria-label="选择账本，当前{{memberBooks[memberBookIndex].name || '全部账本'}}"><view class="member-switch"><image class="member-toolbar-icon" src="/assets/membership/books.png" mode="aspectFit" aria-hidden="true"/><text class="member-toolbar-label member-book-label">{{memberBooks[memberBookIndex].name || '全部账本'}}</text><view class="book-filter-caret" aria-hidden="true"/></view></picker><button class="member-shortcut" bindtap="memberTool" data-mode="books"><image class="member-toolbar-icon" src="/assets/membership/books.png" mode="aspectFit" aria-hidden="true"/><text class="member-toolbar-label">我的账本</text></button></view><view wx:if="{{memberError}}" class="member-tool-error"><text>{{memberError}}</text><button bindtap="memberRefresh">重试</button></view>
 </view></view></view>

  <view wx:if="{{error}}" class="ledger-error">{{error}}<button class="ledger-text-button" bindtap="load">重新读取</button></view><view wx:if="{{loading && !summary}}" class="ledger-empty"><cat-loading label="正在整理统计…"/></view><template wx:if="{{!loading && !enabled}}" is="ledger-gate" data="{{supported,loading}}"/>
  <block wx:if="{{enabled && summary}}">
   <view class="ledger-calendar {{motionPanelClass}}">
    <view class="calendar-binding binding-left"/><view class="calendar-binding binding-right"/><image class="calendar-header-paw" src="/assets/purchase-entry/progress-paw.png" mode="aspectFit"/>
    <view class="calendar-month"><button class="ledger-month-arrow" hover-class="ledger-month-hover" bindtap="previous" aria-label="上个月"><view class="ledger-month-chevron previous" aria-hidden="true"/></button><picker mode="date" fields="month" value="{{month}}" end="{{maxMonth}}" start="0001-01" bindchange="monthChange" aria-label="选择月份"><view class="ledger-panel-month-label">{{monthLabel}}<view class="ledger-caret" aria-hidden="true"/></view></picker><button class="ledger-month-arrow" hover-class="ledger-month-hover" bindtap="next" disabled="{{!canNext}}" aria-label="下个月"><view class="ledger-month-chevron next" aria-hidden="true"/></button></view>
    <view class="calendar-month-totals"><view><text class="calendar-total-label">{{summary.expense_label}}</text><scroll-view scroll-x><text class="ledger-nowrap">¥{{summary.expenseText}}</text></scroll-view></view><view><text class="calendar-total-label">本月收入</text><scroll-view scroll-x><text class="ledger-nowrap">¥{{summary.incomeText}}</text></scroll-view></view></view>
    <view class="calendar-weekdays"><view wx:for="{{weekLabels}}" wx:key="*this" class="{{index > 4 ? 'weekend' : ''}}">{{item}}</view></view>
    <view class="calendar-grid"><block wx:for="{{calendarCells}}" wx:key="key">
     <view wx:if="{{item.blank}}" class="calendar-blank" aria-hidden="true"/>
     <button wx:else size="mini" class="calendar-day {{item.future ? 'future' : ''}} {{item.selected ? 'selected-day' : ''}} {{item.today ? 'is-today' : ''}}" disabled="{{item.future}}" data-date="{{item.date}}" bindtap="selectDay" aria-label="{{item.date + (item.today ? '，今天' : '') + (item.selected ? '，已选中' : '') + (item.expense ? '，原支出约' + item.expense + '元' : '') + (item.income ? '，收入约' + item.income + '元' : '') + (item.refund ? '，有退款' : '')}}">
      <image wx:if="{{item.selected}}" class="calendar-selected-paw" src="/assets/purchase-entry/progress-paw.png" mode="aspectFit"/><view class="calendar-date">{{item.day}}<text wx:if="{{item.refund}}" class="calendar-refund-marker">退</text></view>
      <view class="calendar-amount expense"><block wx:if="{{item.expense}}"><text>支</text><scroll-view scroll-x><text>{{item.expense}}</text></scroll-view></block></view><view class="calendar-amount income"><block wx:if="{{item.income}}"><text>收</text><scroll-view scroll-x><text>{{item.income}}</text></scroll-view></block></view>
     </button>
    </block></view>
    <view class="calendar-legend"><text class="expense">支：原支出</text><text class="income">收：收入</text><text>退：退款</text></view><view class="calendar-note">月支出已扣退款；格内为紧凑金额，点日期看精确值。</view>
   </view>
   <view class="ledger-measure-probes" aria-hidden="true"><text class="calendar-digit-probe">0123456789</text><text class="calendar-prefix-probe">支</text><text class="calendar-unit-probe">万</text></view>
   <view class="calendar-selected-detail"><view class="ledger-section">{{selectedLabel}}</view><view wx:if="{{selectedDay}}" class="calendar-exact-totals"><view class="expense"><text>原支出</text><scroll-view scroll-x><text class="ledger-nowrap">¥{{selectedDay.grossText}}</text></scroll-view></view><view class="income"><text>收入</text><scroll-view scroll-x><text class="ledger-nowrap">¥{{selectedDay.incomeText}}</text></scroll-view></view><view wx:if="{{selectedDay.hasRefund}}" class="refund"><text>退款</text><scroll-view scroll-x><text class="ledger-nowrap">¥{{selectedDay.refundText}}</text></scroll-view></view></view>
    <view wx:if="{{dayError}}" class="ledger-error">{{dayError}}<button class="ledger-text-button" bindtap="loadDay" disabled="{{dayLoading}}">重新读取当天流水</button></view><view wx:if="{{dayLoading && !dayEntries.length}}" class="ledger-empty"><cat-loading label="正在读取当天流水…"/></view>
    <button wx:for="{{dayEntries}}" wx:key="id" wx:for-item="row" class="ledger-row" data-id="{{row.id}}" bindtap="open"><view class="ledger-row-icon"><image wx:if="{{!iconErrors[row.id]}}" src="{{row.art}}" mode="aspectFit" data-key="{{row.id}}" binderror="iconFailed"/></view><view class="ledger-row-copy"><view class="ledger-row-name">{{row.name}}</view><view class="ledger-muted ledger-small">{{row.source_name}} · {{row.category_name}}</view><view class="ledger-recorded-time"><block wx:if="{{row.recordedAt}}"><text>记录于</text><text class="ledger-time-part">{{row.recordedAt.date}}</text><text class="ledger-time-part">{{row.recordedAt.time}}</text></block><text wx:else>记录时间暂不可用</text></view></view><view class="ledger-row-amount"><scroll-view scroll-x><text class="ledger-nowrap">¥{{row.amountText}}</text></scroll-view><view class="ledger-muted ledger-small">{{row.direction}}</view></view></button>
    <view wx:if="{{!dayEntries.length && !dayLoading && !dayError}}" class="ledger-empty">当天暂无收付记录</view><button wx:if="{{dayNextOffset !== null && daySupported}}" class="ledger-secondary" bindtap="dayMore" disabled="{{dayLoading}}">{{dayLoading ? '正在读取…' : '加载当天更多流水'}}</button>
   </view>
   <include src="../../templates/cash-analysis.wxml"/><view class="ledger-footnote">按实际收付统计，不将分期购置价与本金重复累加。</view>
  </block>
 </block>
</view>

<cat-feedback id="cat-feedback"/>

<include src="../../templates/session-status.wxml"/>
