<view class="member-themed {{memberThemeClass}} page detail-page" style="{{memberThemeStyle}}">

  <view wx:if="{{loading}}" class="empty"><cat-loading label="正在翻开这一页…"/></view>
  <view wx:if="{{error}}" class="card error-panel">{{error}}<button class="button light" hover-class="button-hover" bindtap="load">重新读取</button></view>
  <block wx:if="{{item}}">
    <view class="detail-identity">
      <view class="detail-heading">
        <view class="detail-cover"><view class="detail-hero"><image wx:if="{{photoPath}}" class="photo" src="{{photoPath}}" mode="aspectFit" binderror="photoFailed"/><view wx:else class="detail-no-photo"><image wx:if="{{!artFailed}}" class="photo-fallback-art" src="{{item.art}}" mode="aspectFit" binderror="artFailed"/><text wx:else>{{item.icon}}</text></view></view></view>
        <view class="heading-text"><view class="name-row"><text class="title">{{item.name}}</text></view><view class="heading-status"><text class="pill status-{{item.status}}">{{item.statusText}}</text><text class="heading-category">{{item.category}}</text></view><view class="cover-label">物品档案 · {{item.id}}</view></view>
      </view>
      <view class="identity-purchase"><text>{{item.purchase_date}} 购入</text><text class="purchase-amount">购买价 ¥{{item.purchase_price}}</text></view>
      <view wx:if="{{photoLoading}}" class="photo-loading"><cat-loading compact label="正在读取清晰照片…"/></view><text wx:if="{{photoUnavailable}}" class="photo-unavailable">照片暂不可用，物品资料仍可查看。</text><button wx:if="{{photoError}}" class="photo-retry" bindtap="retryPhoto">照片读取失败 · 重试</button>
    </view>
    <view class="card cost-card {{costDecorError ? 'decor-fallback' : ''}}">
      <view wx:if="{{!costDecorError}}" class="sketch-frame cost-frame" aria-hidden="true">
        <image wx:for="{{costFrameParts}}" wx:key="*this" class="cost-decor-probe" src="/assets/item-doodle/{{item}}.png" binderror="costDecorFailed" aria-hidden="true"/>
        <view class="cost-corner corner-tl"></view><view class="cost-corner corner-tr"></view><view class="cost-corner corner-bl"></view><view class="cost-corner corner-br"></view>
        <view class="cost-edge edge-top"></view><view class="cost-edge edge-bottom"></view><view class="cost-edge edge-left"></view><view class="cost-edge edge-right"></view>
      </view>
      <image wx:if="{{!costDecorError}}" class="cost-doodle" src="/assets/item-doodle/arc.png" binderror="costDecorFailed" aria-hidden="true"/>
      <view class="cost-heading"><text class="section-title">陪伴与花费</text><text class="section-note">历史成本均摊</text></view>
      <view class="cost-summary metric-region metric-available {{costLayout.kind !== 'columns' ? 'cost-stacked' : ''}}" data-id="detail" style="--metric-number-size:{{costLayout.size || 28}}px">
        <view class="metric daily-metric"><text class="metric-label">净成本 / 天</text><scroll-view class="metric-scroll" scroll-x="{{true}}" style="height:{{costLayout.height || 44}}px"><text class="metric-value">{{item.dailyNet}}</text></scroll-view></view>
        <view class="metric days-metric"><text class="metric-label">{{item.status === 'disposed' ? '曾持有' : '陪伴天数'}}</text><scroll-view class="metric-scroll" scroll-x="{{true}}" style="height:{{costLayout.height || 44}}px"><view class="metric-value">{{item.holding_days}}<text class="metric-unit">天</text></view></scroll-view></view>
      </view>
      <view class="metric-probes" aria-hidden="true"><view class="metric-probe" data-id="detail" data-size="days" style="font-size:20px">{{item.holding_days}}<text class="metric-probe-unit">天</text></view><view wx:for="{{[28,26,24]}}" wx:for-item="size" wx:key="*this" class="metric-probe" data-id="detail" data-size="{{size}}" style="font-size:{{size}}px">{{item.dailyNet}}</view></view>
      <view class="metric-probes" aria-hidden="true"><view class="metric-probe" data-id="detail" data-size="total" style="font-size:14px">¥{{item.net_cost}}</view></view>
      <view class="cost-total"><text>累计净成本</text><scroll-view class="cost-total-scroll" scroll-x="{{true}}" style="height:{{costLayout.totalHeight || 32}}px"><text class="cost-total-amount">¥{{item.net_cost}}</text></scroll-view></view>
    </view>
    <view class="detail-shortcuts"><view class="actions"><button class="button edit-primary" hover-class="button-hover" bindtap="edit" disabled="{{busy}}">编辑物品</button><button class="button light more-button" hover-class="button-hover" bindtap="more" disabled="{{busy}}">更多操作 ···</button></view></view>

    <view class="card facts"><button class="fold-heading" bindtap="toggleFacts" aria-expanded="{{factsExpanded}}"><view class="fold-row"><text class="section-title">基本资料</text><text class="section-note">{{factsExpanded ? '收起 ⌃' : '展开 ⌄'}}</text></view></button><view wx:if="{{factsExpanded}}" class="facts-body"><view class="fact-row"><text class="fact-label">购买价 / 天</text><text>{{item.dailyPurchase}}</text></view><view class="fact-row"><text class="fact-label">维修合计</text><text>¥{{item.maintenance_total}}</text></view><view class="fact-row"><text class="fact-label">订阅/分期合计</text><text>¥{{item.fixed_expense_total || '0.00'}}</text></view><view class="fact-row"><text class="fact-label">处置回收</text><text>¥{{item.disposal_proceeds}}</text></view><view class="fact-row"><text class="fact-label">保修到期</text><text>{{item.warranty_expires_on || '未填写'}}</text></view><view class="fact-note"><text class="fact-label">备注</text><view>{{item.notes || '暂无备注'}}</view></view></view></view>
    <view class="detail-storage-row"><button class="detail-storage-open" bindtap="storageLocation"><image src="/assets/purchase-entry/storage.png" aria-hidden="true"/><view><text class="detail-storage-label">{{item.status === 'disposed' ? '最后收纳位置' : '收纳位置'}}</text><text>{{item.storage_location_name || '未设置位置'}}</text></view></button><button wx:if="{{item.status !== 'disposed'}}" class="detail-storage-change" bindtap="changeStorageLocation" disabled="{{busy}}">更换</button></view>
    <button class="button light linked-expenses" bindtap="expenses">订阅/分期 · 查看与管理 ›</button>
    <view class="card records-card">
    <view class="section-head"><text class="section-title">维修与处置</text><text class="section-note">{{allTimeline.length}} 条记录</text></view>
    <view wx:if="{{item.status !== 'disposed'}}" class="actions secondary-actions"><button class="button light maintenance-action" hover-class="button-hover" data-kind="maintenance" bindtap="record" disabled="{{busy}}"><image class="action-icon" src="/assets/white-doodle/type-tools.png" mode="aspectFit" aria-hidden="true" /><text>记一笔维修</text></button><button class="button light disposal-action" hover-class="button-hover" data-kind="disposal" bindtap="record" disabled="{{busy}}"><image class="action-icon" src="/assets/white-doodle/nav-items.png" mode="aspectFit" aria-hidden="true" /><text>记录处置</text></button></view>
    <view wx:if="{{allTimeline.length === 0}}" class="compact-empty"><image class="empty-ledger" src="/assets/brand/paw-ledger-mark.png" mode="aspectFit" aria-hidden="true" /><text>还没有维修或处置记录。</text></view>
    <view wx:if="{{timeline.length}}" class="timeline"><view wx:for="{{timeline}}" wx:key="key" class="timeline-entry event-{{item.kind}}" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="editRecord"><view class="timeline-dot"></view><view class="event-date">{{item.day}}</view><view class="card event"><view class="row"><text class="event-kind">{{item.kindText}}</text><text class="muted small">编辑 ›</text></view><view class="event-text">{{item.text}}</view></view></view></view>
    <button wx:if="{{allTimeline.length > 3}}" class="journal-link" bindtap="toggleTimeline" aria-expanded="{{timelineExpanded}}">{{timelineExpanded ? '收起记录' : '查看全部 ' + allTimeline.length + ' 条记录'}}</button>
    <view class="records-caption">每一次记录，都是物品的生活轨迹。</view>
    </view>
    <view wx:if="{{historyUsage.length}}" class="card usage-history"><button class="fold-heading" bindtap="toggleHistory" aria-expanded="{{historyExpanded}}"><view class="fold-row"><text class="section-title">历史使用记录</text><text class="section-note">{{historyExpanded ? '收起 ⌃' : '查看 ⌄'}}</text></view></button><block wx:if="{{historyExpanded}}"><view class="journal-caption">保留以前录入的内容，仅供查看。</view><view wx:for="{{historyUsage}}" wx:key="id" class="history-entry"><text class="event-date">{{item.used_on}}</text><view class="event-text">{{item.notes || '记录了一次使用'}}</view></view></block></view>
  </block>
</view>

<cat-feedback id="cat-feedback"/>

<include src="../../templates/session-status.wxml"/>
