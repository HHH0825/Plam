<view class="member-themed {{memberThemeClass}} page ledger-page" style="{{memberThemeStyle}}"><view class="ledger-title">{{refund ? (editing ? '修改退款' : '添加退款') : editing ? '修改账目' : '记一笔'}}</view><view wx:if="{{loading}}" class="ledger-empty"><cat-loading label="正在打开账本…"/></view><view wx:if="{{error}}" class="ledger-error" role="alert">{{error}}<button wx:if="{{!ready && !loading}}" class="ledger-text-button" bindtap="load">重新读取</button></view><view wx:if="{{!loading && !enabled}}" class="ledger-card"><view class="ledger-section">{{supported ? '先开启你的记账本' : '功能正在准备中'}}</view><view class="ledger-muted">{{supported ? '日常收支与物品相关付款，放进同一本账。历史记录可稍后核对导入。' : '请同步新版服务端，当前不会提交账目。'}}</view><button wx:if="{{supported}}" class="ledger-primary" bindtap="enable" disabled="{{busy}}">开启记账</button><button wx:else class="ledger-secondary" bindtap="load">重新检查</button></view>
<block wx:if="{{enabled && ready}}"><view wx:if="{{!refund}}" class="ledger-segments"><button data-key="expense" class="{{form.kind === 'expense' ? 'selected' : ''}}" bindtap="kind" disabled="{{busy || pending}}">支出</button><button data-key="income" class="{{form.kind === 'income' ? 'selected' : ''}}" bindtap="kind" disabled="{{busy || pending}}">收入</button></view><view wx:if="{{parent}}" class="ledger-help">原支出：{{parent.name}} ¥{{parent.amountText}}；已退款 ¥{{parent.refunded}}</view><view class="ledger-card"><view class="ledger-muted">{{refund ? '本次退款金额' : '金额'}}</view><view class="ledger-form-amount"><text>¥</text><input type="digit" maxlength="12" value="{{form.amount}}" data-key="amount" bindinput="change" disabled="{{busy || pending}}" cursor-spacing="24" placeholder="0.00" aria-label="金额"/></view></view>
<view wx:if="{{!refund}}" class="ledger-section">分类</view><view wx:if="{{!refund}}" class="ledger-categories {{motionPanelClass}}"><button wx:for="{{categories}}" wx:key="key" class="ledger-category {{form.category === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="category" disabled="{{busy || pending}}"><image wx:if="{{!iconErrors[item.key]}}" src="{{item.art}}" mode="aspectFit" data-key="{{item.key}}" binderror="iconFailed"/><text>{{item.name}}</text></button></view>
<view class="ledger-card"><view class="ledger-form-field">名称<input value="{{form.name}}" maxlength="120" placeholder="可选，默认使用分类名称" data-key="name" bindinput="change" disabled="{{busy || pending}}" cursor-spacing="24"/></view><picker mode="date" value="{{form.occurred_on}}" end="{{today}}" data-key="occurred_on" bindchange="change" disabled="{{busy || pending}}"><view class="ledger-field"><text class="ledger-field-label">日期</text><text class="ledger-field-value">{{form.occurred_on}} ›</text></view></picker><view class="ledger-form-field">备注<textarea value="{{form.notes}}" maxlength="1000" placeholder="记下这一笔的小故事" data-key="notes" bindinput="change" disabled="{{busy || pending}}" cursor-spacing="24"/></view><picker wx:if="{{!refund}}" range="{{itemNames}}" value="{{itemIndex}}" bindchange="item" disabled="{{busy || pending || !itemsReady}}"><view class="ledger-field"><text class="ledger-field-label">关联物品</text><text class="ledger-field-value">{{itemName}} ›</text></view></picker><view wx:if="{{itemsError}}" class="ledger-help">{{itemsError}}<button class="ledger-text-button" bindtap="loadItems">重新读取</button></view></view>
<view class="ledger-help">{{refund ? '按实际退款日期冲减原分类支出，不自动修改物品价格或分期进度。' : '只记录已经发生的收付；关联物品不重复计入物品成本。'}}</view><view wx:if="{{draftNote}}" class="ledger-help">{{draftNote}}</view><view wx:if="{{pending}}" class="ledger-error">保存结果尚未确认，当前内容已保留。请核对结果或按原内容重试。<button class="ledger-text-button" bindtap="verify" disabled="{{busy}}">核对保存结果</button></view><view class="ledger-form-bottom"><button wx:if="{{conflict}}" class="ledger-secondary" bindtap="review" disabled="{{busy}}">核对最新版本</button><button class="ledger-primary" bindtap="save" disabled="{{busy || conflict}}"><image class="ledger-bottom-paw" src="/assets/white-doodle/paw-button.png" mode="aspectFit"/>{{busy ? '正在保存…' : pending ? '按原内容重试' : refund ? '保存退款' : '记好了'}}</button></view></block></view>

<cat-feedback id="cat-feedback"/>
