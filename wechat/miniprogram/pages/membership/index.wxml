<page-meta page-style="{{announcementOpen ? 'overflow: hidden;' : ''}}"/>
<view class="member-themed {{memberThemeClass}} page membership-page announcement-host" style="{{memberThemeStyle}}">
 <view class="member-hero">
  <view class="member-hero-copy"><view class="title"><text>给生活，</text><view class="member-title-ending"><text>多一点从容</text><button wx:if="{{feedbackMessage && !loading && !error}}" class="member-announcement-entry {{announcementPulse ? 'announcement-received' : ''}}" bindtap="openAnnouncement" aria-label="公告，写给你的话" aria-haspopup="dialog"><image class="member-announcement-icon" src="/assets/membership/announcement.png" mode="aspectFit" aria-hidden="true"/></button></view></view><view class="member-subtitle">按需支持，让猫爪慢慢长大</view><view class="member-hero-meta"><text wx:if="{{!loading && !error && membership.supported}}" class="member-state {{membership.active ? 'member-state-active' : ''}}">{{membership.active ? '猫爪会员 · 已开通' : membership.status === 'expired' ? '会员已到期' : '当前为免费版'}}</text><view wx:if="{{expiry && !loading && !error}}" class="member-expiry">{{membership.active ? '有效期至' : '到期于'}} {{expiry}}</view></view></view>
  <image src="/assets/membership/hero.png" mode="aspectFit" class="member-cat" aria-hidden="true"/>
 </view>
 <view wx:if="{{loading}}" class="empty"><cat-loading label="正在读取会员资料…"/></view><view wx:elif="{{error}}" class="error-panel card">{{error}}<button class="button light" bindtap="load">重新读取</button></view>
 <block wx:else><view wx:if="{{membership.supported}}" class="member-plans"><button wx:for="{{plans}}" wx:key="id" data-id="{{item.id}}" bindtap="select" disabled="{{membership.active}}" class="member-plan {{selected === item.id ? 'chosen' : ''}}" aria-label="{{item.name}}，{{item.price}}元每{{item.unit}}" aria-pressed="{{selected === item.id}}"><text wx:if="{{membership.active}}" class="member-owned-badge">已拥有</text><view>{{item.name}}</view><view class="member-price"><text class="member-currency">¥</text><text class="member-digits">{{item.price}}</text></view><view class="muted">／{{item.unit}}</view></button></view>
 <view wx:else class="card">会员功能暂未开放，请等待服务更新。</view><view class="member-promise">{{membership.payment_test ? '小额真实支付测试 · 发放一个月会员' : '月会员 · 按需支持开发者'}}<view class="muted">{{membership.payment_test_mode ? (membership.payment_test ? '确认付款会真实扣款，请核对支付面板金额' : '测试期间仅指定账号可购买') : '一次购买 · 到期手动续费'}}</view></view>

 <button class="member-comparison-entry" bindtap="compareBenefits"><view><view class="member-comparison-title">免费版与会员</view><view class="muted">按自己的需要，慢慢选</view></view><text class="member-comparison-arrow" aria-hidden="true">›</text></button>
 <view class="member-rights-heading">会员专属权益</view><view class="member-feature member-ad-benefit"><view class="member-ad-shield" aria-hidden="true"><image src="/assets/membership/cat.png" mode="aspectFit"/></view><view><view class="member-feature-title">免小程序内广告</view><view class="muted">当前未投放广告，未来接入后会员仍免小程序内广告。</view></view></view><view class="member-feature member-capacity-benefit"><image src="/pages/membership/assets/unlimited.png" mode="aspectFit" aria-hidden="true"/><view><view class="member-feature-title">无限容量</view><view class="muted">会员有效期内，物品件数不限。</view></view></view><view class="member-rights-heading member-free-heading">免费整理工具</view><button wx:for="{{features}}" wx:key="mode" class="member-feature" bindtap="open" data-mode="{{item.mode}}"><image src="{{item.icon}}" mode="aspectFit" aria-hidden="true"/><view><view class="member-feature-title">{{item.title}}<text class="member-free-badge">免费</text></view><view class="muted">{{item.note}}</view></view></button>
 <view class="member-free"><image src="/assets/membership/cat.png" mode="aspectFit" aria-hidden="true"/><view><view class="member-free-title">已有功能继续免费</view><view class="muted">免费基础容量20件，可用喵粒永久扩容；现有记账、统计、订阅／分期继续免费</view></view></view>
 <view class="member-purchase"><view wx:if="{{selectedPlan}}" class="member-selected-price">{{selectedPlan.name}} <text>¥{{selectedPlan.price}}</text>/{{selectedPlan.unit}}</view><button class="button cat-loading-button" disabled="{{membership.active || membership.purchase_allowed === false || !membership.payment_open || buying}}" bindtap="buy"><cat-loading wx:if="{{buying}}" paw label=""/>{{membership.active ? '已拥有' : membership.payment_open ? (buying ? '核对订单中…' : membership.payment_test ? '小额测试支付' : '开通猫爪会员') : '订阅即将开放'}}</button></view><view wx:if="{{membership.active}}" class="member-owned-note">有效期至 {{expiry}} · 到期后可再次购买</view><view wx:if="{{paymentNote}}" class="member-payment-note">{{paymentNote}}</view><view wx:if="{{membership.supported}}" class="member-order-actions"><button class="text-button" disabled="{{buying}}" bindtap="checkPayment">核对待确认订单</button><button class="text-button" bindtap="orders">购买记录</button></view><view class="member-footnote">已有记录不会因会员到期而丢失</view></block>
 <image wx:if="{{announcementOpen && announcementClosing}}" class="member-announcement-flight" src="/assets/membership/letter.png" mode="aspectFit" style="{{announcementFlightStyle}}" aria-hidden="true"/>
 <view wx:if="{{announcementOpen && !loading && !error && feedbackMessage}}" class="member-announcement-mask {{announcementClosing ? 'announcement-closing' : ''}}" catchtouchmove="ignoreAnnouncementTouch">
  <view class="member-announcement-window" role="dialog" aria-modal="true" aria-label="写给你的话">
   <view class="member-announcement-heading"><view><text class="member-announcement-eyebrow">猫爪公告</text><view>写给你的话</view></view><button disabled="{{announcementBusy}}" class="member-announcement-close" bindtap="closeAnnouncement" aria-label="关闭公告">×</button></view>
   <scroll-view scroll-y class="member-announcement-scroll announcement-short" catchtouchmove="ignoreAnnouncementTouch"><view class="member-announcement-body"><view class="member-announcement-title">{{announcementTitle}}</view><view wx:if="{{feedbackMessage}}">{{feedbackMessage}}</view></view></scroll-view>
   <view class="member-announcement-footer"><button class="member-feedback-link" open-type="feedback">反馈与建议 ›</button><button disabled="{{announcementBusy}}" class="member-announcement-done" bindtap="closeAnnouncement">我知道了</button></view>
  </view>
 </view>
</view>

<cat-feedback id="cat-feedback"/>

<include src="../../templates/session-status.wxml"/>
