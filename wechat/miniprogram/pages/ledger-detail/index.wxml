<view class="member-themed {{memberThemeClass}} page ledger-page" style="{{memberThemeStyle}}"><view wx:if="{{loading}}" class="ledger-empty"><cat-loading label="正在读取账目…"/></view><view wx:if="{{error}}" class="ledger-error">{{error}}<button class="ledger-text-button" bindtap="load" disabled="{{busy}}">重新读取</button></view><block wx:if="{{row}}"><view class="ledger-detail-hero"><image wx:if="{{!iconFailed}}" class="ledger-detail-art" src="{{row.art}}" mode="aspectFit" binderror="artFailed"/><view class="ledger-detail-name">{{row.name}}</view><scroll-view scroll-x><text class="ledger-detail-money">¥{{row.amountText}}</text></scroll-view><view class="ledger-detail-source">{{row.state === 'void' ? '已作废' : row.state === 'linked' ? '已关联原记录' : row.direction}} · {{row.source_name}}</view></view>
<view class="ledger-card"><view class="ledger-field">收支日期<text>{{row.occurred_on}}</text></view><view class="ledger-field ledger-recorded-field"><view class="ledger-field-label">记录时间</view><view class="ledger-time-value"><block wx:if="{{row.recordedAt}}"><text class="ledger-time-part">{{row.recordedAt.date}}</text><text class="ledger-time-part">{{row.recordedAt.time}}</text></block><text wx:else>记录时间暂不可用</text></view></view><view class="ledger-field">分类<text>{{row.category_name}}</text></view><view class="ledger-field">来源<text>{{row.source_name}}</text></view><view wx:if="{{row.source === 'installment'}}" class="ledger-field">付款拆分<view>本金 ¥{{row.principal}}<view>利息／手续费 ¥{{row.cost}}</view></view></view><button wx:if="{{row.item_id}}" class="ledger-field ledger-detail-link" bindtap="item" disabled="{{!row.item_available}}">关联物品<text>{{row.item_name}} {{row.item_removed ? '（原物品已删除）' : row.item_available ? '›' : '（回收站中）'}}</text></button><view wx:if="{{row.notes}}" class="ledger-field">备注<text>{{row.notes}}</text></view><button wx:if="{{row.parent_id || row.linked_entry_id}}" class="ledger-text-button" bindtap="parent">查看原支出 ›</button></view>
<view wx:if="{{row.kind === 'expense'}}" class="ledger-card"><view class="ledger-section">退款记录</view><view wx:if="{{!row.refunds.length}}" class="ledger-help">暂无退款</view><button wx:for="{{row.refunds}}" wx:key="id" class="ledger-field ledger-detail-link" data-id="{{item.id}}" bindtap="openRefund"><view class="ledger-refund-copy"><view>{{item.occurred_on}}</view><view class="ledger-recorded-time"><block wx:if="{{item.recordedAt}}"><text>记录于</text><text class="ledger-time-part">{{item.recordedAt.date}}</text><text class="ledger-time-part">{{item.recordedAt.time}}</text></block><text wx:else>记录时间暂不可用</text></view></view><text class="ledger-nowrap">¥{{item.amountText}} ›</text></button></view><view wx:if="{{row.kind === 'refund'}}" class="ledger-help">退款按发生日期冲减原分类支出，不自动修改物品购置价或分期进度。</view><view wx:if="{{!row.editable}}" class="ledger-help">{{row.deletable ? '自动账目随原记录同步；删除将撤销对应的这次付款，计划保留。' : '自动账目随原记录同步，更正请返回原记录。'}}</view><view wx:if="{{row.item_removed}}" class="ledger-help">原物品档案已删除，真实收付仍保留，可在这里更正或作废。</view><button wx:if="{{memberSupported && row.kind !== 'refund'}}" class="ledger-secondary" bindtap="memberEntryTools">整理账本 ›</button><view class="ledger-form-bottom"><block wx:if="{{row.state === 'active'}}"><button wx:if="{{row.editable}}" class="ledger-primary" bindtap="edit" disabled="{{busy}}">修改账目</button><button wx:else class="ledger-primary" bindtap="source" disabled="{{busy}}">查看原记录</button><button wx:if="{{row.kind === 'expense'}}" class="ledger-secondary" bindtap="refund" disabled="{{busy}}">添加退款</button><button wx:if="{{row.editable || (row.deletable && (row.source === 'subscription' || row.source === 'installment'))}}" class="ledger-text-button" bindtap="void" disabled="{{busy}}">{{row.deletable && (row.source === 'subscription' || row.source === 'installment') ? '删除这笔账目' : '作废这笔账目'}}</button></block></view><view wx:if="{{row.changes.length}}" class="ledger-help">已保留 {{row.changes.length}} 次变更记录。</view></block></view>

<cat-feedback id="cat-feedback"/>

<include src="../../templates/session-status.wxml"/>
