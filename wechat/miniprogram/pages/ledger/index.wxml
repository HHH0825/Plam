<import src="../../templates/ledger.wxml"/>
<view class="member-themed {{memberThemeClass}} page ledger-page ledger-tab ledger-home" style="{{memberThemeStyle}}">
 <view wx:if="{{memberBooksState !== 'unsupported'}}" class="account-tools-group"><button class="account-tools-heading" bindtap="toggleAccountTools" aria-expanded="{{accountToolsExpanded}}" aria-controls="account-tools-panel" aria-label="账本与预算，{{accountToolsHint}}，{{accountToolsExpanded ? '收起' : '展开'}}"><text class="account-tools-title">账本与预算</text><text class="account-tools-scope {{accountToolsFiltered ? 'is-filtered' : ''}}">{{accountToolsHint}}</text><view class="account-tools-sign" aria-hidden="true"><view class="account-sign-horizontal"/><view wx:if="{{!accountToolsExpanded}}" class="account-sign-vertical"/></view></button><view wx:if="{{accountToolsExpanded}}" id="account-tools-panel" class="account-tools-panel motion-fold" style="{{motionFolds.accountToolsExpanded}}"><view id="account-tools-inner" class="motion-fold-inner">
 <view wx:if="{{memberSupported}}" class="member-ledger-toolbar"><picker class="member-toolbar-picker" range="{{memberBooks}}" range-key="name" value="{{memberBookIndex}}" bindchange="memberBookChange" aria-label="选择账本，当前{{memberBooks[memberBookIndex].name || '全部账本'}}"><view class="member-switch"><image class="member-toolbar-icon" src="/assets/membership/books.png" mode="aspectFit" aria-hidden="true"/><text class="member-toolbar-label member-book-label">{{memberBooks[memberBookIndex].name || '全部账本'}}</text><view class="book-filter-caret" aria-hidden="true"/></view></picker><button class="member-shortcut" bindtap="memberTool" data-mode="books"><image class="member-toolbar-icon" src="/assets/membership/books.png" mode="aspectFit" aria-hidden="true"/><text class="member-toolbar-label">我的账本</text></button><button class="member-shortcut" bindtap="memberTool" data-mode="budgets"><image class="member-toolbar-icon" src="/assets/membership/budget.png" mode="aspectFit" aria-hidden="true"/><text class="member-toolbar-label">本月预算</text></button></view>
 <view wx:if="{{memberSupported}}" class="ledger-budget-card {{budgetCard.kind === 'over' ? 'budget-card-over' : ''}}"><button class="budget-card-main" bindtap="openBudgetCard" disabled="{{budgetCard.kind === 'loading'}}" aria-label="{{budgetCard.title}}，{{budgetCard.note}}"><view class="budget-card-copy"><view class="budget-card-title">{{budgetCard.title}}</view><view class="budget-card-note">{{budgetCard.note}}</view></view><text class="budget-card-action">{{budgetCard.action}}</text><view wx:if="{{budgetCard.configured}}" class="budget-card-track"><view style="width:{{budgetCard.percent}}%"/></view></button></view><view wx:if="{{memberError}}" class="member-tool-error"><text>{{memberError}}</text><button bindtap="memberRefresh">重试</button></view>
 </view></view></view>
 <view wx:if="{{loading && !summary}}" class="ledger-empty"><cat-loading label="正在整理账本…"/></view><view wx:if="{{error}}" class="ledger-error" role="alert">{{error}}<button class="ledger-text-button" bindtap="load" disabled="{{loading}}">重新读取</button></view><template wx:if="{{!loading && !enabled}}" is="ledger-gate" data="{{supported,loading}}"/>
 <block wx:if="{{enabled}}">
  <template wx:if="{{summary}}" is="ledger-summary" data="{{summary,month,monthLabel,maxMonth,canNext,panelLayout,mainSizes,smallSizes,motionPanelClass}}"/>
  <view class="ledger-flow-toolbar"><text class="ledger-section">本月流水</text><view class="ledger-flow-actions"><button class="ledger-icon-button {{searchOpen || query ? 'is-active' : ''}}" bindtap="toggleSearch" aria-label="搜索账目"><view class="ledger-search-mark"/></button><button class="ledger-icon-button {{filterCount ? 'is-active' : ''}}" bindtap="openFilter" aria-label="筛选账目"><view class="ledger-filter-mark"><view/><view/><view/></view><text wx:if="{{filterCount}}" class="ledger-filter-count">{{filterCount}}</text></button></view></view>
  <view wx:if="{{searchOpen}}" class="ledger-search ledger-inline-search"><input value="{{query}}" focus="{{searchFocus}}" bindinput="search" placeholder="搜索名称、备注或物品" maxlength="120" cursor-spacing="24" aria-label="搜索账目"/><button class="ledger-search-close" bindtap="toggleSearch" aria-label="收起搜索">×</button></view>
  <button wx:if="{{query && !searchOpen}}" class="ledger-query-chip" bindtap="clearSearch" aria-label="清除搜索词">搜索：{{query}} <text>×</text></button>
  <view wx:if="{{filterActive && filteredSummary}}" class="ledger-filter-summary">筛选合计 · {{filteredSummary.count}} 笔<scroll-view scroll-x><text class="ledger-nowrap">原支出 ¥{{filteredSummary.gross_expense}} · 退款 ¥{{filteredSummary.refundText}}</text></scroll-view><scroll-view scroll-x><text class="ledger-nowrap">收入 ¥{{filteredSummary.incomeText}}</text></scroll-view></view>
  <view wx:if="{{(loading || refreshing) && summary}}" class="ledger-muted ledger-small"><cat-loading compact label="正在更新流水…"/></view>
  <view wx:for="{{groups}}" wx:key="date" wx:for-item="group" class="ledger-day"><view class="ledger-day-heading"><text>{{group.label}}</text><view wx:if="{{group.totals}}" class="ledger-day-totals"><text>原支出 ¥{{group.totals.grossText}} · 收入 ¥{{group.totals.incomeText}}</text><text wx:if="{{group.totals.hasRefund}}"> · 退款 ¥{{group.totals.refundText}}</text></view></view>
   <button wx:for="{{group.entries}}" wx:key="id" wx:for-item="row" class="ledger-row" data-id="{{row.id}}" bindtap="open"><view class="ledger-row-icon"><image wx:if="{{!iconErrors[row.id]}}" src="{{row.art}}" mode="aspectFit" data-key="{{row.id}}" binderror="iconFailed"/></view><view class="ledger-row-copy"><view class="ledger-row-name">{{row.name}}</view><view class="ledger-muted ledger-small">{{row.source_name}} · {{row.category_name}}</view><view class="ledger-recorded-time"><block wx:if="{{row.recordedAt}}"><text>记录于</text><text class="ledger-time-part">{{row.recordedAt.date}}</text><text class="ledger-time-part">{{row.recordedAt.time}}</text></block><text wx:else>记录时间暂不可用</text></view></view><view class="ledger-row-amount"><scroll-view scroll-x><text class="ledger-nowrap">¥{{row.amountText}}</text></scroll-view><view class="ledger-muted ledger-small">{{row.direction}}</view></view></button>
  </view>
  <view wx:if="{{!groups.length && !loading && !error}}" class="ledger-empty">{{filterActive ? '没有符合条件的记录' : '这个月还没有收付，点猫爪记下第一笔吧。'}}</view><button wx:if="{{nextOffset !== null}}" class="ledger-secondary" disabled="{{loading}}" bindtap="more">{{loading ? '正在读取…' : '加载更多'}}</button><view class="ledger-history-entry"><button class="ledger-text-button" bindtap="history">核对历史记录 ›</button></view><view class="ledger-footnote">按实际收付统计；与物品成本、小小发现的口径不同。</view>
 </block>
</view>
<view wx:if="{{filterOpen}}" class="ledger-mask {{motionClosing === 'filterOpen' ? 'motion-closing' : ''}}" bindtap="closeFilter" catchtouchmove="stop"><view class="ledger-sheet" catchtap="stop"><view class="ledger-section-row"><text class="ledger-section">筛选账目</text><button class="ledger-close" bindtap="closeFilter" aria-label="关闭">×</button></view><picker range="{{kindOptions}}" range-key="name" value="{{draftKindIndex}}" data-key="kindIndex" bindchange="filter"><view class="ledger-field">收付类型<text>{{kindOptions[draftKindIndex].name}} ›</text></view></picker><picker range="{{categoryOptions}}" range-key="name" value="{{draftCategoryIndex}}" data-key="categoryIndex" bindchange="filter"><view class="ledger-field">分类<text>{{categoryOptions[draftCategoryIndex].name}} ›</text></view></picker><picker range="{{sourceOptions}}" range-key="name" value="{{draftSourceIndex}}" data-key="sourceIndex" bindchange="filter"><view class="ledger-field">来源<text>{{sourceOptions[draftSourceIndex].name}} ›</text></view></picker><button class="ledger-primary" bindtap="applyFilter">查看结果</button><button class="ledger-text-button" bindtap="clearFilter">重置筛选</button></view></view>

<cat-feedback id="cat-feedback"/>

<include src="../../templates/session-status.wxml"/>
