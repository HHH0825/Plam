<view class="member-themed {{memberThemeClass}} page editor-page" style="{{memberThemeStyle}}">
  <view class="page-heading heading-layout"><image class="heading-postmark" src="/assets/white-doodle/postmark.png" mode="aspectFit" aria-hidden="true"/><view class="heading-copy"><view class="eyebrow">猫爪物帐 · 物品档案</view><view class="title">{{itemId ? '编辑物品' : '添加物品'}}</view><view class="subtitle">从拥有的那一天开始，留下它的故事。</view></view><image class="heading-cat" src="/assets/white-doodle/cat-camera.png" mode="aspectFit" aria-hidden="true"/></view>
  <view wx:if="{{loading}}" class="empty"><cat-loading label="正在读取档案…"/></view>
  <view wx:elif="{{loadFailed}}" class="card error-panel">{{error}}<button class="button light" hover-class="button-hover" bindtap="load">重新读取</button></view>
  <block wx:elif="{{draftReady}}">
    <view class="card photo-card">
      <view class="photo-choice"><image wx:if="{{previewPath && form.cover_mode === 'photo'}}" class="preview" src="{{previewPath}}" mode="aspectFit" binderror="previewFailed" aria-label="物品照片预览"/><view wx:else class="photo-placeholder"><image wx:if="{{!coverArtError}}" class="cover-art" src="{{coverArt}}" mode="aspectFit" binderror="coverArtFailed" aria-label="物品图标预览"/><text wx:else>物品</text></view><view class="photo-copy"><view class="photo-label">物品封面</view><cat-loading wx:if="{{photoBusy || photoLoading}}" paw label=""/><view class="muted small">{{photoLoading ? '正在读取原照片…' : photoBusy ? '正在处理照片…' : '拍张照片，或挑一个可爱图标'}}</view></view></view>
      <view class="cover-choices"><button class="button light" disabled="{{busy || photoBusy || loading || photosUnavailable}}" bindtap="choosePhoto">选择照片</button><button class="button light icon-choice" disabled="{{busy || photoBusy || loading || !coverSupported}}" bindtap="openIconPicker">选择图标</button></view>
      <view wx:if="{{hasPhoto && form.cover_mode === 'icon'}}" class="cover-replace-note">保存后将删除原照片，之后需重新上传。</view>
      <view wx:if="{{coverCapabilityLoading}}" class="field-note" role="status"><cat-loading compact label="正在检查图标功能…"/></view><view wx:elif="{{coverCapabilityError}}" class="field-note" role="status">{{coverCapabilityError}}<button class="cover-recheck" bindtap="retryCoverCapability" disabled="{{busy}}">重新检查</button></view>
      <view wx:if="{{previewPath && form.cover_mode === 'photo'}}" class="photo-actions"><button class="button light" disabled="{{busy || photoBusy}}" bindtap="cropPhoto">裁剪</button><button class="button light" disabled="{{busy || photoBusy}}" bindtap="rotatePhoto">旋转</button></view>
      <view wx:if="{{photosUnavailable}}" class="field-note" role="status">云端照片暂不可用，图标功能可用时仍可选择图标。</view>
      <view wx:if="{{previewPath && form.cover_mode === 'photo'}}" class="field-note">裁剪为正方形；每次旋转90°。保存物品后才上传照片。</view>
      <view wx:if="{{photoError}}" class="photo-error" role="alert">{{photoError}}<button wx:if="{{hasPhoto && form.cover_mode === 'photo' && !photoPath && !photosUnavailable}}" class="button light" disabled="{{busy || photoBusy || photoLoading}}" bindtap="loadPhoto">重试读取</button></view>
      <view wx:if="{{photoProgress >= 0}}" class="field-note" role="status">{{photoProgress < 100 ? '照片上传中 ' + photoProgress + '%' : '照片处理中…'}}</view>
    </view>
    <view class="card form-card"><view class="form-section-head"><view class="form-number"><image src="/assets/white-doodle/number-tape.png" mode="scaleToFill" aria-hidden="true"/><text>01</text></view><text class="form-section-title">基本信息</text><image class="form-paw" src="/assets/white-doodle/paw.png" mode="aspectFit" aria-hidden="true"/></view>
      <view class="field"><text class="field-label">物品名称</text><view class="field-input {{focusField === 'name' ? 'is-focused' : ''}}"><input class="text-input" maxlength="120" value="{{form.name}}" data-key="name" bindinput="input" bindfocus="focus" bindblur="blur" cursor-spacing="24" placeholder="例如：一起去旅行的相机" placeholder-class="field-placeholder" aria-label="物品名称"/></view></view>
      <view class="field storage-field"><text class="field-label">收纳位置（选填）</text><picker range="{{locationNames}}" value="{{locationIndex}}" bindtap="locationSync" bindchange="locationChange" disabled="{{!locationsReady || busy || loading || form.status === 'disposed'}}"><view class="location-picker-value">{{locationText || form.storage_location_name || '未设置位置'}}</view></picker><view wx:if="{{locationsError}}" class="location-picker-warning">{{locationsError}}<button class="text-button" bindtap="retryLocations" disabled="{{busy}}">重新读取位置</button></view></view>
      <view class="field"><text class="field-label">分类</text><picker range="{{types}}" value="{{typeIndex}}" bindchange="typeChange" aria-label="选择物品分类"><view class="picker"><text>{{types[typeIndex]}}</text><text class="picker-caret">⌄</text></view></picker></view>
      <view wx:if="{{form.status !== 'disposed'}}" class="field"><text class="field-label">当前状态</text><picker range="{{statuses}}" value="{{statusIndex}}" bindchange="statusChange"><view class="picker"><text>{{statuses[statusIndex]}}</text><text class="picker-caret">⌄</text></view></picker></view>
    </view>
    <view class="card form-card"><view class="form-section-head"><view class="form-number"><image src="/assets/white-doodle/number-tape.png" mode="scaleToFill" aria-hidden="true"/><text>02</text></view><text class="form-section-title">购买与保修</text><image class="form-paw" src="/assets/white-doodle/paw.png" mode="aspectFit" aria-hidden="true"/></view>
      <view class="field"><text class="field-label">购买日期</text><picker mode="date" value="{{form.purchase_date}}" end="{{today}}" bindchange="input" data-key="purchase_date"><view class="picker"><text>{{form.purchase_date}}</text><text class="picker-caret">⌄</text></view></picker></view>
      <view class="field"><text class="field-label">购买价格 <text class="optional">元</text></text><view class="field-input {{focusField === 'purchase_price' ? 'is-focused' : ''}}"><input class="text-input" type="digit" value="{{form.purchase_price}}" data-key="purchase_price" bindinput="input" bindfocus="focus" bindblur="blur" cursor-spacing="24" placeholder="0.00" placeholder-class="field-placeholder" aria-label="购买价格"/></view></view>
      <view class="field"><view class="warranty-label"><text class="field-label">保修到期日 <text class="optional">可选</text></text><text wx:if="{{form.warranty_expires_on}}" class="clear-date" bindtap="clearWarranty">清空</text></view><picker mode="date" value="{{form.warranty_expires_on || form.purchase_date}}" start="{{form.purchase_date}}" bindchange="input" data-key="warranty_expires_on"><view class="picker"><text>{{form.warranty_expires_on || '选择日期'}}</text><text class="picker-caret">⌄</text></view></picker><view class="field-note">填写后，“发现”会提醒你留意保修期限。</view></view>
    </view>
    <view wx:if="{{paymentEnabled}}" class="card form-card"><view class="form-section-head"><text class="form-section-title">同步到记账</text></view><view class="field-note">购买价格用于物品成本，账本仅统计实际付款。</view><picker range="{{paymentModes}}" value="{{paymentIndex}}" bindchange="paymentMode" disabled="{{busy}}"><view class="picker"><text>{{paymentModes[paymentIndex]}}</text><text>›</text></view></picker><block wx:if="{{form.payment_info && form.payment_info.mode !== 'archive'}}"><view class="field"><text class="field-label">{{form.payment_info.mode === 'installment' ? '已付首付（没有则填0）' : '实际付款金额'}} · 元</text><view class="field-input"><input class="text-input" type="digit" maxlength="12" value="{{form.payment_info.amount}}" data-key="amount" bindinput="paymentField" disabled="{{busy}}" cursor-spacing="24"/></view></view><picker mode="date" value="{{form.payment_info.paid_on}}" end="{{today}}" data-key="paid_on" bindchange="paymentField" disabled="{{busy}}"><view class="picker"><text>付款日期</text><text>{{form.payment_info.paid_on}} ›</text></view></picker><view wx:if="{{!form.payment_info.existing_entry_id}}"><button class="text-button" bindtap="loadExistingPayments" disabled="{{busy || paymentLoading}}">已记过这笔？选择已有支出</button><picker wx:if="{{paymentCandidates.length}}" range="{{paymentChoices}}" value="{{paymentChoiceIndex}}" bindchange="existingPayment" disabled="{{busy}}"><view class="picker"><text>{{paymentChoices[paymentChoiceIndex]}}</text><text>›</text></view></picker><button wx:if="{{paymentOffset !== null}}" class="text-button" data-more="true" bindtap="loadExistingPayments" disabled="{{busy || paymentLoading}}">读取更多已有支出</button></view><view wx:else class="field-note">已选用原账目，保存后不会重复记账。已绑定的账目请从物品付款信息更正。</view><view wx:if="{{form.payment_info.mode === 'installment'}}" class="field-note">后续每期在“订阅／分期”确认实际付款；这里不记完整购置价。</view></block><view wx:else class="field-note">仅建档不会产生购置支出，物品成本仍保留。</view></view>
    <view wx:if="{{paymentError}}" class="field-note">{{paymentError}}<button class="text-button" bindtap="retryPayment" disabled="{{busy}}">重新检查</button></view>
    <view class="card form-card"><view class="form-section-head"><view class="form-number"><image src="/assets/white-doodle/number-tape.png" mode="scaleToFill" aria-hidden="true"/><text>03</text></view><text class="form-section-title">备注</text><text class="optional">可选</text></view>
      <view class="field notes-field"><textarea class="{{focusField === 'notes' ? 'is-focused' : ''}}" maxlength="1000" value="{{form.notes}}" data-key="notes" bindinput="input" bindfocus="focus" bindblur="blur" cursor-spacing="24" placeholder="记下与它有关的事" placeholder-class="field-placeholder" aria-label="备注"/><view class="notes-count">{{form.notes.length}} / 1000</view></view>
    </view>
    <view wx:if="{{!itemId && draftStatus}}" class="draft-note" role="status"><text>{{draftStatus}}</text><button class="draft-discard" bindtap="discardDraft" disabled="{{busy || photoBusy || draftWorking}}">丢弃草稿</button></view>
    <view class="form-footer"><view wx:if="{{error}}" class="card error-panel">{{error}}</view><button wx:if="{{versionConflict}}" class="button light" bindtap="reviewConflict" disabled="{{busy}}">读取最新内容并核对</button><button class="button paper-action cat-loading-button" hover-class="button-hover" bindtap="save" disabled="{{busy || photoBusy || !draftReady || !paymentReady || draftWorking || versionConflict}}" aria-label="{{busy ? '保存中' : '保存物品'}}"><cat-loading wx:if="{{busy}}" paw label=""/><paper-label variant="save" fit-width="{{true}}" text="{{busy ? '保存中…' : '保存物品'}}"/></button></view>
  </block>
  <view wx:if="{{iconOpen}}" class="cover-overlay"><view class="cover-mask" bindtap="closeIconPicker" catchtouchmove="stopCoverTouch"></view><view class="cover-sheet" style="height:{{coverSheetHeight ? coverSheetHeight + 'px' : '82vh'}};bottom:{{coverSheetBottom || 0}}px" role="dialog" aria-label="选择物品图标"><view class="cover-sheet-heading"><view><text class="section-title">挑一个小图标</text><view class="muted small">只换封面，不改变分类</view></view><button class="cover-close" size="mini" bindtap="closeIconPicker" aria-label="关闭图标选择"><view class="cover-close-mark" aria-hidden="true"></view></button></view><view wx:if="{{coverCatalogueNote}}" class="field-note" role="status">{{coverCatalogueNote}}</view><input class="cover-search" adjust-position="{{false}}" bindkeyboardheightchange="coverKeyboardChange" value="{{iconQuery}}" bindinput="iconSearch" placeholder="搜索图标，如：手机、水杯" aria-label="搜索物品图标"/><scroll-view class="cover-group-scroll" scroll-x="{{true}}"><view class="cover-groups"><button wx:for="{{iconGroups}}" wx:key="key" class="cover-group {{iconGroup === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="iconGroupChange">{{item.name}}</button></view></scroll-view><scroll-view class="cover-grid-scroll" scroll-y="{{true}}"><view class="cover-grid"><button wx:for="{{iconRows}}" wx:key="key" class="cover-option {{iconSelected === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="selectCoverIcon" aria-label="{{item.name}}"><image wx:if="{{!iconGridErrors[item.key]}}" src="{{item.art}}" mode="aspectFit" data-key="{{item.key}}" binderror="iconGridFailed"/><view wx:else class="cover-grid-fallback">◇</view><text>{{item.name}}</text><text wx:if="{{iconSelected === item.key}}" class="cover-check">✓</text></button></view><view wx:if="{{!iconRows.length}}" class="cover-empty">没有找到，换个名字试试吧。</view></scroll-view><view class="cover-sheet-footer"><button class="button" bindtap="applyCoverIcon" disabled="{{!iconSelected || busy || !coverSupported || !iconSelectionSupported}}">使用这个图标</button><button class="cover-feedback" open-type="feedback" aria-label="反馈想要的物品图标">没有找到想要的图标？告诉我 <text aria-hidden="true">›</text></button><view class="cover-feedback-help">告诉我物品名称和用途，也可以附上参考图。</view></view></view></view>
  <canvas type="2d" id="photo-edit-canvas" class="photo-edit-canvas" aria-hidden="true"/>
  <view wx:if="{{draftPrompt}}" class="draft-overlay">
    <view class="draft-dialog" role="dialog" aria-label="继续上次填写">
      <view class="section-title">继续上次填写？</view><view class="draft-title">{{draftName}}</view><view class="field-note">最后保存：{{draftTime}} · 仅存于本机</view>
      <button class="button block cat-loading-button" bindtap="continueDraft" disabled="{{draftWorking}}"><cat-loading wx:if="{{draftWorking}}" paw label=""/>继续填写</button>
      <button class="button light block" bindtap="restartDraft" disabled="{{draftWorking}}">重新填写</button>
      <button class="draft-discard block" bindtap="closeDraft" disabled="{{draftWorking}}">暂不填写，返回清单</button>
      <view wx:if="{{draftStatus}}" class="field-note" role="alert">{{draftStatus}}</view>
    </view>
  </view>
</view>

<cat-feedback id="cat-feedback"/>
