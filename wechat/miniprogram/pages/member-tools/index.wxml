<view class="member-themed {{memberThemeClass}} page member-tools" style="{{memberThemeStyle}}"><view class="tool-page-heading"><view><view wx:if="{{mode === 'books' || mode === 'budgets'}}" class="tool-eyebrow">{{mode === 'books' ? '把生活，分册收藏' : '给这个月，留一点余地'}}</view><view class="title">{{title}}</view></view><image wx:if="{{mode === 'books' || mode === 'budgets'}}" class="tool-heading-art" src="{{mode === 'books' ? '/assets/membership/cat.png' : '/assets/membership/budget.png'}}" mode="aspectFit"/></view><view wx:if="{{!retired && mode !== 'books' && mode !== 'budgets'}}" class="muted">{{mode === 'books' ? '每一笔记录，都有自己的归处。' : mode === 'budgets' ? '给本月的花销，一点温柔的安排。' : '把收藏册，装扮成喜欢的样子。'}}</view>
 <view wx:if="{{retired}}" class="card"><view>此会员工具已下线</view><view class="muted">订阅／分期和已保存的付款记录仍可正常使用。</view><button class="button block" bindtap="retiredBack">返回会员工具</button></view><view wx:if="{{loading}}" class="empty"><cat-loading label="正在整理…"/></view><view wx:if="{{error}}" class="card error-panel">{{error}}<button class="button light" bindtap="load" disabled="{{busy}}">重新读取</button></view>
 <view wx:if="{{mode !== 'appearance' && !loading && member && !member.active}}" class="card member-preview"><view>{{member.supported ? '免费版可预览权益' : '会员工具暂未开放'}}</view><view class="muted">{{member.status === 'expired' ? '已有记录保留，日常记账继续免费。' : '新增会员工具需要猫爪会员。已有功能继续免费。'}}</view><button class="button" bindtap="subscription">了解猫爪会员</button></view>
 <block wx:if="{{!loading && (mode === 'appearance' || member.supported)}}">
 <block wx:if="{{mode === 'books'}}">
  <view class="tools-segments" role="group" aria-label="账本管理"><button class="{{bookTab === 'list' ? 'chosen' : ''}}" bindtap="bookTabChange" data-tab="list" aria-pressed="{{bookTab === 'list'}}">账本</button><button class="{{bookTab === 'entries' ? 'chosen' : ''}}" bindtap="bookTabChange" data-tab="entries" aria-pressed="{{bookTab === 'entries'}}">流水整理</button></view>
  <block wx:if="{{bookTab === 'list'}}"><view class="{{motionPanelClass}}">
   <view class="tools-section-row book-list-heading"><view class="book-list-heading-left"><button wx:if="{{!bookSorting}}" class="book-sort-entry" bindtap="startBookSort" disabled="{{busy || activeBooks.length < 2}}" aria-label="调整账本顺序"><view class="sort-line"/><view class="sort-line"/><view class="sort-line"/></button><button wx:else class="tools-inline-action" bindtap="cancelBookSort" disabled="{{busy || bookSortPending}}">取消</button><text>正在使用 · {{activeBooks.length}}本</text></view><button wx:if="{{!bookSorting}}" class="tools-inline-action" bindtap="newBook" disabled="{{busy}}">＋ 新建账本</button><button wx:else class="tools-inline-action book-sort-done" bindtap="finishBookSort" disabled="{{busy}}">{{bookSortPending ? '核对并重试' : busy ? '正在保存…' : '完成'}}</button></view>
   <view wx:if="{{bookSorting}}" class="book-sort-note">{{bookSortPending ? '保存结果待核对，暂时锁定拖动。请核对并重试。' : '按住右侧手柄上下拖动，点完成后保存。'}}<button wx:if="{{!bookSortPending}}" class="tools-inline-action" bindtap="reviewBookOrder" disabled="{{busy}}">重新核对</button></view>
   <view wx:for="{{activeBooks}}" wx:key="id" data-id="{{item.id}}" class="book-display active-book {{bookSorting ? 'book-sortable' : ''}} {{dragBook && dragBook.id === item.id ? 'book-drag-placeholder' : ''}}" style="transform:translateY({{item.sortShift || 0}}px)"><image class="book-comic-cover" src="{{item.coverPath}}" mode="aspectFit"/><view class="book-copy"><view class="book-name">{{item.name}}</view><view class="muted">{{item.count}}笔流水 · {{item.coverName}}</view><text wx:if="{{item.id === 'default'}}" class="book-default">默认账本</text></view><view wx:if="{{bookSorting}}" class="book-sort-controls"><button class="book-drag-handle" data-id="{{item.id}}" catchtouchstart="bookDragStart" catchtouchmove="bookDragMove" catchtouchend="bookDragEnd" catchtouchcancel="bookDragCancel" disabled="{{busy || bookSortPending}}" aria-label="拖动{{item.name}}调整顺序"><view/><view/><view/></button><view class="book-step-controls"><button data-index="{{index}}" data-step="-1" bindtap="bookSortStep" disabled="{{busy || bookSortPending || index === 0}}" aria-label="上移{{item.name}}">↑</button><button data-index="{{index}}" data-step="1" bindtap="bookSortStep" disabled="{{busy || bookSortPending || index === activeBooks.length - 1}}" aria-label="下移{{item.name}}">↓</button></view></view><button wx:elif="{{member.active && item.id !== 'default'}}" class="book-more" data-id="{{item.id}}" bindtap="bookMenu" disabled="{{busy}}" aria-label="管理{{item.name}}">•••</button></view>
   <button wx:if="{{!bookSorting}}" class="archived-heading" bindtap="toggleArchived" aria-expanded="{{archivedExpanded}}"><text>已归档 · {{archivedBooks.length}}本</text><text>{{archivedExpanded ? '收起 −' : '展开 ＋'}}</text></button>
   <block wx:if="{{archivedExpanded && !bookSorting}}"><view class="motion-fold" style="{{motionFolds.archivedExpanded}}"><view id="archived-inner" class="motion-fold-inner"><view wx:for="{{archivedBooks}}" wx:key="id" class="book-display book-is-archived"><image class="book-comic-cover" src="{{item.coverPath}}" mode="aspectFit"/><view class="book-copy"><view class="book-name">{{item.name}}</view><view class="muted">{{item.count}}笔流水 · 已归档</view></view><button wx:if="{{member.active}}" class="book-more" data-id="{{item.id}}" bindtap="bookMenu" disabled="{{busy}}" aria-label="管理{{item.name}}">•••</button></view><view wx:if="{{!archivedBooks.length}}" class="muted tools-empty">还没有归档的账本。</view></view></view></block>
   <view class="tools-explanation">每笔流水只属于一个账本。关联退款跟随原支出。</view>
  </view></block>
  <block wx:elif="{{bookTab === 'entries'}}"><view class="{{motionPanelClass}}">
   <view class="tools-section-row"><picker range="{{scopeOptions}}" range-key="name" value="{{entryScopeIndex}}" bindchange="entryScopeChange" disabled="{{busy}}"><view class="tools-scope-pill book-filter"><text class="book-filter-name">{{scopeOptions[entryScopeIndex].name}}</text><view class="book-filter-caret" aria-hidden="true"/></view></picker><text>整理流水</text></view>
   <checkbox-group bindchange="chooseEntries"><label wx:for="{{entries}}" wx:key="id" class="entry-card"><checkbox value="{{item.id}}" checked="{{item.selected}}" disabled="{{busy || !member.active}}"/><view class="entry-copy"><button class="entry-link" data-id="{{item.id}}" bindtap="openEntry">{{item.name}} · ¥{{item.amount}}</button><view class="muted">{{item.occurred_on}} · {{item.bookName}}</view></view></label></checkbox-group>
   <button wx:if="{{nextOffset !== null}}" class="button light block" bindtap="more" disabled="{{busy}}">加载更多流水</button><view wx:if="{{!entries.length}}" class="empty">暂无流水，可先在记账页记一笔。</view>
   <view wx:if="{{member.active && entries.length}}" class="card move-card"><view class="tools-label">将已选流水移入</view><picker disabled="{{busy}}" range="{{destinationBooks}}" range-key="name" value="{{moveIndex}}" bindchange="moveBook"><view class="picker">{{destinationBooks[moveIndex].name}} ›</view></picker><button class="button block" bindtap="move" disabled="{{busy || !selectedEntries.length}}">移动已选 {{selectedEntries.length}} 笔</button></view>
   <view class="tools-explanation">选择流水后移动，退款记录随原支出一起调整。</view>
  </view></block>
 </block>
 <block wx:elif="{{mode === 'budgets'}}">
  <view class="budget-navigation"><button class="tools-month-arrow" data-step="-1" bindtap="monthStep" disabled="{{busy}}" aria-label="上个月">‹</button><picker mode="date" fields="month" value="{{month}}" bindchange="monthChange" disabled="{{busy}}"><view class="budget-month-label">{{monthLabel}}</view></picker><button class="tools-month-arrow" data-step="1" bindtap="monthStep" disabled="{{busy}}" aria-label="下个月">›</button><picker class="budget-book-picker" aria-label="选择预算账本，当前{{scopeOptions[scopeIndex].name}}" range="{{scopeOptions}}" range-key="name" value="{{scopeIndex}}" bindchange="scopeChange" disabled="{{busy}}"><view class="tools-scope-pill book-filter"><text class="book-filter-name">{{scopeOptions[scopeIndex].name}}</text><view class="book-filter-caret" aria-hidden="true"/></view></picker></view>
  <block wx:if="{{budget}}"><view class="budget-overview {{motionPanelClass}} {{budget.total.remaining_cents < 0 ? 'is-over' : ''}}"><view class="tools-section-row"><text>{{budget.total.remaining_cents < 0 ? '留意接下来的安排' : '还可以从容安排'}}</text><text class="budget-state-pill">{{budget.total.remainingLabel}}</text></view><view class="budget-remaining">{{budget.total.remainingText}}</view><view class="budget-two-totals"><view><text>月度总预算</text><view>{{budget.total.limitText}}</view></view><view><text>本月净支出</text><view>¥{{budget.total.usedText}}</view></view></view><view class="budget-progress-track" role="progressbar" aria-label="月度预算使用进度" aria-valuenow="{{budget.total.percent}}" aria-valuemin="0" aria-valuemax="100"><view class="budget-progress-fill" style="width:{{budget.total.percent}}%;background:{{budget.total.remaining_cents < 0 ? '#A34E3B' : memberAccent}}"/></view><view class="budget-overview-foot"><text>{{budget.total.status === 'refund_surplus' ? '本月退款形成结余' : budget.total.status === 'unset' ? '设置额度后查看进度' : budget.total.remaining_cents < 0 ? '已超出预算' : budget.total.remaining_cents === 0 ? '本月预算已用完' : budget.total.percent >= 80 ? '已接近预算额度' : '已使用' + budget.total.percent + '%'}}</text><text>按实际收付统计</text></view></view>
   <view class="tools-section-row"><text class="tools-section-title">分类预算</text><button class="tools-inline-action" bindtap="openBudget" disabled="{{busy}}">编辑额度 ✎</button></view><view class="budget-category-list"><view wx:for="{{budgetRows}}" wx:key="id" class="budget-category-display"><view class="budget-category-top"><view class="budget-category-symbol">{{item.symbol}}</view><view class="grow"><view>{{item.name}}</view><view class="muted">已用 ¥{{item.usedText}} / ¥{{item.limitText}}</view></view><text class="budget-category-remaining {{item.progress.remaining_cents < 0 ? 'over-text' : ''}}">{{item.remainingLabel}} ¥{{item.remainingText}}</text></view><view class="budget-progress-track" role="progressbar" aria-label="{{item.name}}预算使用进度" aria-valuenow="{{item.progress.percent}}" aria-valuemin="0" aria-valuemax="100"><view class="budget-progress-fill" style="width:{{item.progress.percent}}%;background:{{item.progress.remaining_cents < 0 ? '#A34E3B' : memberAccent}}"/></view></view><view wx:if="{{!budgetRows.length}}" class="tools-empty"><view>还没有设置分类额度</view><view class="muted">可以给餐饮、居家等分类分别安排预算。</view></view><button class="budget-add-category" bindtap="openBudget" disabled="{{busy}}">＋ 设置分类额度</button></view>
   <view class="tools-explanation">分类预算单独参考，不与总预算重复相加。退款按发生月份抵减。</view><view wx:if="{{budget.category_over_total}}" class="budget-status">分类预算合计超过总预算，请核对；仍可保存。</view><button class="button block" bindtap="openBudget" disabled="{{busy}}">设置本月预算</button><button class="budget-copy-action" bindtap="copyBudget" disabled="{{busy}}">▢ 沿用上月额度</button>
  </block>
 </block>
 <block wx:elif="{{mode === 'appearance'}}">
  <view class="card appearance-intro"><view class="appearance-heading">让手账更像你</view><view class="muted">先预览，再应用。配色用于记账、统计与导航；模板用于小报。账本封面请在“我的账本”中设置。</view></view>
  <view class="card appearance-preview-card">
   <view class="appearance-tabs"><button data-tab="page" bindtap="appearanceTab" class="{{appearancePreviewTab === 'page' ? 'chosen' : ''}}">页面效果</button><button data-tab="cash" bindtap="appearanceTab" class="{{appearancePreviewTab === 'cash' ? 'chosen' : ''}}">收支小报</button><button data-tab="collection" bindtap="appearanceTab" class="{{appearancePreviewTab === 'collection' ? 'chosen' : ''}}">收藏小报</button></view>
   <view class="preview-caption">示例数据 · 不计入你的账目</view>
   <view wx:if="{{appearancePreviewTab === 'page'}}" class="page-effect" style="background:{{previewSoft}}">
    <view class="mock-toolbar" style="background:{{previewSoft}}"><view class="mock-book-choice"><text>全部账本</text><view class="book-filter-caret"/></view><view>我的账本</view><view>本月预算</view></view>
    <view class="mock-card"><text class="muted">十月净支出</text><view class="mock-amount">¥348.00</view><view class="mock-budget"><text>本月预算</text><text>剩余 ¥652.00</text></view><view class="mock-track"><view style="background:{{previewColor}}"></view></view><view class="mock-note">预算已使用 34.8%</view></view>
    <view class="mock-action" style="background:{{previewColor}}">＋ 记一笔</view>
    <view class="mock-nav"><text>收藏</text><text style="background:{{previewColor}}">记账</text><text>统计</text><text>我的</text></view>
   </view>
   <block wx:else><view wx:if="{{appearancePreviewLoading}}" class="preview-status"><cat-loading label="正在生成小报…"/></view><view wx:if="{{appearancePreviewError}}" class="preview-status">{{appearancePreviewError}}<button class="mini-button" bindtap="renderAppearancePreview">重试预览</button></view><image wx:if="{{appearancePreviewPath && !appearancePreviewLoading && !appearancePreviewError}}" class="report-preview-image" src="{{appearancePreviewPath}}" mode="widthFix"/></block>
  </view>
  <view class="card appearance-settings {{motionPanelClass}}"><view class="appearance-context">{{appearancePreviewTab === 'page' ? '调整页面效果' : appearancePreviewTab === 'cash' ? '调整收支小报' : '调整收藏小报'}}</view><view class="appearance-heading">{{appearancePreviewTab === 'page' ? '页面配色' : '小报配色'}}</view><view class="appearance-scope">配色同时用于页面和两种小报。</view><view class="appearance-options"><button wx:for="{{themeOptions}}" wx:key="id" class="appearance-chip {{appearance.theme === item.id ? 'selected' : ''}}" style="background:{{item.color}}" bindtap="chooseAppearance" disabled="{{busy}}" data-field="theme" data-id="{{item.id}}">{{item.name}}</button></view>
   <block wx:if="{{appearancePreviewTab !== 'page'}}"><view class="appearance-heading">小报模板</view><view class="appearance-scope">模板同时用于收支和收藏小报。</view><view class="template-options"><button wx:for="{{templateOptions}}" wx:key="id" class="template-option {{appearance.template === item.id ? 'selected' : ''}}" bindtap="chooseAppearance" disabled="{{busy}}" data-field="template" data-id="{{item.id}}"><text>{{item.name}}</text><text class="muted">{{item.note}}</text></button></view>

   </block><view class="draft-note">{{appearanceDirty ? '预览中的更改尚未应用' : '当前为已保存的选择'}} · 所有用户免费使用</view><button class="button block" bindtap="applyAppearance" disabled="{{busy}}">{{busy ? '正在应用…' : '应用外观'}}</button><button class="button light block" bindtap="resetAppearance" disabled="{{busy}}">恢复默认</button><view class="muted">恢复默认后仍需点击“应用外观”。保存的外观会持续使用。</view>
  </view>
  <canvas type="2d" id="cash-report-canvas" class="appearance-canvas"/><canvas type="2d" id="report-canvas" class="appearance-canvas"/>
 </block>
 </block>
 <view wx:if="{{bookSheetOpen}}" class="member-sheet-mask book-sheet-mask {{motionClosing === 'bookSheetOpen' ? 'motion-closing' : ''}}" style="bottom:{{bookKeyboardInset}}px" bindtap="closeBookSheet" catchtouchmove="keepSheet">
  <view class="member-edit-sheet book-edit-sheet" catchtap="keepSheet">
   <view class="tools-section-row"><text class="tools-section-title">{{editingBook ? '编辑账本' : '新建账本'}}</text><button class="sheet-close" bindtap="closeBookSheet" disabled="{{busy}}" aria-label="关闭账本编辑">×</button></view>
   <scroll-view scroll-y class="member-sheet-scroll book-sheet-scroll" style="height:{{bookScrollHeight}}px;max-height:{{bookScrollHeight}}px" scroll-into-view="{{bookScrollTarget}}">
    <view class="field" id="book-field-name"><text class="book-field-label">账本名称</text><input class="book-name-input" value="{{bookForm.name}}" data-field="name" bindinput="bookInput" bindfocus="bookFocus" bindblur="bookBlur" bindkeyboardheightchange="bookKeyboardChange" adjust-position="{{false}}" maxlength="32" disabled="{{busy}}" placeholder="给这一册起个名字" placeholder-class="book-input-placeholder" aria-label="账本名称"/></view>
    <view class="field"><text class="book-field-label">封面</text><view class="book-cover-options"><button wx:for="{{covers}}" wx:key="id" class="book-cover-option {{bookForm.cover === item.id ? 'chosen' : ''}}" data-index="{{index}}" bindtap="coverChange" disabled="{{busy}}" aria-label="{{item.name}}封面" aria-pressed="{{bookForm.cover === item.id}}"><image src="{{item.path}}" mode="aspectFit"/><text>{{item.name}}</text><text wx:if="{{bookForm.cover === item.id}}" class="cover-choice-mark">✓</text></button></view></view>
    <view class="book-preview" id="book-style-preview"><view class="book-preview-label">预览</view><view class="book-display"><image class="book-comic-cover" src="{{bookPreview.coverPath}}" mode="aspectFit"/><view class="book-copy"><view class="book-name">{{bookPreview.name}}</view><view class="muted">{{bookPreview.coverName}}</view></view></view></view>
    <view wx:if="{{error}}" class="sheet-error">{{error}}</view>
   </scroll-view><button class="button block cat-loading-button" bindtap="saveBook" disabled="{{busy}}"><cat-loading wx:if="{{busy}}" paw label=""/>保存账本</button>
  </view>
 </view>
 <view wx:if="{{budgetSheetOpen}}" class="member-sheet-mask budget-sheet-mask {{motionClosing === 'budgetSheetOpen' ? 'motion-closing' : ''}}" style="bottom:{{budgetKeyboardInset}}px" bindtap="closeBudgetSheet" catchtouchmove="keepSheet"><view class="member-edit-sheet" catchtap="keepSheet"><view class="tools-section-row"><text class="tools-section-title">安排本月预算</text><button class="sheet-close" bindtap="closeBudgetSheet" disabled="{{busy}}" aria-label="关闭预算编辑">×</button></view><scroll-view scroll-y class="member-sheet-scroll budget-sheet-scroll" style="height:{{budgetScrollHeight}}px;max-height:{{budgetScrollHeight}}px" scroll-into-view="{{budgetScrollTarget}}"><view class="muted">{{monthLabel}} · {{scopeOptions[scopeIndex].name}}</view><view class="field budget-total-field" id="budget-field-total"><text class="budget-field-label">月度总预算（元）</text><view class="budget-input-shell"><input class="budget-amount-input" type="digit" value="{{budgetTotal}}" bindinput="budgetInput" bindfocus="budgetFocus" bindblur="budgetBlur" bindkeyboardheightchange="budgetKeyboardChange" adjust-position="{{false}}" placeholder="输入金额" placeholder-class="budget-input-placeholder" aria-label="月度总预算，单位元" disabled="{{busy}}"/></view><view class="budget-field-help">留空则不设置总预算</view></view><view class="tools-section-title">分类额度</view><view class="muted">分类额度单独参考，不与总预算重复相加。</view><view wx:for="{{budgetCategories}}" wx:key="id" class="budget-category" id="budget-field-{{index}}"><view>{{item.name}}</view><view class="budget-input-shell"><input class="budget-amount-input" type="digit" value="{{item.value}}" data-index="{{index}}" bindinput="budgetInput" bindfocus="budgetFocus" bindblur="budgetBlur" bindkeyboardheightchange="budgetKeyboardChange" adjust-position="{{false}}" placeholder="不设置" placeholder-class="budget-input-placeholder" aria-label="{{item.name}}预算，单位元" disabled="{{busy}}"/></view></view><view wx:if="{{error}}" class="sheet-error">{{error}}</view></scroll-view><view class="tools-explanation">{{budgetDraftDirty ? '草稿尚未保存' : '更改后点击保存生效'}}</view><button class="button block cat-loading-button" bindtap="saveBudget" disabled="{{busy}}"><cat-loading wx:if="{{busy}}" paw label=""/>保存预算</button></view></view>

 <view wx:if="{{dragBook}}" class="book-display book-floating" style="top:{{dragBookTop}}px;left:{{dragBookLeft}}px;width:{{dragBookWidth}}px"><image class="book-comic-cover" src="{{dragBook.coverPath}}" mode="aspectFit"/><view class="book-copy"><view class="book-name">{{dragBook.name}}</view><view class="muted">松手调整位置</view></view><view class="book-floating-grip">≡</view></view>
</view>

<cat-feedback id="cat-feedback"/>
