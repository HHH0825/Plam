@import "../../styles/purchases.wxss";
.expense-editor{overflow:hidden}.editor-caption{font-size:14px;color:#8d7756;line-height:1.6;margin-bottom:16px}.expense-kind-cards{display:flex;gap:10px}.purchase-page .expense-kind{display:flex;flex:1;align-items:center;gap:8px;min-width:0;margin:0;padding:14px 10px;border:1px solid #ece8db;border-radius:16px;background:#faf9f5;line-height:1.4;text-align:left;font-size:16px;font-weight:650;white-space:normal;overflow-wrap:anywhere}.expense-kind::after,.expense-cycle::after,.expense-more::after{border:0}.expense-kind image{width:32px;height:38px;flex:none}.expense-kind text{display:block;font-size:11px;color:#948571;font-weight:400;margin-top:5px}.purchase-page .expense-kind.chosen,.purchase-page .expense-cycle.chosen{background:#fff2b5;border-color:#e6cc70;color:#57482b}.editor-kind-fixed{display:inline-block;border-radius:12px;padding:9px 12px;background:#fff4c9;font-size:14px}.editor-hint{margin-top:8px}.expense-cycles{display:flex;flex-wrap:wrap;gap:8px}.purchase-page .expense-cycle{flex:1 1 38%;margin:0;min-height:44px;padding:10px 6px;border-radius:12px;background:#f7f6f1;border:1px solid #ece9df;font-size:14px;line-height:1.5;white-space:normal}.expense-switch{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 0;font-size:15px;line-height:1.6}.expense-switch>view{flex:1;min-width:0}.expense-switch text{display:block;font-size:12px;color:#8a806f;margin-top:4px}.expense-switch switch{flex:none}.purchase-page .expense-more{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;min-height:48px;margin:18px 0 0;padding:12px 0;border-top:1px solid #eee9dd;border-radius:0;background:transparent;line-height:1.6;font-size:14px;text-align:left}.expense-more text{font-size:12px;color:#967a3d}.expense-optionals{padding:0 4px}.expense-initial{margin-top:16px;padding-top:8px;border-top:1px solid #eee9dd}.expense-summary{margin:20px 0 12px;padding:16px;border:1px solid #efe5bb;border-radius:16px;background:#fffae9;font-size:13px;line-height:1.8;overflow-wrap:anywhere}.expense-summary-label{font-size:11px;color:#9b834b;margin-bottom:6px}.expense-summary-title{font-size:17px;font-weight:650;color:#55472c;margin-bottom:5px}.expense-summary-note{margin-top:10px;padding-top:10px;border-top:1px dashed #e9dcab;color:#8b7350}.expense-paid-total{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;font-size:14px;padding:12px 0}.expense-paid-total text{font-weight:650}.expense-pending{font-size:13px;line-height:1.7;color:#8b6d3e;margin:12px 0}.expense-editor button[disabled]{opacity:.55}@media(max-width:350px){.expense-kind-cards{gap:7px}.purchase-page .expense-kind{padding:12px 8px;font-size:14px;gap:5px}.expense-kind image{width:26px;height:32px}}@media(prefers-reduced-motion:reduce){.expense-kind,.expense-cycle,.expense-more{animation:none!important;transition:none!important}}

.payment-actions{display:flex;gap:10px;margin-top:14px}.payment-actions .button{flex:1;min-width:0;margin:0;min-height:44px;padding:10px 12px;line-height:1.5;border:1px solid transparent;border-radius:12px}.purchase-page .payment-edit{background:#fff4c8;border-color:#ead89a;color:#75602c}.purchase-page .payment-void-action,.purchase-page .expense-delete{background:#fff1f4;border:1px solid #edcdd7;color:#a54d68}.expense-detail-footer{display:flex;flex-direction:column;gap:10px;margin-top:18px}.purchase-page .expense-detail-footer .button{width:100%;margin:0;min-height:46px;padding:11px 14px;line-height:1.5;overflow-wrap:anywhere}.payment-actions .button[disabled],.expense-detail-footer .button[disabled]{background:#f4f2ee;color:#aaa294;border-color:#e8e4dc}
