:host{display:block;min-width:0}
.time-progress{margin:16px 0 0;padding:14px 0 0;border-top:1px solid #EEEDE8;color:#292929;pointer-events:none}
.time-heading{display:flex;align-items:center;justify-content:space-between;gap:8px 12px;flex-wrap:wrap;line-height:1.5}
.time-label-group{display:flex;align-items:center;gap:7px;min-width:0;max-width:100%}
.time-paw{display:block;width:16px;height:16px;flex:none;pointer-events:none}
.time-label{font-size:14px;color:#66635E;overflow-wrap:anywhere}.time-state{font-size:12px}
.time-value{max-width:100%;color:#292929;font-weight:700}
.time-day-count{display:flex;align-items:baseline;gap:4px;flex:none;white-space:nowrap}
.time-number{font-size:28px;line-height:1.3}.time-unit{font-size:14px;font-weight:500;flex:none}
.time-status{font-size:18px;line-height:1.5;overflow-wrap:anywhere}
.time-track{height:8px;margin:10px 0 12px;background:#EEEDE8;border-radius:999px;overflow:hidden;pointer-events:none}
.time-fill{height:100%;background:#F4CE63;border-radius:inherit}
.time-caption{font-size:12px;color:#77736C;line-height:1.7;overflow-wrap:anywhere}.time-payment{margin-top:2px}
.time-unknown{background:#EEEDE8}
.time-urgent .time-value{color:#93435F}.time-urgent .time-track{background:#FCE4ED}.time-urgent .time-fill{background:#F1B4C9}
.time-disabled .time-label,.time-disabled .time-value,.time-disabled .time-caption{color:#818181}.time-disabled .time-track{background:#EEEEEC}.time-disabled .time-fill{background:#CECECA}.time-disabled .time-paw{filter:grayscale(1);opacity:.5}
