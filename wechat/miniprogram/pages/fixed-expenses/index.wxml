<view class="member-themed {{memberThemeClass}} page purchase-page" style="{{memberThemeStyle}}">
  <view class="purchase-heading"><view><text class="title">订阅/分期</text><view class="muted small">持续的花费，也记清楚。</view></view></view>
  <view wx:if="{{!editing && !selected && !detailMissing}}" class="subscription-toolbar">
    <picker class="subscription-filter status-filter-picker" range="{{filters}}" value="{{filterIndex}}" bindchange="filter" disabled="{{busy || loading || !listReady}}" aria-label="切换订阅分期状态，当前{{filters[filterIndex]}}"><view class="list-filter"><image class="status-filter-icon" src="/assets/purchase-entry/status-filter.png" mode="aspectFit" aria-hidden="true"/><text>{{filters[filterIndex]}}</text></view></picker>
    <button class="button subscription-add" bindtap="add" disabled="{{busy || loading || !listReady || featureUnavailable}}">新增订阅/分期</button>
  </view>
  <view wx:if="{{error && !loading}}" class="error subscription-error" role="alert">{{error}}<button wx:if="{{detailMissing}}" class="text-button" bindtap="back">返回列表</button><button wx:elif="{{conflict}}" class="text-button" bindtap="reviewConflict">核对最新版本</button><button wx:elif="{{!editing && !selected}}" class="text-button subscription-recheck" bindtap="load" disabled="{{busy}}">{{featureUnavailable ? '重新检查' : '重试'}}</button></view>
  <view wx:if="{{listReady && itemsError && !detailMissing}}" class="association-warning" role="status">{{itemsError}}<button class="text-button" bindtap="retryItems" disabled="{{itemsLoading || busy}}">重新读取关联物品</button></view>
  <view wx:if="{{detailMissing}}" class="empty">返回列表后可重新查看其他订阅/分期。</view>
  <view wx:elif="{{editing}}" class="card purchase-form expense-editor">
    <view class="editor-caption">{{selected ? '调整付款安排' : '给持续的花费，留一张小纸条'}}</view>
    <view wx:if="{{!selected}}" class="expense-kind-cards">
      <button class="expense-kind {{kindIndex === 0 ? 'chosen' : ''}}" data-index="0" bindtap="kindChange" disabled="{{busy || createPending}}"><image src="/assets/item-covers/notebook.png" mode="aspectFit"/><view>订阅续费<text>会员、软件与服务</text></view></button>
      <button class="expense-kind {{kindIndex === 1 ? 'chosen' : ''}}" data-index="1" bindtap="kindChange" disabled="{{busy || createPending}}"><image src="/assets/item-covers/phone.png" mode="aspectFit"/><view>分期还款<text>每月慢慢还清</text></view></button>
    </view>
    <view wx:else class="editor-kind-fixed">{{kinds[kindIndex]}} · 类型保持不变</view>
    <view class="field"><text>名称 *</text><input data-field="name" value="{{form.name}}" bindinput="field" maxlength="120" placeholder="{{form.kind === 'installment' ? '例如：手机分期' : '例如：音乐会员'}}" disabled="{{busy || createPending || !listReady}}"/></view>
    <block wx:if="{{form.kind === 'subscription'}}">
      <view class="field"><text>每期费用（元）*</text><input type="digit" value="{{form.amount}}" data-field="amount" bindinput="field" placeholder="例如：30.00" disabled="{{busy || createPending || !listReady}}"/></view>
      <view class="field"><text>付款周期</text><view class="expense-cycles"><button wx:for="{{cycles}}" wx:key="*this" class="expense-cycle {{cycleIndex === index ? 'chosen' : ''}}" data-index="{{index}}" bindtap="cycleChange" disabled="{{busy || createPending}}">{{item}}</button></view></view>
      <view wx:if="{{form.cycle === 'days'}}" class="field"><text>每隔多少天 *</text><input type="number" data-field="cycle_days" value="{{form.cycle_days}}" bindinput="field" placeholder="1—3650天" disabled="{{busy || createPending || !listReady}}"/></view>
    </block>
    <block wx:else>
      <view class="field"><text>分期本金总额（元）*</text><input type="digit" data-field="principal_total" value="{{form.principal_total}}" bindinput="field" placeholder="例如：6000.00" disabled="{{busy || createPending || !listReady}}"/></view>
      <view class="field"><text>总期数（每月一期）*</text><input type="number" data-field="periods" value="{{form.periods}}" bindinput="field" disabled="{{busy || createPending || !listReady}}"/></view>
    </block>
    <view class="field"><text>{{form.kind === 'installment' ? '首期还款日 *' : recordInitial ? '本期扣费日 *' : '下次付款日 *'}}</text><picker mode="date" data-field="anchor_on" value="{{form.anchor_on}}" bindchange="dateField" disabled="{{busy || createPending || !listReady}}"><view class="picker-value">{{form.anchor_on}} ›</view></picker><view class="muted small editor-hint">付款安排不等于服务有效期；提前或延后付款请填写实际日期。</view></view>
    <block wx:if="{{form.kind === 'installment'}}"><view class="expense-switch"><view>有利息／手续费<text>默认免息，不含本金</text></view><switch checked="{{hasFees}}" bindchange="toggleFees" color="#e2bd4a" disabled="{{busy || createPending}}"/></view><view wx:if="{{hasFees}}" class="field"><text>每期额外费用（元）*</text><input type="digit" data-field="amount" value="{{form.amount}}" bindinput="field" placeholder="仅填每期利息与手续费" disabled="{{busy || createPending || !listReady}}"/></view><view class="muted small editor-hint">本金按分均摊，尾差在最后一期补齐。记账含本金和费用，物品成本不重复计算本金。</view></block>
    <button class="expense-more" bindtap="toggleMore" aria-expanded="{{moreOpen}}">更多选填<text>{{moreOpen ? '收起 −' : '展开 ＋'}}</text></button>
    <view wx:if="{{moreOpen}}" class="expense-optionals">
      <view class="field"><text>关联物品</text><picker range="{{itemNames}}" value="{{itemIndex}}" bindchange="itemChange" disabled="{{busy || createPending || !itemsReady}}"><view class="picker-value">{{formLinkText}} ›</view></picker></view>
      <block wx:if="{{form.kind === 'subscription'}}"><view class="muted small">服务有效期仅供提醒，不会改动付款安排。</view><view class="field"><text>服务开始日期</text><picker mode="date" data-field="service_from" value="{{form.service_from}}" bindchange="dateField" disabled="{{busy || createPending}}"><view class="picker-value">{{form.service_from || '未填写'}} ›</view></picker><button wx:if="{{form.service_from}}" class="text-button" data-field="service_from" bindtap="clearDate" disabled="{{busy || createPending}}">清除</button></view><view class="field"><text>服务到期日期</text><picker mode="date" data-field="service_until" value="{{form.service_until}}" bindchange="dateField" disabled="{{busy || createPending}}"><view class="picker-value">{{form.service_until || '未填写'}} ›</view></picker><button wx:if="{{form.service_until}}" class="text-button" data-field="service_until" bindtap="clearDate" disabled="{{busy || createPending}}">清除</button></view></block>
      <view class="field"><text>备注</text><textarea auto-height data-field="notes" value="{{form.notes}}" bindinput="field" maxlength="1000" disabled="{{busy || createPending}}"/></view>
    </view>
    <view wx:if="{{selected}}" class="field"><text>管理状态</text><picker range="{{statuses}}" value="{{statusIndex}}" bindchange="statusChange" disabled="{{busy}}"><view class="picker-value">{{statuses[statusIndex]}} ›</view></picker><view class="muted small">暂停或结束只停止提醒；真实订阅需向服务商取消。</view></view>
    <view wx:else class="expense-initial">
      <view class="expense-switch"><view>本期已经付了，顺手记一笔<text>只记本次，不补记历史付款</text></view><switch checked="{{recordInitial}}" bindchange="toggleInitial" color="#e2bd4a" disabled="{{busy || createPending || quickState !== 'ready'}}"/></view>
      <view wx:if="{{quickState === 'loading' && !createPending}}" class="muted small">正在确认记账状态…</view><view wx:elif="{{quickState === 'unavailable' && !createPending}}" class="muted small">同时记首笔需同步后端；目前可正常保存计划。</view><view wx:elif="{{quickState === 'error' && !createPending}}" class="muted small">{{quickError}}<button class="text-button" bindtap="loadQuickSupport">重试</button></view>
      <block wx:if="{{recordInitial}}"><view class="field"><text>实际付款日期 *</text><picker mode="date" end="{{today}}" data-field="paid_on" value="{{initialForm.paid_on}}" bindchange="initialField" disabled="{{busy || createPending}}"><view class="picker-value">{{initialForm.paid_on}} ›</view></picker></view><view wx:if="{{form.kind === 'installment'}}" class="field"><text>本次已还本金（元）*</text><input type="digit" data-field="principal" value="{{initialForm.principal}}" bindinput="initialField" disabled="{{busy || createPending}}"/></view><view class="field"><text>{{form.kind === 'installment' ? '本次利息／手续费（元）*' : '本次实付费用（元）*'}}</text><input type="digit" data-field="amount" value="{{initialForm.amount}}" bindinput="initialField" disabled="{{busy || createPending}}"/></view><view class="expense-paid-total">本次实付合计<text>¥{{formSummary.actual}}</text></view><view wx:if="{{initialConsent}}" class="muted small">已确认：保存时同时启用记账。</view></block>
    </view>
    <view class="expense-summary" role="status"><view class="expense-summary-label">小猫帮你核对</view><view class="expense-summary-title">{{formSummary.title}}</view><view>{{formSummary.detail}}</view><view wx:if="{{form.kind === 'installment'}}">{{selected ? '下期' : '首期'}}还款日 {{form.anchor_on}}</view><view class="expense-summary-note">{{formSummary.note}}</view></view>
    <view wx:if="{{createPending}}" class="expense-pending">这次保存结果正在核对，填写内容已保留。重试会核对同一次操作，请勿另建重复计划。</view>
    <view class="actions"><button class="button cat-loading-button" bindtap="save" disabled="{{busy || !listReady}}"><cat-loading wx:if="{{busy}}" paw label=""/>{{createPending ? '核对保存结果' : recordInitial ? '保存并记一笔' : '保存计划'}}</button><button class="button light" bindtap="back" disabled="{{busy}}">返回列表</button></view>
  </view>
  <block wx:elif="{{selected}}">
    <view class="card"><view class="row"><text class="row-title">{{selected.name}}</text><text class="pill wish-considering">{{selected.stateText}}</text></view><view class="expense-amount">{{selected.kind === 'installment' ? '每期额外费用' : '计划每期'}} ¥{{selected.amount}}</view><view class="expense-meta">{{selected.kindText}}</view><expense-progress class="expense-time-progress" progress="{{selected.progress}}" footnote="{{selected.kind === 'subscription' ? selected.dueText : ''}}"/><view class="expense-meta">服务有效期：{{selected.service_from || '未填写'}} — {{selected.service_until || '未填写'}}</view><view wx:if="{{selected.kind === 'installment'}}" class="expense-totals">已还本金 ¥{{selected.paid_principal}} / ¥{{selected.principal_total}}<view>剩余本金 ¥{{selected.remaining_principal}} · 已付 {{selected.paid_periods}} 期</view><view>下一期待还本金 ¥{{selected.suggested_principal}}</view></view><view class="expense-meta">已付费用 ¥{{selected.paid_cost}}（不含本金）</view><button wx:if="{{selected.item_available}}" class="text-button" data-id="{{selected.item_id}}" bindtap="openItem">关联物品：{{selected.item_name}} ›</button><view wx:elif="{{selected.item_name}}" class="expense-meta">原关联：{{selected.item_name}}（已删除）</view><view wx:if="{{selected.check_renewal}}" class="expense-reminder urgent">设备已处置或删除，请检查是否仍需续费；费用历史保留。</view><view class="expense-meta">{{selected.notes}}</view><view class="actions"><button class="button" bindtap="beginPay" disabled="{{busy || !listReady || selected.status !== 'active' || selected.completed}}">确认已付</button><button class="button light" bindtap="edit" disabled="{{busy || !listReady}}">编辑订阅/分期</button></view></view>
    <view wx:if="{{paying}}" class="card purchase-form"><text class="section-title">{{payment.id ? '修改历史付款' : '确认实际付款'}}</text><view class="muted small">对应付款周期：{{payment.due_on || selected.next_due_on}}。仅此操作计入支出。</view><view class="field"><text>付款日期 *</text><picker mode="date" end="{{today}}" data-field="paid_on" value="{{payment.paid_on}}" bindchange="paymentField" disabled="{{busy || !listReady}}"><view class="picker-value">{{payment.paid_on}} ›</view></picker></view><view wx:if="{{selected.kind === 'installment'}}" class="field"><text>实际已还本金（元）*</text><input type="digit" data-field="principal" value="{{payment.principal}}" bindinput="paymentField" disabled="{{busy || !listReady}}"/></view><view class="field"><text>{{selected.kind === 'installment' ? '实际利息／手续费（元）*' : '实际服务费用（元）*'}}</text><input type="digit" data-field="amount" value="{{payment.amount}}" bindinput="paymentField" disabled="{{busy || !listReady}}"/></view><view wx:if="{{!payment.id && selected.kind === 'subscription'}}" class="field"><text>续费后服务到期日期（选填）</text><picker mode="date" data-field="service_until" value="{{payment.service_until}}" bindchange="paymentField" disabled="{{busy || !listReady}}"><view class="picker-value">{{payment.service_until || '保持原有效期'}} ›</view></picker></view><view class="field"><text>本笔付款关联物品</text><picker range="{{itemNames}}" value="{{paymentItemIndex}}" bindchange="paymentItem" disabled="{{busy || !itemsReady}}"><view class="picker-value">{{paymentLinkText}} ›</view></picker></view><view class="field"><text>付款备注</text><textarea auto-height data-field="notes" value="{{payment.notes}}" bindinput="paymentField" maxlength="1000" disabled="{{busy || !listReady}}"/></view><view class="actions"><button class="button cat-loading-button" bindtap="savePayment" disabled="{{busy || !listReady}}"><cat-loading wx:if="{{busy}}" paw label=""/>{{payment.id ? '保存修改' : '确认已付并记账'}}</button><button class="button light" bindtap="cancelPay" disabled="{{busy}}">取消</button></view></view>
    <view class="card"><text class="section-title">付款历史</text><view wx:if="{{!selected.payments.length}}" class="muted small">还没有实际付款，费用计划不会自动记账。</view><view wx:for="{{selected.payments}}" wx:key="id" class="payment-row {{item.voided ? 'payment-void' : ''}}"><view class="row"><text>{{item.paid_on}}</text><text>{{item.voided ? '已作废' : '已付'}} ¥{{item.amount}}</text></view><view class="expense-meta">对应 {{item.due_on}}<text wx:if="{{selected.kind === 'installment'}}"> · 本金 ¥{{item.principal}}</text><view wx:if="{{item.item_name}}">{{item.item_name}} · {{item.item_available ? '关联物品' : '原关联物品'}}</view>{{item.notes}}</view><view wx:if="{{!item.voided}}" class="payment-actions"><button class="button payment-edit" data-id="{{item.id}}" bindtap="beginPay" disabled="{{busy || !listReady}}">修改</button><button class="button payment-void-action" data-id="{{item.id}}" bindtap="voidPayment" disabled="{{busy || !listReady}}">作废</button></view></view></view><view class="expense-detail-footer"><button class="button light" bindtap="back" disabled="{{busy}}">返回列表</button><button class="button expense-delete" bindtap="remove" disabled="{{busy || !listReady}}">删除空订阅／分期档案</button></view>
  </block>
  <block wx:else><view wx:if="{{totals && !loading && !error}}" class="card expense-totals">累计已付订阅/分期 ¥{{totals.cents}}<view>关联物品 ¥{{totals.linked_cents}} · 独立费用 ¥{{totals.unlinked_cents}}</view><view>已还分期本金 ¥{{totals.principal_cents}}（不重复计入物品购买成本）</view></view><view wx:if="{{itemFilter}}" class="expense-reminder">仅看当前物品的费用 <button class="text-button" bindtap="clearItemFilter">查看全部</button></view><view wx:if="{{loading}}" class="empty"><cat-loading label="正在读取订阅/分期…"/></view><view wx:elif="{{!error && listReady && !shown.length}}" class="empty">当前筛选下还没有订阅/分期，记下持续使用的会员或分期吧。</view><block wx:elif="{{!error && listReady}}"><view wx:for="{{shown}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="row-title">{{item.name}}</text><text class="pill wish-considering">{{item.kindText}}</text></view><view class="expense-amount">{{item.kind === 'installment' ? '下期预计 ¥' + item.planned_payment : '计划 ¥' + item.amount}}</view><expense-progress class="expense-time-progress" progress="{{item.progress}}" footnote="{{item.kind === 'subscription' ? item.dueText : ''}}"/><view wx:if="{{item.item_name}}" class="expense-meta expense-linked-item">关联物品：{{item.item_name}}</view><view wx:if="{{item.check_renewal}}" class="expense-meta">关联物品已处置或删除，请检查续费</view></view></block></block>
</view>

<cat-feedback id="cat-feedback"/>

<include src="../../templates/session-status.wxml"/>
