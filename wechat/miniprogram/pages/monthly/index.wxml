<view class="member-themed {{memberThemeClass}} page monthly-page" style="{{memberThemeStyle}}{{reportStyle}}">
  <view class="report-navigation"><text class="eyebrow">收藏小报</text><picker mode="date" fields="month" value="{{month}}" end="{{maxMonth}}" bindchange="changeMonth"><view class="month-select" hover-class="glass-pressed">{{month || '当前月份'}}<text>换一页 ⌄</text></view></picker></view>
  <view wx:if="{{loading}}" class="empty"><cat-loading label="正在整理当月记录…"/></view>
  <view wx:elif="{{error}}" class="card error-panel">{{error}}<button class="button light" bindtap="load">重新读取</button></view>
  <block wx:elif="{{report}}">
    <image wx:if="{{memberReportPath}}" src="{{memberReportPath}}" mode="widthFix" style="width:100%;display:block"/><view wx:elif="{{memberReportPreview}}" class="empty"><cat-loading label="正在整理专属小报…"/></view><view wx:else class="report-paper">
      <view class="paper-surface" aria-hidden="true"/>
      <view class="paper-content">
      <view class="report-masthead"><text class="report-lettering">每月一页</text><view class="report-brand"><image src="/assets/brand/paw-ledger-mark.png" class="report-logo" aria-hidden="true"/><text>猫爪物帐</text></view></view>
      <view class="report-cover"><image src="/assets/white-doodle/postmark.png" class="cover-postmark" aria-hidden="true"/><view class="report-date"><text class="report-year">{{edition.monthEdition}}</text><image src="{{edition.monthArt}}" class="month-art" aria-hidden="true"/><text class="cover-motto">把这个月，轻轻收好。</text></view><image src="/assets/white-doodle/cat-book.png" class="cover-kitten" mode="aspectFit" aria-hidden="true"/></view>
      <view class="report-dateline">{{report.is_current ? '截至今天 · ' : '记录截止 · '}}{{report.cutoff_date}}</view>
      <view wx:if="{{!report.has_activity}}" class="blank-edition"><text class="blank-title">这一页，暂时留白。</text><text>这个月没有购入、维修、处置或订阅/分期记录。</text><button class="journal-link" bindtap="add">录入一件物品 ›</button></view>
      <block wx:else>
        <view class="section-heading"><view class="section-number"><image src="/assets/white-doodle/number-tape.png" aria-hidden="true"/><text>01</text></view><text class="section-title">本月账目</text><image src="/assets/white-doodle/leaf.png" class="heading-leaf" aria-hidden="true"/><text class="section-aside">购入 {{report.totals.purchase_count}} 件</text></view>
        <view class="report-totals"><view><text>购置支出</text><text>¥{{edition.totalsText.purchase_total}}</text></view><view><text>维修支出</text><text>¥{{edition.totalsText.maintenance_total}}</text></view><view><text>订阅/分期支出</text><text>¥{{edition.totalsText.fixed_expense_total}}</text></view><view><text>分期本金（另列）</text><text>¥{{edition.totalsText.installment_principal_total}}</text></view><view><text>处置回收</text><text>¥{{edition.totalsText.disposal_total}}</text></view><view class="cashflow-row"><text>{{edition.balance.label}}</text><text>¥{{edition.balance.amount}}</text></view></view>
        <view class="cashflow-note">{{edition.cashflowNote}}<text>{{edition.cashflowScope}}</text></view>
        <view class="section-heading"><view class="section-number"><image src="/assets/white-doodle/number-tape.png" aria-hidden="true"/><text>02</text></view><text class="section-title">本月支出与回收</text><image src="/assets/white-doodle/leaf.png" class="heading-leaf" aria-hidden="true"/></view>
        <view class="expense-figure"><view wx:for="{{edition.bars}}" wx:key="key" class="expense-row"><view class="expense-label"><text>{{item.label}}</text><text>¥{{item.amount}}</text></view><view class="expense-track"><view wx:if="{{item.width > 0}}" class="expense-line" style="width:{{item.width}}%;background:{{item.color}};"/></view></view><text class="figure-caption">各类支出与处置回收按金额比例对照。</text></view>
        <view wx:if="{{edition.finding}}" class="report-finding"><image src="{{edition.findingArt}}" data-id="{{report.purchase_leaders[0].id}}" binderror="coverFailed" class="finding-art" mode="aspectFit" aria-hidden="true"/><view class="finding-copy"><view class="finding-caption"><image src="/assets/white-doodle/label-tape.png" aria-hidden="true"/><text>这月的一笔</text></view><text class="finding-text">{{edition.finding}}</text><text wx:if="{{edition.findingBasis}}" class="finding-basis">{{edition.findingBasis}}</text><view class="finding-links"><button wx:for="{{report.purchase_leaders}}" wx:key="id" class="journal-link" data-id="{{item.id}}" bindtap="open">查看{{item.name}} ›</button></view></view></view>
        <view wx:if="{{edition.purchases.length}}" class="section-heading"><view class="section-number"><image src="/assets/white-doodle/number-tape.png" aria-hidden="true"/><text>03</text></view><text class="section-title">本月收藏</text><image src="/assets/white-doodle/leaf.png" class="heading-leaf" aria-hidden="true"/><text class="section-aside">{{edition.purchases.length}} 件</text></view>
        <view wx:for="{{edition.purchases}}" wx:key="id" class="purchase-entry" data-id="{{item.id}}" bindtap="open" role="button" aria-label="查看{{item.name}}"><view class="purchase-art"><image src="{{item.art}}" data-id="{{item.id}}" binderror="coverFailed" mode="aspectFit" aria-hidden="true"/><image src="/assets/white-doodle/corner-tape.png" class="corner-tape" aria-hidden="true"/></view><view class="purchase-copy"><text class="purchase-name">{{item.name}}</text><text class="purchase-date">{{item.purchase_date}}</text></view><view class="purchase-price"><text>¥{{item.priceText}}</text><text class="entry-chevron" aria-hidden="true">›</text></view></view>
      </block>
      <view class="report-colophon"><image src="/assets/white-doodle/paw-signature.png" class="signature" aria-hidden="true"/><text class="colophon-brand">猫爪物帐 · 每月一页</text><text>每月一页，按当前保存的记录整理。</text><text>费用按事件日期归月；更正付款或记录、删除或恢复物品后，历史结果可能变化。</text></view>
      </view>
    </view>
    <view class="export-actions"><button id="report-preview" class="button" hover-class="glass-pressed" bindtap="preview" disabled="{{imageBusy || coversLoading}}">预览画页</button><button id="report-save" class="button cat-loading-button" hover-class="glass-pressed" bindtap="saveImage" disabled="{{imageBusy || coversLoading}}"><cat-loading wx:if="{{imageBusy}}" paw label=""/>保存到相册</button></view>
    <button class="button share-report cat-loading-button" bindtap="shareImage" disabled="{{imageBusy || coversLoading}}"><cat-loading wx:if="{{imageBusy}}" paw label=""/>分享小报给朋友</button>
    <button wx:if="{{shareFallback}}" class="button share-card" open-type="share" disabled="{{imageBusy || !coverPath}}">改用小程序卡片分享</button>
    <view class="export-note">图片含金额与物品名称，发送前请确认愿意分享。好友点击小程序入口后进入自己的物品列表。图片收录最多三件购入物品；完整记录见本页。</view><view wx:if="{{imageError}}" class="error" role="alert">{{imageError}}</view>
  </block><canvas type="2d" id="report-canvas" class="report-canvas" aria-hidden="true"/>
</view>
<cat-feedback id="cat-feedback"/>

<include src="../../templates/session-status.wxml"/>
