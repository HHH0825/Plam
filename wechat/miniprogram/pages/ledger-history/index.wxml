<view class="member-themed {{memberThemeClass}} page ledger-page" style="{{memberThemeStyle}}"><view class="ledger-title">把以前的记录，慢慢补齐</view><view class="ledger-muted">确认实际收付，避免重复记账。</view><view class="ledger-card">待核对 {{total}} 笔 · 已选择 {{selectedCount}} 笔</view><view wx:if="{{error}}" class="ledger-error">{{error}}<button wx:if="{{!pending}}" class="ledger-text-button" bindtap="load" disabled="{{busy}}">重新核对</button></view><view wx:if="{{pending}}" class="ledger-error">导入结果尚未确认，当前选择已锁定。<button class="ledger-text-button" bindtap="verify" disabled="{{busy}}">核对导入结果</button></view><view wx:if="{{loading}}" class="ledger-empty"><cat-loading label="正在读取历史记录…"/></view>
<view wx:for="{{rows}}" wx:key="key" class="ledger-card"><view class="ledger-history-top"><button class="ledger-check" data-key="{{item.key}}" bindtap="check" disabled="{{busy || pending}}" aria-label="{{item.checked ? '取消选择' : '选择'}}{{item.name}}">{{item.checked ? '✓' : '○'}}</button><view class="ledger-history-copy"><view class="ledger-row-name">{{item.name}}</view><view class="ledger-muted ledger-small">{{item.source_name}} · {{item.occurred_on}}</view></view><view class="ledger-history-money">¥{{item.amountText}}</view></view><block wx:if="{{item.source === 'purchase'}}"><view class="ledger-help">{{item.mode ? '已选择付款方式，请核对实际金额与日期。' : '尚未确认付款方式，不会自动导入。'}}</view><view class="ledger-history-modes"><button class="{{item.mode === 'paid' ? 'selected' : ''}}" data-key="{{item.key}}" data-mode="paid" bindtap="mode" disabled="{{busy || pending}}">已付款</button><button class="{{item.mode === 'installment' ? 'selected' : ''}}" data-key="{{item.key}}" data-mode="installment" bindtap="mode" disabled="{{busy || pending}}">分期</button><button class="{{item.mode === 'archive' ? 'selected' : ''}}" data-key="{{item.key}}" data-mode="archive" bindtap="mode" disabled="{{busy || pending}}">仅建档</button></view><block wx:if="{{item.mode && item.mode !== 'archive'}}"><view class="ledger-form-field">{{item.mode === 'installment' ? '已付首付（没有则填0）' : '实际付款金额'}}<input type="digit" value="{{item.paidAmount}}" maxlength="12" data-key="{{item.key}}" data-field="paidAmount" bindinput="field" disabled="{{busy || pending}}"/></view><picker mode="date" value="{{item.paidOn}}" end="{{today}}" data-key="{{item.key}}" data-field="paidOn" bindchange="field" disabled="{{busy || pending}}"><view class="ledger-field">付款日期<text>{{item.paidOn}} ›</text></view></picker></block></block></view>
<view wx:if="{{!rows.length && !loading && !error}}" class="ledger-empty">需要核对的记录已经整理好了。</view><button wx:if="{{nextOffset !== null}}" class="ledger-secondary" bindtap="more" disabled="{{loading || busy || pending}}">加载更多</button><view class="ledger-help">分期只导入实际付款，不再计入完整购置价。历史核对可分批完成；未选择的记录保持原样。</view><view class="ledger-form-bottom"><button class="ledger-primary" disabled="{{busy || loading || !selectedCount}}" bindtap="submit">{{busy ? '正在导入…' : pending ? '按原选择重试导入' : '导入已确认的 ' + selectedCount + ' 笔'}}</button><button class="ledger-text-button" bindtap="back" disabled="{{busy}}">暂时跳过，以后再核对</button></view></view>

<cat-feedback id="cat-feedback"/>
