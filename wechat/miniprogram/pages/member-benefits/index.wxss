.member-benefits{padding-bottom:36px}.benefits-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:5px 0 22px}.benefits-heading .title{font-size:24px;line-height:1.5;margin:4px 0}.benefits-eyebrow{font-size:12px;color:#8B8575}.benefits-heading image{width:44px;height:47px;flex:none}.support-letter{padding:0 3px;margin:0 0 24px}.support-letter>view{font-size:13px;line-height:1.95;margin:0 0 12px;color:#77705C}.support-letter>view:last-child{color:#302F2B}.benefits-comparison{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.benefits-column{border:1px solid #EBE9E1;border-radius:18px;background:white;padding:16px 10px;min-width:0}.benefits-vip{border-color:#EED68C;background:#FFFDF5}.benefits-column-heading{text-align:center;display:flex;flex-direction:column;align-items:center;gap:4px;padding-bottom:16px;border-bottom:1px solid #EBE9E1;font-size:15px;font-weight:600}.benefits-column-heading image{width:30px;height:30px;margin-bottom:4px}.benefits-column-heading text{font-size:11px;font-weight:400;color:#8A8477}.benefits-list{padding:7px 0}.benefits-item{position:relative;display:flex;align-items:flex-start;gap:5px;font-size:12px;line-height:1.8;padding:10px 0;min-height:41px;overflow-wrap:anywhere}.benefits-check{flex:none;color:#93824B}.benefits-item>text:last-child{min-width:0;flex:1}.benefits-free-tail{font-size:11px;color:#9A9483;border-top:1px solid #EBE9E1;padding-top:20px;margin-top:12px;text-align:center;line-height:1.95}.benefits-extra-heading{font-size:12px;font-weight:600;color:#8E7633;padding-top:14px;margin-top:5px;border-top:1px solid #EEDFAF}.benefits-note{font-size:11px;color:#8A8477;line-height:1.9;margin:16px 1px}.benefits-service{border-top:1px solid #EBE9E1;margin:22px 0 14px;padding-top:8px}.member-benefits .benefits-service-toggle{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%!important;max-width:none!important;min-height:44px;padding:8px 0;margin:0;background:transparent;font-size:12px;font-weight:400;color:#8A8477;line-height:1.8;text-align:left;white-space:normal}.benefits-service-toggle::after{border:0}.benefits-service #benefits-service-body>view{font-size:12px;line-height:1.9;color:#81765C;margin-bottom:12px}.member-benefits .benefits-retry{display:inline-block;width:auto!important;margin:0;background:transparent;color:#8E7633;font-size:12px;min-height:44px;line-height:1.8}.benefits-retry::after{border:0}@media(min-width:600px){.member-benefits{max-width:480px}}@media(max-width:350px){.benefits-column{padding:14px 8px}.benefits-comparison{gap:8px}.benefits-item{font-size:11px}.benefits-heading .title{font-size:22px}}

.member-benefits view{box-sizing:border-box}
