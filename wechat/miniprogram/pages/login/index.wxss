@import "./assets/frame.wxss";
.welcome { --welcome-gap:12px; --welcome-title:34px; max-width:430px; display:flex; flex-direction:column; align-items:stretch; gap:var(--welcome-gap); padding-top:12px; padding-bottom:calc(20px + env(safe-area-inset-bottom)); background:transparent; color:#2E2E2E; }
.brand { display:flex; width:100%; align-items:center; justify-content:center; gap:10px; min-height:52px; }
.brand-mark,.brand-logo { display:block; width:44px; height:50px; flex:none; pointer-events:none; }
.brand-fallback { display:block; border:1.5px solid #343434; border-radius:7px; line-height:40px; text-align:center; font-size:22px; }
.brand-name { display:block; flex:none; font-size:28px; line-height:1.25; font-weight:800; letter-spacing:.3px; white-space:nowrap; }
.intro { text-align:center; }
.title { width:100%; position:relative; margin:0; }
.title-art { display:block; width:100%; height:var(--welcome-heading-height); pointer-events:none; }
.title-fallback { font-size:var(--welcome-title); font-weight:800; line-height:1.22; text-align:center; }
.subtitle { margin-top:9px; color:#686868; font-size:13px; line-height:1.6; }
.welcome-art { width:calc(100% + 20px); align-self:center; position:relative; flex:none; }
.welcome-cat { display:block; width:100%; height:100%; pointer-events:none; }
.hero-fallback { display:flex; height:100%; align-items:center; justify-content:center; flex-direction:column; gap:10px; color:#B87586; font-size:12px; }
.fallback-cat { font-size:56px; color:#343434; }
.sample-card { position:relative; margin-top:2px; padding:0 15px 16px; border:1px solid #777; border-radius:20px 18px 21px 17px; background:#FFF; }
.sketch-frame { position:absolute; inset:-1px; pointer-events:none; background:#FFF; border-radius:20px; }
.sketch-frame view { position:absolute; background-repeat:no-repeat; }
.sketch-frame .corner-tl,.sketch-frame .corner-tr,.sketch-frame .corner-bl,.sketch-frame .corner-br { width:32px; height:32px; background-size:32px 32px; }
.sketch-frame .corner-tl { top:0; left:0; }.sketch-frame .corner-tr { top:0; right:0; }.sketch-frame .corner-bl { bottom:0; left:0; }.sketch-frame .corner-br { bottom:0; right:0; }
.sketch-frame .edge-top,.sketch-frame .edge-bottom { left:32px; right:32px; height:7px; background-size:72px 7px; background-repeat:repeat-x; }
.sketch-frame .edge-top { top:0; }.sketch-frame .edge-bottom { bottom:0; }
.sketch-frame .edge-left,.sketch-frame .edge-right { top:32px; bottom:32px; width:7px; background-size:7px 72px; background-repeat:repeat-y; }
.sketch-frame .edge-left { left:0; }.sketch-frame .edge-right { right:0; }
.sample-head { position:relative; z-index:1; display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:8px; margin-top:-13px; margin-bottom:15px; }
.sample-label { position:relative; padding:4px 12px; background:#FFF0A6; border:1.5px solid #454545; border-radius:13px 11px 12px 9px; transform:rotate(-2deg); font-size:13px; line-height:1.5; font-weight:700; letter-spacing:.5px; }
.sample-strokes { position:absolute; right:-17px; top:-14px; width:14px; height:17px; pointer-events:none; }
.sample-content { position:relative; display:flex; align-items:center; gap:12px; }
.sample-photo { width:83px; height:83px; flex:none; display:flex; align-items:center; justify-content:center; border-radius:17px; background:#F6F6F6; }
.sample-camera { width:78px; height:78px; pointer-events:none; }
.camera-fallback { font-size:14px; color:#777; }
.sample-details { min-width:0; flex:1; }
.sample-top { display:flex; align-items:center; flex-wrap:wrap; gap:5px; }
.sample-name { font-weight:700; font-size:14px; line-height:1.4; }
.sample-status { display:inline-flex; align-items:center; gap:4px; background:transparent; color:#93435F; font-size:10px; padding:0; line-height:1.6; white-space:nowrap; }
.sample-status::before { content:''; flex:none; width:5px; height:5px; border-radius:50%; background:#D989A4; }
.sample-metrics { display:flex; flex-wrap:wrap; margin-top:9px; align-items:flex-end; row-gap:9px; }
.sample-stat { min-width:min-content; flex:1 0 auto; }
.sample-stat + .sample-stat { padding-left:13px; margin-left:9px; border-left:1px solid #DDD; }
.sample-caption { display:block; font-size:11px; color:#555; line-height:1.5; white-space:nowrap; }
.sample-number { display:flex; align-items:baseline; gap:2px; margin-top:3px; font-size:25px; line-height:1.2; font-weight:800; white-space:nowrap; }
.days-number { position:relative; display:inline-block; }
.days-number text { position:relative; }
.days-ring { position:absolute; width:calc(100% + 13px); height:calc(100% + 12px); left:-8px; top:-5px; pointer-events:none; }
.sample-currency { font-size:18px; }
.sample-unit { font-size:11px; font-weight:400; }
.sample-disclaimer { display:block; flex:none; margin-left:auto; padding:3px 7px; color:#80600A; background:#FFF9DF; border:1px dashed #D8BC70; border-radius:6px 8px 5px 7px; font-size:11px; font-weight:600; line-height:1.4; white-space:nowrap; transform:rotate(1deg); }
.feature-hints { display:flex; justify-content:space-between; align-items:center; padding:0 2px; min-height:34px; }
.feature { flex:1; display:flex; align-items:center; justify-content:center; gap:6px; min-width:0; }
.feature + .feature { border-left:1px solid #DDD; }
.feature image { display:block; flex:none; width:29px; height:32px; pointer-events:none; }
.feature text { font-size:12px; line-height:1.5; }
.welcome-footer { padding:3px 9px 0; }
.login-control { position:relative; }
.login-button { display:flex; width:100%; min-height:62px; height:auto; align-items:center; justify-content:center; gap:10px; padding:14px 18px; border:2px solid #3E3E3E; border-radius:50px 47px 49px 46px; background:linear-gradient(110deg,#FFE66D,#FFDF57 58%,#FFE573); color:#272727; font-size:19px; line-height:1.4; font-weight:750; overflow:visible; }
.welcome .login-button { width:100%; max-width:none; margin:0; }
.login-button[disabled] { background:#FFEA8F; color:#68624C; opacity:1; }
.login-button::after { border:0; }
.login-paw { width:30px; height:30px; flex:none; pointer-events:none; }
.peek-paw { position:absolute; width:48px; height:36px; right:0; top:-18px; z-index:1; pointer-events:none; }
.welcome-note { text-align:center; font-size:11px; color:#898989; line-height:1.6; margin-top:9px; }
.login-error { font-size:12px; line-height:1.5; margin-top:9px; text-align:center; }
.welcome-compact { padding-top:12px; padding-bottom:calc(16px + env(safe-area-inset-bottom)); }
@media (max-width:350px) {
  .brand-name { font-size:26px; }.brand-mark,.brand-logo { width:40px; height:46px; }
  .subtitle { font-size:12px; }.sample-card { padding:0 10px 16px; }.sample-content { gap:8px; }
  .sample-photo { width:67px; height:76px; }.sample-camera { width:65px; height:65px; }
  .sample-name { font-size:13px; }.sample-number { font-size:23px; }.sample-stat + .sample-stat { padding-left:8px; margin-left:6px; }
  .feature { gap:4px; }.feature image { width:23px; height:28px; }.feature text { font-size:11px; }
  .welcome-footer { padding-left:3px; padding-right:3px; }.login-button { font-size:17px; min-height:58px; padding:13px 11px; }
}
