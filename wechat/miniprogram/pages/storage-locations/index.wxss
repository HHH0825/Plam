@import "../../styles/purchases.wxss";

/* Override the native default-button width, including its attribute selectors. */
.storage-page .location-row,.storage-page .stored-item{width:100%;margin:10px 0}
.storage-page .storage-create,.storage-page .text-button{width:auto;min-width:0;flex:none}
.storage-page .target-row{width:100%;margin:0}
.location-detail-heading>view{display:flex;align-items:center;gap:4px}
.storage-page{box-sizing:border-box;max-width:520px;margin:auto;padding:20px 18px calc(110px + env(safe-area-inset-bottom));color:#292929;background:transparent}.storage-heading{display:flex;align-items:center;justify-content:space-between;margin:8px 0 22px;gap:12px}.storage-heading .title{font-size:27px;font-weight:750}.storage-heading .muted{margin-top:8px;font-size:13px}.storage-mascot{width:66px;height:66px;flex:none}.storage-toolbar{display:flex;align-items:center;gap:8px;margin:14px 0}.storage-search{box-sizing:border-box;flex:1;min-width:0;min-height:44px;padding:10px 12px;border-radius:14px;background:#f7f7f7;font-size:14px}.storage-create{width:auto;flex:none;margin:0;min-height:44px;line-height:1.4;padding:10px 12px;font-size:14px}.location-row,.stored-item{display:flex;align-items:center;box-sizing:border-box;width:100%;gap:12px;text-align:left;background:#fff;min-height:78px;padding:14px 12px;margin:10px 0;border:1px solid #e7e4e1;border-radius:18px;line-height:1.5;box-shadow:0 2px 0 #fff7d5;color:#292929}.location-row::after,.stored-item::after,.target-row::after{border:0}.location-icon{width:38px;height:38px;flex:none;background:#fff7d5;border-radius:12px;padding:5px;box-sizing:border-box}.location-icon.unset{display:flex;align-items:center;justify-content:center;color:#b39556;font-size:23px}.location-copy,.stored-copy{flex:1;min-width:0}.location-name,.stored-name{display:block;font-size:16px;font-weight:650;overflow-wrap:anywhere}.location-copy .muted{display:block;font-size:12px;margin-top:4px}.location-count{font-size:13px;color:#777;white-space:nowrap}.location-arrow{font-size:24px;color:#aaa;flex:none}.muted{color:#777}.location-detail-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:8px 0}.section-title{font-size:20px;font-weight:700;overflow-wrap:anywhere}.storage-page .text-button{display:inline-flex;align-items:center;justify-content:center;background:transparent;color:#826713;min-height:44px;line-height:1.4;font-size:13px;margin:0;padding:8px;box-sizing:border-box}.text-button::after{border:0}.text-button.danger{color:#af526b}.storage-error,.storage-hint{padding:14px;background:#fff7d9;border-radius:16px;font-size:14px;line-height:1.7;overflow-wrap:anywhere;margin:10px 0}.storage-error .text-button{display:block}.storage-name-form{padding:16px;background:#fffaf0;border:1px solid #eee2bd;border-radius:18px}.storage-name-form input{margin:12px 0;min-height:44px;padding:8px 12px;background:#fff;border-radius:12px;font-size:15px}.storage-actions{display:flex;gap:10px}.storage-actions .button{flex:1;min-width:0;min-height:44px;line-height:44px;margin:0;padding:0 12px;font-size:14px}.storage-selection{display:flex;align-items:center;justify-content:space-between;font-size:13px;color:#777}.stored-item{min-height:86px;gap:10px}.stored-photo{width:52px;height:52px;border-radius:12px;background:#f7f7f7;flex:none}.stored-copy .muted{font-size:12px;margin-right:6px}.stored-location{display:block;font-size:12px;color:#9a8145;margin-top:3px;overflow-wrap:anywhere}.stored-item.checked{border-color:#e7c447;background:#fffdf3}.selection-dot{width:20px;height:20px;box-sizing:border-box;border:1px solid #ccc;border-radius:50%;font-size:13px;text-align:center;line-height:18px;flex:none}.selection-dot.selected{background:#ffe15a;border-color:#e3bf39}.storage-batch{position:fixed;bottom:0;left:0;right:0;max-width:520px;box-sizing:border-box;display:flex;gap:10px;margin:auto;padding:12px 18px calc(12px + env(safe-area-inset-bottom));background:rgba(255,255,255,.97);border-top:1px solid #eee;z-index:20}.storage-batch .button{flex:1;min-width:0;min-height:46px;line-height:1.4;font-size:14px;margin:0;padding:12px}.storage-target-mask{position:fixed;inset:0;background:rgba(35,30,25,.28);z-index:100;display:flex;align-items:flex-end}.storage-target{box-sizing:border-box;width:100%;max-width:520px;margin:auto auto 0;padding:16px 18px calc(18px + env(safe-area-inset-bottom));border-radius:24px 24px 0 0;background:#fff}.target-scroll{max-height:50vh;margin-top:12px}.target-row{display:block;box-sizing:border-box;width:100%;text-align:left;padding:12px;min-height:48px;background:#fff;border-bottom:1px solid #eee;line-height:1.5;font-size:15px;color:#292929;overflow-wrap:anywhere}.storage-page .empty{padding:32px 12px;font-size:14px;color:#888;line-height:1.8}.storage-page button[disabled]{opacity:.55}@media(max-width:350px){.storage-toolbar{flex-wrap:wrap}.storage-search{flex-basis:100%}.storage-heading .title{font-size:25px}.location-row{gap:8px}.location-count{font-size:12px}}
