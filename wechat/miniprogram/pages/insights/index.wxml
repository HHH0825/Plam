<view class="member-themed {{memberThemeClass}} page discovery-page" style="{{memberThemeStyle}}">
  <view class="discovery-heading"><view class="heading-copy"><view class="eyebrow">从记录中发现</view><view class="title">小小发现</view><view class="subtitle">翻翻记录，发现值得留意的小事。</view></view><image class="heading-cat" src="/assets/white-doodle/cat-search.png" mode="aspectFit" aria-hidden="true"/></view>
  <view class="section-head"><text class="section-title">值得留意的事</text><text class="section-note">来自你的记录</text></view>
  <view wx:if="{{cardsError}}" class="read-state error-panel" role="alert"><text>分析读取失败：{{cardsError}}</text><button class="text-button" bindtap="loadCards" disabled="{{cardsLoading}}">重新整理</button></view>
  <view wx:if="{{cardsLoading}}" class="read-state"><cat-loading compact label="正在整理发现…"/></view>
  <view wx:if="{{!cardsLoading && !cardsError && cards.length === 0}}" class="card discovery-empty"><image src="/assets/white-doodle/cat-book.png" mode="aspectFit" aria-hidden="true"/><view class="empty-title">今天的小发现还在路上</view><view class="muted">留下物品记录，这里会整理保修、使用和费用的小提醒。</view></view>
  <view wx:for="{{cards}}" wx:key="key" id="analysis-card-{{index}}" class="card discovery-card discovery-{{item.kind}}">
    <view class="finding-top"><view class="finding-icon"><image src="{{item.art}}" mode="aspectFit" aria-hidden="true"/></view><view class="finding-copy"><view class="finding-label">{{item.label}}</view><view class="headline">{{item.headline}}</view></view></view>
    <view wx:if="{{item.items.length}}" class="finding-items"><button wx:for="{{item.shownItems}}" wx:for-item="entry" wx:key="id" class="item-link" bindtap="open" data-id="{{entry.id}}" hover-class="button-hover" aria-label="查看{{entry.name}}"><image src="{{entry.art}}" mode="aspectFit" aria-hidden="true"/><text class="item-name">{{entry.name}}</text><view class="chevron right" aria-hidden="true"/></button></view>
    <button wx:if="{{item.items.length > 3}}" class="text-button more-items" bindtap="toggleCard" data-index="{{index}}" data-field="itemsOpen" aria-expanded="{{item.itemsOpen}}">{{item.itemsOpen ? '收起物品' : '展开其余' + (item.items.length - 3) + '件'}}<view class="chevron {{item.itemsOpen ? 'up' : ''}}" aria-hidden="true"/></button>
    <button class="basis-toggle" bindtap="toggleCard" data-index="{{index}}" data-field="basisOpen" aria-expanded="{{item.basisOpen}}"><text>{{item.basisOpen ? '收起依据' : '查看依据'}}</text><view class="chevron {{item.basisOpen ? 'up' : ''}}" aria-hidden="true"/></button>
    <view wx:if="{{item.basisOpen}}" class="finding-basis motion-panel-a">{{item.explanation}}</view>
  </view>
  <view class="section-head"><text class="section-title">记录小概览</text><text class="section-note">全部物品 · 含已处置</text></view>
  <view wx:if="{{statsError}}" class="read-state error-panel" role="alert"><text>统计读取失败：{{statsError}}</text><button class="text-button" bindtap="loadStats" disabled="{{statsLoading}}">重新读取</button></view>
  <view wx:if="{{statsLoading}}" class="read-state"><cat-loading compact label="正在整理概览…"/></view>
  <view wx:if="{{stats}}" class="card discovery-overview"><view class="overview-main"><view><view class="metric-label">物品数量</view><view class="metric-number">{{stats.total_items}}<text class="metric-unit">件</text></view></view><view><view class="metric-label">累计净成本</view><view class="metric-number">¥{{stats.net_cost_total}}</view></view></view><button class="fold-heading" bindtap="toggleDetails" aria-expanded="{{detailsOpen}}"><text>费用明细</text><view class="chevron {{detailsOpen ? 'up' : ''}}" aria-hidden="true"/></button><view wx:if="{{detailsOpen}}" class="overview-details motion-panel-a"><view wx:for="{{stats.breakdown}}" wx:key="key" class="detail-row"><text class="metric-label">{{item.label}}</text><text>{{item.text}}</text></view></view></view>
  <view class="section-head"><text class="section-title">本月的一页</text></view>
  <view wx:if="{{monthlyError}}" class="read-state error-panel" role="alert"><text>{{monthlyError}}</text><button class="text-button" bindtap="loadMonthly" disabled="{{monthlyLoading}}">重新读取本月</button></view>
  <view wx:if="{{monthlyLoading}}" class="read-state"><cat-loading compact label="正在整理本月记录…"/></view>
  <button wx:if="{{monthly}}" class="card monthly-brief" bindtap="monthlyReport" hover-class="button-hover" aria-label="查看本月收藏小报"><view class="monthly-title"><image src="/assets/ledger-nav/ledger.png" mode="aspectFit" aria-hidden="true"/><view class="finding-copy"><view class="monthly-label">{{monthly.month}} · 收藏小报</view><view class="monthly-invite">翻开这个月的一页</view></view><view class="chevron right" aria-hidden="true"/></view><view class="brief-ledger summary-region brief-{{monthlyLayout.kind}}"><view class="brief-count summary-count"><text class="metric-label">购入</text><view class="brief-value">{{monthly.totals.purchase_count}}<text class="metric-unit">件</text></view></view><view class="brief-balance"><text class="metric-label">{{monthly.page.balance.label}}</text><scroll-view wx:if="{{!monthly.page.balance.empty}}" class="brief-amount-scroll" scroll-x="{{monthlyLayout.scroll}}" style="height:{{monthlyLayout.height}}px;font-size:{{monthlyLayout.size}}px;"><text class="brief-value brief-balance-value">¥{{monthly.page.balance.amount}}</text></scroll-view></view><view wx:if="{{!monthly.page.balance.empty}}" class="summary-probes" aria-hidden="true"><text wx:for="{{amountSizes}}" wx:key="*this" class="summary-probe brief-money-probe" data-size="{{item}}" style="font-size:{{item}}px;">¥{{monthly.page.balance.amount}}</text></view></view><view class="monthly-scope">{{monthly.has_activity ? monthly.page.cashflowNote : '本月还没有购入、维修、回收或订阅／分期记录。'}}</view><view class="monthly-scope">{{monthly.page.cashflowScope}}</view><view class="monthly-cutoff">截至 {{monthly.cutoff_date}} · 查看完整小报</view></button>
  <view wx:if="{{trend.length}}" class="card discovery-trend"><button class="fold-heading" bindtap="toggleTrend" aria-expanded="{{trendOpen}}"><image src="/assets/ledger-nav/statistics.png" mode="aspectFit" aria-hidden="true"/><text>订阅／分期支出趋势</text><view class="chevron {{trendOpen ? 'up' : ''}}" aria-hidden="true"/></button><view wx:if="{{trendOpen}}" class="motion-panel-a"><view class="muted">按实际付款日期；分期本金单独列示。</view><view wx:for="{{trend}}" wx:key="month" class="trend-row"><text>{{item.month}}</text><view><text>订阅／分期 ¥{{item.fixed}}</text><text class="muted">分期本金 ¥{{item.principal}}</text></view></view></view></view>
  <view class="analysis-note">这些小发现来自已保存的记录，仅供你核对，不会自动改变物品状态。</view>
</view>
<cat-feedback id="cat-feedback"/>
