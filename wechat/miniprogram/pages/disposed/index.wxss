@import "../items/collection.wxss";
.archive-page { padding-bottom:calc(28px + env(safe-area-inset-bottom)); }
.archive-page .status-disposed { background:#EAF0F6; color:#4F657B; }
.archive-page .collection-kitten { width:86px; height:96px; padding:6px; box-sizing:border-box; }
.archive-page .item-daily { flex:1.3; }
.archive-page .item-days { flex:.9; }
.archive-page .metric-label { font-size:11px; }
.archive-page .archive-return { margin:18px auto 0; width:auto; min-height:44px; }
