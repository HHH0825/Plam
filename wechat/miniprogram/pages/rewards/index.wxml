<page-meta page-style="{{exchangeOpen || historyOpen || growthOpen ? 'overflow:hidden;' : ''}}"/>
<view class="rewards-page member-themed {{memberThemeClass}}" style="{{memberThemeStyle}}">

 <cat-loading wx:if="{{loading && !model}}" label="小猫正在整理喵粒…"/>
 <view wx:if="{{error}}" class="rewards-error" role="alert">{{error}}<button bindtap="load" disabled="{{busy}}">重新读取</button></view>
 <block wx:if="{{model}}">
 <view class="seed-wallet"><view><view class="wallet-label"><view class="seed-icon" aria-hidden="true"/>我的喵粒</view><view class="wallet-balance">{{model.balance}}<text>喵粒</text></view><button class="wallet-history" bindtap="history">喵粒明细 <text>›</text></button></view><image src="/assets/rewards/wallet-cat.png" mode="aspectFit" aria-hidden="true"/></view>
 <view class="rewards-card checkin-card"><view class="rewards-section-row"><text class="rewards-section-title">本周的小约定</text><text class="rewards-small">每周共50喵粒</text></view>
  <view class="weekly-note">本周已签到{{model.checkin.claimed_count}}天 · 周一重新开始</view><view class="checkin-grid"><view wx:for="{{days}}" wx:key="step" class="checkin-day {{item.claimed ? 'claimed' : ''}} {{item.today ? 'today' : ''}}"><text class="checkin-label">{{item.label}}</text><view class="checkin-token"><text wx:if="{{item.claimed}}">✓</text><view wx:else class="seed-icon"/></view><text class="checkin-reward">{{item.amount}}</text><text class="step-state">{{item.claimed ? '已领取' : item.today ? '本次可领' : '待领取'}}</text></view></view>
  <button class="rewards-primary cat-loading-button" bindtap="checkin" disabled="{{busy || model.checkin.today_claimed}}"><cat-loading wx:if="{{busy}}" paw label=""/><text>{{model.checkin.today_claimed ? '今天已经签到啦' : '今天签到，领' + model.checkin.today_reward + '喵粒'}}</text></button>
  <view class="rewards-footnote">周一开启新一周，不补签；喵粒与兑换容量不清零</view>
 </view>
 <view class="rewards-card tasks-card"><view class="rewards-section-title">每日小任务</view>
  <view class="task-row"><view class="task-icon calendar-icon" aria-hidden="true">✓</view><view class="task-copy"><view>每日签到</view><text>{{model.checkin.today_claimed ? '今日奖励已领取' : '今日可领' + model.checkin.today_reward + '喵粒'}}</text></view><button class="task-button" bindtap="checkin" disabled="{{busy || model.checkin.today_claimed}}">{{model.checkin.today_claimed ? '已签到' : '去签到'}}</button></view>
  <view class="task-row"><view class="task-icon invite-icon" aria-hidden="true">＋</view><view class="task-copy"><view>邀请新朋友</view><text>每位有效新朋友 +{{model.invitation.reward}}喵粒</text></view><button class="task-button" open-type="share" disabled="{{!inviteCode || busy}}">去邀请</button></view><view class="task-help">新朋友首次注册并保存首件物品后到账；转发本身不发奖励。</view><button wx:if="{{inviteError}}" class="invite-retry" bindtap="retryInvite">{{inviteError}}</button>
  <view class="task-row"><view class="task-icon video-icon" aria-hidden="true">▷</view><view class="task-copy"><view>看一段小广告（{{model.advertisement.used_today}}/{{model.advertisement.daily_limit}}）</view><text>每次＋{{model.advertisement.reward}}喵粒，每天最多{{model.advertisement.daily_limit}}次</text></view><button class="task-button task-unavailable" bindtap="advertisement">暂未开放</button></view>
 </view>
 <button class="growth-entry" bindtap="openGrowth" aria-label="猫爪收藏册，查看成就与领取奖励"><image src="/assets/membership/books.png" mode="aspectFit" aria-hidden="true"/><text class="growth-entry-name">猫爪收藏册</text><text wx:if="{{growthReady && growthPending}}" class="growth-entry-pending">{{growthPending}}项可领取</text><view class="growth-entry-arrow" aria-hidden="true"/></button>
 <view class="shop-heading"><view class="shop-title">喵的小铺<view class="shop-roof" aria-hidden="true"/></view><text>把一点点积攒，换成永久的小空间</text></view>
 <view class="rewards-card capacity-card"><view class="capacity-status"><view>已收藏 <text>{{model.capacity.used}}</text><text wx:if="{{!model.capacity.unlimited}}"> / {{model.capacity.free_limit}}</text><text wx:else> / 不限</text> 件</view><view class="capacity-progress"><view style="width:{{capacityPercent}}%"/></view><view class="capacity-tags">基础20件 · 永久扩容{{model.capacity.extra}}件</view></view><view class="capacity-rule">{{model.capacity.unlimited ? '会员有效期内不限件数，兑换容量到期后仍保留。' : '使用中、闲置和已处置档案计入容量，回收站不占。'}}</view>
  </view><view class="rewards-card capacity-product"><image src="/pages/rewards/assets/extra-space.png" mode="aspectFit" aria-hidden="true"/><view><view class="capacity-product-title">永久容量 +1格</view><view class="capacity-product-note">兑换后一直保留</view><view class="capacity-price">{{model.shop.next_price === null ? '已兑换全部容量' : model.shop.next_price + '喵粒'}}</view>
  <button class="rewards-primary" bindtap="openExchange" disabled="{{busy || model.shop.next_price === null}}">{{model.shop.next_price === null ? '已兑换全部容量' : '兑换1格'}}</button><view wx:if="{{model.shop.next_price !== null}}" class="capacity-next">免费容量 {{model.capacity.free_limit}} → {{model.capacity.free_limit + 1}} 件</view></view>
 </view>
 <view class="rewards-card price-card"><view class="rewards-section-title">扩容小规则</view><view class="price-table-heading"><text>累计兑换额外容量</text><text>每格喵粒</text></view><view wx:for="{{model.shop.tiers}}" wx:key="from" class="price-row {{model.capacity.extra >= item.from - 1 && model.capacity.extra < item.to ? 'current-tier' : ''}}"><text>第{{item.from}}–{{item.to}}格</text><text>{{item.price}}<text class="price-unit">喵粒／格</text></text></view><view class="rewards-footnote">每次兑换1格，最多额外兑换200格，免费容量最高220件。喵粒仅用于本小程序，不支持充值、转赠或提现。</view></view>
 <button class="member-capacity-link" bindtap="openMembership">猫爪会员有效期内，物品件数不限 <text>›</text></button>

 </block>
</view>
<view wx:if="{{exchangeOpen}}" style="{{memberThemeStyle}}" class="rewards-mask {{motionClosing === 'exchangeOpen' ? 'motion-closing' : ''}}" catchtouchmove="keepOpen"><view class="exchange-dialog" role="dialog" aria-modal="true" aria-label="确认兑换容量"><button class="dialog-close" bindtap="closeExchange" disabled="{{busy}}" aria-label="关闭兑换确认">×</button><image src="/assets/rewards/cat-box.png" mode="aspectFit"/><view class="exchange-title">给小窝添一格空间</view><view class="exchange-desc">永久容量 {{exchange.before}} → {{exchange.after}}件</view><view class="exchange-values"><text>本次使用</text><text>{{exchange.price}}喵粒</text></view><view class="exchange-values"><text>当前余额</text><text>{{exchange.balance}}喵粒</text></view><view class="exchange-values"><text>兑换后剩余</text><text>{{exchange.remaining < 0 ? '喵粒还不够' : exchange.remaining + '喵粒'}}</text></view><button class="rewards-primary cat-loading-button" bindtap="redeem" disabled="{{busy || exchange.remaining < 0}}"><cat-loading wx:if="{{busy}}" paw label=""/>{{exchange.remaining < 0 ? '再签到攒一点吧' : '确认兑换'}}</button><button class="exchange-cancel" bindtap="closeExchange" disabled="{{busy}}">再想想</button></view></view>

<cat-feedback id="cat-feedback"/>

<view wx:if="{{historyOpen}}" style="{{memberThemeStyle}}" class="rewards-mask {{motionClosing === 'historyOpen' ? 'motion-closing' : ''}}" catchtouchmove="keepOpen"><view class="exchange-dialog history-dialog" role="dialog" aria-modal="true" aria-label="喵粒明细"><button class="dialog-close" bindtap="closeHistory" aria-label="关闭喵粒明细">×</button><view class="exchange-title">喵粒明细</view><view class="rewards-footnote">最近30笔 · 北京时间</view><cat-loading wx:if="{{historyLoading}}" compact label="正在整理小收获…"/><view wx:elif="{{historyError}}" class="rewards-error">{{historyError}}<button bindtap="history">重试</button></view><scroll-view wx:else scroll-y class="history-scroll"><view wx:for="{{transactions}}" wx:key="index" class="history-row"><view><view>{{item.reason}}</view><text>{{item.date}}</text></view><text>{{item.amountText}}</text></view><view wx:if="{{!transactions.length}}" class="rewards-footnote">还没有记录，先来签到吧。</view></scroll-view></view></view>

<view wx:if="{{growthOpen}}" style="{{memberThemeStyle}}" class="rewards-mask growth-mask {{motionClosing === 'growthOpen' ? 'motion-closing' : ''}}" catchtouchmove="keepOpen">
 <view class="growth-dialog" role="dialog" aria-modal="true" aria-label="猫爪收藏册">
  <view class="growth-heading"><view><view class="growth-dialog-title">猫爪收藏册</view><view wx:if="{{growthReady}}" class="growth-summary">成长成就 · 已领取{{growthClaimed}}/14项</view><view wx:else class="growth-summary">正在整理你的成长记录</view></view><button class="growth-close" bindtap="closeGrowth" aria-label="关闭猫爪收藏册">×</button></view>
  <view class="growth-tabs"><button class="{{growthTab === 'visits' ? 'selected' : ''}}" data-tab="visits" bindtap="changeGrowth" aria-pressed="{{growthTab === 'visits'}}">常来看看</button><button class="{{growthTab === 'items' ? 'selected' : ''}}" data-tab="items" bindtap="changeGrowth" aria-pressed="{{growthTab === 'items'}}">物品收藏</button><button class="{{growthTab === 'ledger' ? 'selected' : ''}}" data-tab="ledger" bindtap="changeGrowth" aria-pressed="{{growthTab === 'ledger'}}">认真记账</button></view>
  <view class="growth-rule">{{growthTab === 'visits' ? '累计不同日期到访，从新版开始记录。' : growthTab === 'items' ? '已有有效物品计入，回收站不计入。' : '已有有效手动收支计入，自动账目与退款不计入。'}}达成后进度保留，每档可领一次。</view>

  <view wx:if="{{growthError}}" class="growth-error" role="alert"><text>{{growthError}}</text><button bindtap="refreshGrowth" disabled="{{busy || growthLoading}}">重试</button></view>
  <cat-loading wx:if="{{growthLoading}}" compact label="正在更新成长记录…"/>
  <scroll-view class="growth-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="growth-start-{{growthTab}}">
   <view class="growth-list {{motionPanelClass}}"><view id="growth-start-{{growthTab}}"/>
  <view wx:for="{{growthRows}}" wx:key="id" class="growth-row {{item.claimed ? 'growth-claimed' : ''}} {{claimedFlash === item.id ? 'growth-flash' : ''}}"><view class="growth-icon" aria-hidden="true"><image src="{{growthTab === 'visits' ? '/assets/membership/cat.png' : growthTab === 'items' ? '/assets/membership/books.png' : '/assets/membership/budget.png'}}" mode="aspectFit"/></view><view class="growth-copy"><view class="growth-title">{{growthTab === 'visits' ? '来看看' : growthTab === 'items' ? '收好' : '记下'}}{{item.target}}{{item.unit}}<text>＋{{item.reward}}喵粒</text></view><view class="growth-progress"><view style="width:{{item.percent}}%"/></view><view class="growth-count">{{item.progress >= item.target ? item.target : item.progress}} / {{item.target}}{{item.unit}}</view></view><button class="growth-claim cat-loading-button" data-id="{{item.id}}" bindtap="claimGrowth" disabled="{{busy || growthLoading || item.claimed || !item.achieved}}"><cat-loading wx:if="{{claiming === item.id}}" paw label=""/>{{item.claimed ? '已领取' : item.achieved ? '领取' : '未达成'}}</button></view>
   <view wx:if="{{!growthRows.length && !growthLoading}}" class="growth-empty">{{growthError ? '请重试读取成长记录' : '收藏册暂未准备好，请重试'}}<button bindtap="refreshGrowth" disabled="{{busy}}">重新读取</button></view>
   </view>
  </scroll-view>
 </view>
</view>

<include src="../../templates/session-status.wxml"/>
