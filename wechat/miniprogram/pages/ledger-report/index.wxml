<view class="member-themed {{memberThemeClass}} page ledger-page cash-report-page" style="{{memberThemeStyle}}">
 <view class="cash-report-controls"><picker mode="date" fields="month" value="{{month}}" start="0001-01" end="{{maxMonth}}" bindchange="monthChange" aria-label="选择小报月份"><view>{{month}}⌄</view></picker><button class="ledger-text-button" bindtap="load" disabled="{{loading || imageBusy}}">重新读取</button></view>
 <view wx:if="{{loading}}" class="ledger-empty"><cat-loading label="正在整理收支小报…"/></view><view wx:if="{{error}}" class="ledger-error" role="alert">{{error}}<button class="ledger-text-button" bindtap="load">重试</button></view>
 <view wx:if="{{reportLayout}}" class="cash-report-paper cash-report-exact" style="width:{{reportLayout.width}}px;height:{{reportLayout.height}}px" aria-label="猫爪收支小报">
  <block wx:for="{{reportLayout.nodes}}" wx:key="id"><image wx:if="{{item.kind === 'image'}}" class="cash-report-node" src="{{item.src}}" style="{{item.style}}" aria-hidden="true"/><view wx:elif="{{item.kind === 'ring'}}" class="cash-report-node" style="{{item.style}}"><cash-donut class="cash-report-ring" rows="{{item.rows}}" size="{{item.size}}" plain="{{true}}"/></view><text wx:elif="{{item.kind === 'text'}}" class="cash-report-node cash-report-dynamic" style="{{item.style}}">{{item.text}}</text><view wx:else class="cash-report-node" style="{{item.style}}" aria-hidden="true"/></block><text class="cash-report-accessible">猫爪收支小报；这个月，钱花在哪里；生活的小脚印。</text>
 </view>
 <view wx:if="{{cashAnalysis}}" class="cash-report-actions"><view class="cash-report-privacy"><text>分享金额</text><switch checked="{{showAmounts}}" disabled="{{imageBusy}}" color="#F3CE55" bindchange="toggleAmounts" aria-label="分享金额，关闭后隐藏所有金额"/></view><view class="cash-report-action-row"><button class="ledger-secondary" bindtap="saveImage" disabled="{{loading || imageBusy}}">{{imageBusy ? '正在生成…' : '保存图片'}}</button><button class="ledger-primary" bindtap="shareImage" disabled="{{loading || imageBusy}}">分享小报</button></view><button class="ledger-text-button" bindtap="preview" disabled="{{imageBusy}}">预览导出图片</button><button wx:if="{{shareFallback}}" class="ledger-secondary" open-type="share">使用小程序卡片分享</button><view wx:if="{{imageError}}" class="ledger-error">{{imageError}}</view></view>
 <canvas id="cash-report-canvas" type="2d" class="cash-report-export" aria-hidden="true"/>
</view>

<cat-feedback id="cat-feedback"/>

<include src="../../templates/session-status.wxml"/>
