@import "../../styles/ledger.wxss";
@import "../../styles/cash-analysis.wxss";
.cash-report-page{padding-bottom:calc(24px + env(safe-area-inset-bottom))}.cash-report-controls{display:flex;align-items:center;justify-content:space-between;min-height:44px;font-size:14px}.cash-report-controls picker{min-height:44px;display:flex;align-items:center}.cash-report-paper{position:relative;min-width:0;background:#FFFCF0;border:1px solid #8B7C62;border-radius:17px 20px 14px 18px;padding:22px 14px;text-align:center;box-shadow:2px 3px 0 #F0E6CF}.cash-report-title{position:relative;font-size:27px;font-weight:700;padding-right:30px;line-height:1.6}.cash-report-month{font-size:18px;font-weight:650;line-height:1.8}.cash-report-cat{position:absolute;right:6px;top:2px;width:48px;height:48px;pointer-events:none;opacity:.8}.cash-report-hero{background:#FFF2BE;border-radius:25px;margin:19px 0 12px;padding:13px 8px;font-size:14px;line-height:1.7}.cash-report-hero scroll-view{width:100%;font-size:30px;font-weight:700}.cash-report-totals{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;font-size:12px;line-height:1.7}.cash-report-totals>view{min-width:0}.cash-report-totals scroll-view{font-size:18px;font-weight:650;width:100%}.cash-report-paper .ledger-card{background:transparent;border:0;border-top:1px dashed #E2CD8C;border-radius:0;margin:16px 0 0;padding:14px 0 0;text-align:left}.cash-report-footer{font-size:10px;color:#888175;line-height:1.7;margin-top:20px}.cash-report-actions{margin-top:14px}.cash-report-privacy{display:flex;align-items:center;justify-content:center;gap:10px;min-height:44px;font-size:13px}.cash-report-action-row{display:flex;gap:12px;margin-top:10px}.cash-report-action-row>button{flex:1;min-width:0;width:0!important;min-height:48px;margin:0}.cash-report-actions>.ledger-text-button{width:100%!important;min-height:44px}.cash-report-export{position:fixed;left:-10000px;top:0;width:720px;height:1200px;pointer-events:none}@media(max-width:350px){.cash-report-title{font-size:23px}.cash-report-totals{grid-template-columns:minmax(0,1fr);gap:8px}.cash-report-totals>view{display:flex;align-items:center;gap:10px}.cash-report-totals scroll-view{flex:1;min-width:0;text-align:right}}
.cash-report-paper.cash-report-exact{box-sizing:content-box;position:relative;padding:0;border:0;border-radius:0;background:#FFFCF2;box-shadow:none;text-align:left;max-width:none;overflow:visible}.cash-report-node{position:absolute;box-sizing:border-box;pointer-events:none}.cash-report-dynamic{font-family:sans-serif;font-variant-numeric:normal;overflow:visible}.cash-report-page{padding-left:18px;padding-right:18px}
.cash-report-accessible{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}

