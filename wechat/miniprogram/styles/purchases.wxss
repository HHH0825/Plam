.purchase-page{max-width:520px;margin:0 auto;box-sizing:border-box;padding:18px 18px 40px;background:transparent;color:#292929}.purchase-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:6px 0 20px}.purchase-heading .title{font-size:26px;font-weight:750}.purchase-heading .button{font-size:14px;min-width:96px;margin:0;flex:none;padding:0 14px}.purchase-heading .muted{margin-top:8px}.purchase-page .card{border:1px solid #dedbd9;border-radius:20px;padding:16px;margin-bottom:12px;box-shadow:0 3px 0 #fff8d8}.purchase-page .row{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.row-title{font-size:18px;font-weight:700;overflow-wrap:anywhere}.purchase-page .field{margin:18px 0}.purchase-page .field>text{display:block;font-size:13px;color:#707070;margin-bottom:8px}.purchase-page input,.purchase-page textarea,.picker-value{box-sizing:border-box;background:#f7f7f7;border-radius:12px;padding:12px;width:100%;min-height:46px;font-size:15px;color:#292929}.purchase-page textarea{min-height:88px}.purchase-page .actions{display:flex;gap:10px;flex-wrap:wrap}.purchase-page .actions .button{flex:1;min-width:105px}.purchase-page .button{font-size:15px;min-height:46px;line-height:46px;margin-top:8px;white-space:normal}.purchase-page .text-button{background:transparent;border:0;font-size:14px;line-height:44px;min-height:44px;padding:0 8px;color:#755700;display:inline-block;margin:0}.purchase-page .text-button::after{border:0}.purchase-page .danger{color:#b54b61}.list-filter{display:inline-block;min-height:44px;line-height:44px;border-radius:14px;padding:0 16px;background:#fff6cc;margin-bottom:12px;font-size:14px}.wish-price,.expense-amount{font-size:21px;font-weight:750;margin:12px 0;color:#494139;overflow-wrap:anywhere}.wish-reason{font-size:14px;line-height:1.7;margin-bottom:12px;white-space:pre-wrap;overflow-wrap:anywhere}.wish-considering{background:#fff2ad;color:#685018}.wish-declined{background:#f0edf8;color:#766887}.wish-purchased{background:#fce4ed;color:#93435f}.similar-row{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid #eee;min-height:52px}.similar-row image{width:52px;height:52px;border-radius:12px;background:#f7f7f7;flex:none}.similar-row>view{flex:1;min-width:0}.similar-row text{display:block}.expense-reminder{padding:8px 10px;border-radius:12px;background:#fff5c8;font-size:13px;line-height:1.6;margin:8px 0;overflow-wrap:anywhere}.expense-reminder.urgent{background:#fce4ed;color:#93435f}.expense-meta{font-size:13px;color:#707070;line-height:1.9;overflow-wrap:anywhere}.expense-totals{font-size:14px;line-height:1.9;background:#fff9df}.payment-row{padding:14px 0;border-top:1px solid #eee}.payment-void{opacity:.55}.purchase-page .empty{padding:36px 8px}.purchase-page .muted{color:#707070}.purchase-page .small{font-size:12px;line-height:1.6}.purchase-page .section-title{font-size:18px;font-weight:700}.purchase-actions .button{display:block;width:100%}.purchase-page .error{margin:12px 0;overflow-wrap:anywhere}@media(max-width:350px){.purchase-heading{flex-wrap:wrap}.purchase-page{padding-left:14px;padding-right:14px}.row-title{font-size:17px}}

.subscription-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 0 16px}.subscription-toolbar .list-filter{margin:0;white-space:nowrap}.subscription-add{margin:0;min-height:44px;padding:0 14px;font-size:14px;line-height:1.4;display:flex;align-items:center;justify-content:center}.subscription-error,.association-warning{padding:14px;border-radius:16px;background:#fff8e3;line-height:1.6;font-size:14px}.association-warning{margin-bottom:12px;color:#74603e}.subscription-error .text-button,.association-warning .text-button{display:block;margin:4px 0 0;text-align:left;min-height:44px}.subscription-add[disabled]{opacity:.5}@media(max-width:350px){.subscription-toolbar{gap:6px}.subscription-add{padding:0 10px;font-size:13px}}

/* Native status pickers use a quiet illustrated pill without a dropdown arrow. */
.status-filter-picker { display:block; flex:none; max-width:100%; }
.status-filter-picker .list-filter { display:inline-flex; align-items:center; gap:8px; min-height:44px; box-sizing:border-box; max-width:100%; padding:10px 14px; line-height:1.5; border-radius:16px; color:#544727; font-weight:500; }
.status-filter-icon { display:block; width:20px; height:20px; flex:none; pointer-events:none; }
.subscription-toolbar { flex-wrap:wrap; }
.purchase-page .subscription-add{width:auto;min-width:0;flex:none;margin:0;min-height:44px;line-height:1.4;padding:10px 12px;font-size:14px}.purchase-page .actions .button{line-height:1.4;padding:10px 12px;overflow-wrap:anywhere}.purchase-page .subscription-error .text-button,.purchase-page .association-warning .text-button{width:auto;min-width:0;background:transparent}
