.cover-choices{display:flex;gap:10px;margin-top:14px}.editor-page .cover-choices .button{flex:1;min-width:0;min-height:44px;width:auto;margin:0;padding:10px 8px;font-size:14px;line-height:24px;border:1px solid #eaeaea;border-radius:12px;background:#fff}.editor-page .cover-choices .icon-choice{background:#fff6cf;border-color:#f5e8ac}.photo-placeholder .cover-art{width:58px;height:58px}.cover-replace-note{font-size:12px;line-height:1.7;margin-top:10px;color:#93435f}.cover-recheck{display:inline-block;min-height:44px;line-height:44px;font-size:12px;margin:0;padding:0 8px;background:transparent;color:#866b20}.cover-recheck::after{border:0}
.cover-overlay{position:fixed;inset:0;z-index:120;display:flex;align-items:flex-end;justify-content:center}.cover-mask{position:absolute;inset:0;background:rgba(41,41,41,.3)}.cover-sheet{position:relative;display:flex;flex-direction:column;width:100%;max-width:540px;height:82vh;max-height:780px;background:#fff;border-radius:24px 24px 0 0;box-sizing:border-box;padding:18px 18px 0;box-shadow:0 -5px 30px rgba(41,41,41,.08)}.cover-sheet-heading{display:flex;align-items:center;justify-content:space-between;gap:12px}.cover-close{flex:none;width:44px;min-height:44px;font-size:30px;line-height:44px;padding:0;margin:0;color:#707070;background:transparent}.cover-close::after,.cover-option::after,.cover-group::after{border:0}.cover-search{height:44px;min-height:44px;box-sizing:border-box;padding:10px 14px;border:1px solid #eaeaea;border-radius:12px;margin-top:14px;font-size:14px;background:#fafafa}.cover-group-scroll{overflow-x:auto;flex:none;white-space:nowrap;margin:10px 0;width:100%;height:48px}.cover-groups{display:flex;gap:6px;min-width:max-content}.cover-group{flex:none;display:inline-block;min-height:44px;line-height:24px;box-sizing:border-box;margin:0;padding:10px 12px;border-radius:14px;background:transparent;color:#707070;font-size:13px}.cover-group.selected{background:#fff5c5;color:#5c4b1b;font-weight:600}.cover-grid-scroll{overflow-y:auto;flex:1;min-height:0;height:0}.cover-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;padding:4px 0 16px}.cover-option{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;min-width:0;min-height:98px;box-sizing:border-box;padding:10px 4px;margin:0;border:1px solid #efefef;border-radius:15px;color:#494641;background:#fff;font-size:12px;line-height:1.5;white-space:normal;overflow-wrap:anywhere}.cover-option image,.cover-grid-fallback{width:56px;height:56px;flex:none}.cover-grid-fallback{line-height:56px;font-size:28px;color:#777;text-align:center}.cover-option.selected{border-color:#dfc34d;background:#fff9df}.cover-check{position:absolute;right:5px;top:2px;color:#8c7221;font-weight:600}.cover-sheet-footer{flex:none;padding:12px 0 calc(12px + env(safe-area-inset-bottom));border-top:1px solid #f0f0f0;background:#fff}.cover-sheet-footer .button{min-height:48px;width:100%;margin:0;line-height:26px;padding:11px 12px;font-size:15px;background:#ffe15a;color:#292929;border-radius:16px}.cover-empty{padding:30px 0;color:#777;text-align:center;font-size:14px}
@media(max-width:350px){.cover-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.cover-sheet{padding-left:14px;padding-right:14px}}
.cover-sheet .cover-group{width:auto;min-width:44px}.cover-option{width:100%;max-width:100%}

/* Anchor to the sheet, not the native button's default layout. */
.cover-sheet-heading{padding-right:50px;min-height:44px;flex:none}
.cover-sheet .cover-close{position:absolute;top:12px;right:12px;width:44px;min-width:44px;max-width:44px;height:44px;min-height:44px;max-height:44px;margin:0;padding:0;display:flex;align-items:center;justify-content:center;border:0;box-sizing:border-box}
.cover-close-mark{position:relative;width:22px;height:22px;pointer-events:none}
.cover-close-mark::before,.cover-close-mark::after{content:'';position:absolute;left:1px;top:10px;width:20px;height:2px;border-radius:2px;background:#707070;transform:rotate(45deg)}
.cover-close-mark::after{transform:rotate(-45deg)}
.cover-sheet .cover-feedback{display:flex;justify-content:center;align-items:center;gap:5px;width:100%;max-width:100%;min-height:44px;box-sizing:border-box;padding:8px 0;margin:4px 0 0;font-size:13px;line-height:1.5;background:transparent;color:#866b20;white-space:normal}
.cover-feedback::after{border:0}.cover-feedback-help{font-size:11px;color:#707070;line-height:1.5;text-align:center}
.cover-sheet-footer{padding-top:10px;flex-shrink:0}.cover-search{flex:none}
.cover-search{padding:0 14px;line-height:44px}
