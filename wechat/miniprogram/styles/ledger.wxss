ist{max-height:45vh;overflow-y:auto}.ledger-bottom-paw{width:26px;height:26px;margin-right:8px;pointer-events:none}.ledger-break{overflow-wrap:anywhere}
@media(max-width:350px){.ledger-page{padding-left:14px;padding-right:14px}.ledger-summary{padding:14px}.ledger-title{font-size:28px}.ledger-money-main{font-size:30px}.ledger-money-small{font-size:18px}.ledger-summary-bottom{flex-direction:column;gap:8px}.ledger-summary-cell+.ledger-summary-cell{border-left:0;padding-left:0}.ledger-row{flex-wrap:wrap}.ledger-row-amount{margin-left:auto}.ledger-field{align-items:flex-start}.ledger-form-amount{font-size:34px}.ledger-categories{gap:6px}}

.ledger-detail-link{width:100%;margin:0;text-align:left;background:transparent;border-radius:0;font-weight:400}.ledger-rank .ledger-section-row{flex-wrap:wrap;gap:6px}.ledger-rank .ledger-nowrap{max-width:100%;overflow-x:auto}.ledger-detail-money{display:inline-block;white-space:nowrap}.ledger-row-amount{min-width:0;max-width:55%;overflow-x:auto}

.ledger-categories{display:flex;flex-wrap:wrap;gap:8px}.ledger-category{flex:0 0 calc(25% - 6px);width:calc(25% - 6px)!important;max-width:calc(25% - 6px);min-width:0;margin:0!important}.ledger-field-label{flex:none;white-space:nowrap}.ledger-field .ledger-field-value{min-width:0;max-width:none;flex:1;text-align:right}

/* WeChat default button:not([size=mini]) width must be overridden explicitly. */
.ledger-primary,.ledger-secondary,.ledger-row,.ledger-detail-link{width:100%!important;max-width:100%;min-width:0}.ledger-check{width:44px!important;min-width:44px;max-width:44px}.ledger-month-arrow{width:44px!important;max-width:44px;flex:0 0 44px}.ledger-filter,.ledger-text-button{width:auto!important}.ledger-segments button,.ledger-history-modes button{width:0!important;min-width:0}.ledger-history-modes button{min-width:64px}

/* Server creation time stays independent of the editable cash-flow date. */
.ledger-recorded-time{display:flex;flex-wrap:wrap;align-items:baseline;column-gap:4px;row-gap:0;margin-top:2px;font-size:11px;font-weight:400;color:#96948C;line-height:1.6;text-align:left;min-width:0;white-space:normal}
.ledger-time-part{display:inline-block;white-space:nowrap;word-break:keep-all;overflow-wrap:normal;flex:none}
.ledger-field-label{flex:none}.ledger-time-value{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:0 6px;max-width:70%;min-width:0;text-align:right}.ledger-time-value text{max-width:100%}.ledger-refund-copy{flex:1;min-width:0}.ledger-refund-copy+.ledger-nowrap{flex:none}
