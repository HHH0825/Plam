.ledger-page{position:relative;padding-top:24px;min-height:100vh;background:linear-gradient(180deg,rgba(255,247,224,.9),rgba(255,247,224,0) 370px);color:#30302E;box-sizing:border-box}.ledger-tab{padding-bottom:calc(118px + env(safe-area-inset-bottom))}.ledger-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;gap:12px}.ledger-title{font-size:32px;font-weight:700;line-height:1.4}.ledger-heading-paw{width:36px;height:36px;flex:none;pointer-events:none}.ledger-muted{font-size:14px;color:#85847E;line-height:1.7;overflow-wrap:anywhere}.ledger-small{font-size:12px}.ledger-card{background:white;border:1px solid #E9E7E2;border-radius:20px;padding:18px;margin:16px 0}.ledger-empty{text-align:center;padding:26px 16px;line-height:1.8;color:#777}.ledger-gate-art{width:120px;height:110px;display:block;margin:0 auto 12px}.ledger-section{font-size:18px;font-weight:650;line-height:1.5}.ledger-section-row{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:14px 0 8px}.ledger-error{background:#FFF0F3;color:#80515F;padding:12px;border-radius:12px;line-height:1.7;margin:12px 0;overflow-wrap:anywhere}.ledger-page button,.ledger-sheet button{box-sizing:border-box;margin:0;font-weight:400;line-height:1.5}.ledger-page button::after,.ledger-sheet button::after{border:0}.ledger-primary,.ledger-secondary{display:flex;align-items:center;justify-content:center;width:100%;min-height:48px;padding:12px 16px;border-radius:18px;margin-top:16px!important;font-size:16px;background:#FFE365;color:#292929;font-weight:650!important}.ledger-secondary{background:#FFF4F6;border:1px solid #F0CED7}.ledger-primary[disabled],.ledger-secondary[disabled]{opacity:.55}.ledger-text-button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;background:transparent;color:#8A7337;font-size:12px;padding:8px 2px;max-width:100%;white-space:normal}.ledger-month{display:flex;align-items:center;background:#FFF;border:1px sol