px}.ledger-filter-summary{background:#FFF7DF;padding:10px;border-radius:12px;font-size:12px;color:#7A632F;line-height:1.8}.ledger-mask{position:fixed;inset:0;background:rgba(0,0,0,.28);z-index:150;display:flex;align-items:flex-end;justify-content:center}.ledger-sheet{box-sizing:border-box;width:100%;max-width:480px;max-height:85vh;overflow-y:auto;border-radius:24px 24px 0 0;background:#FFF;padding:18px 18px calc(18px + env(safe-area-inset-bottom));position:relative}.ledger-close{width:44px!important;min-width:44px;max-width:44px;min-height:44px;background:transparent;font-size:28px;padding:0}.ledger-field{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:54px;line-height:1.6;border-bottom:1px solid #EEE;font-size:14px;padding:8px 0;box-sizing:border-box}.ledger-field text{overflow-wrap:anywhere;max-width:70%}.ledger-segments{display:flex;background:#FFF;border:1px solid #EEE;border-radius:18px;margin-bottom:18px;overflow:hidden}.ledger-segments button{flex:1;width:0;min-height:48px;border-radius:16px;font-size:16px;background:transparent;padding:10px}.ledger-segments .selected{background:#FFE365;font-weight:600}.ledger-trend-scroll{width:100%;margin:18px 0}.ledger-trend{display:flex;gap:7px;width:max-content;min-width:100%}.ledger-trend-day{width:23px;flex:none;font-size:10px;color:#888;text-align:center}.ledger-bars{height:92px;display:flex;align-items:flex-end;gap:2px;padding-bottom:5px}.ledger-bar{width:9px;min-height:1px;border-radius:4px 4px 0 0}.ledger-bar.expense{background:#F4CE63}.ledger-bar.income{background:#F4B3C9}.ledger-rank{margin-top:18px;font-size:14px}.ledger-rank-track{height:6px;background:#F1F0EB;border-radius:8px;overflow:hidden;margin:8px 0}.ledger-rank-track view{height:100%;background:#F4CE63;border-radius:8px}.ledger-form-amount{font-size:40px;font-weight:650;display:flex;align-items:center;gap:6px;min-width:0}.ledger-form-amount input{flex:1;min-width:0;height:66px;font-size:inherit}.ledger-categories{displa