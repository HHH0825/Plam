/* Independent corner/edge art grows with content without scaling the illustration. */
.ledger-home .ledger-journal-panel{margin:0 -10px 14px;padding:20px 24px 22px 26px;background:#FFF7D8;border:0;border-radius:16px;box-shadow:2px 4px 0 rgba(163,135,62,.10)}
.ledger-drawn-frame{position:absolute;inset:0;pointer-events:none}
.book-corner{position:absolute;width:22px;height:22px;pointer-events:none}
.corner-tl{left:0;top:0}.corner-tr{right:0;top:0}.corner-bl{left:0;bottom:0}.corner-br{right:0;bottom:0}
.book-edge{position:absolute;pointer-events:none;background-repeat:repeat}
.edge-top,.edge-bottom{left:22px;right:22px;height:7px;background-image:none;background-size:60px 7px}
.edge-top{top:0}.edge-bottom{bottom:0}.edge-left,.edge-right{top:22px;bottom:22px;width:7px;background-image:none;background-size:7px 60px}
.edge-left{left:0}.edge-right{right:0}
.ledger-home .ledger-book-spine{left:-9px;top:47px;bottom:37px;width:24px}
.ledger-book-spine>image{width:24px;height:17px;pointer-events:none}
.ledger-home .ledger-book-fold{right:0;top:0;width:27px;height:27px;border:0;background:none;border-radius:0}
.ledger-home .ledger-panel-month{justify-content:flex-start;padding:0 29px 0 0;gap:8px;flex-wrap:nowrap}
.ledger-home .ledger-panel-month-label{font-size:19px;gap:7px}
.ledger-home .ledger-book-month-actions{gap:5px}
.ledger-home .ledger-month-arrow{background:#FFFDF5!important;border:1px solid #E5DCC3!important;width:44px!important;height:44px}
.ledger-home .ledger-month-arrow[disabled]{background:rgba(255,255,255,.65)!important;border:1px solid #E5DCC3!important}
.ledger-home .ledger-panel-info{top:19px;right:11px}
.ledger-home .ledger-panel-main{padding:18px 0 0}
.ledger-home .ledger-panel-label{font-size:14px;color:#625B4E}
.ledger-home .ledger-money-main{font-size:44px;line-height:1.35;margin:7px 0 3px;overflow:visible}
.ledger-home .ledger-book-main-number{display:inline-block;padding-bottom:9px;line-height:1.2}
.ledger-home .ledger-book-main-number::after{bottom:-1px;height:12px;border-radius:0;background:transparent  center/100% 100% no-repeat;transform:none}
.ledger-home .ledger-panel-paw{top:89px;right:25px;width:48px;height:43px;opacity:1}
.ledger-home .ledger-panel-refund{margin-top:7px;font-size:11px;color:#8D8270}
.ledger-home .ledger-summary-bottom{margin-top:19px;gap:12px}
.ledger-home .ledger-summary-cell{padding:11px 10px!important;background:#FFFEF8;border:1px solid #EEE4CE;border-radius:13px;box-shadow:1px 2px 3px rgba(134,111,54,.08);min-height:84px}
.ledger-summary-caption{display:flex;align-items:center;gap:6px;min-height:25px;margin-bottom:5px}
.ledger-summary-caption>image{width:24px;height:24px;flex:none;pointer-events:none}
.ledger-summary-caption .ledger-panel-label{font-size:13px}
.ledger-home .ledger-money-small{line-height:1.4;font-weight:700}
.ledger-statistics .ledger-calendar{border-color:#9A8970;box-shadow:1px 3px 4px rgba(113,92,39,.14)}
.calendar-binding{width:10px;height:25px;border:1.3px solid #876A3F;background:#FFE39A;box-shadow:1px 1px 0 #C4AA74}
.me-page .overview-shell{padding:14px 13px 17px;border-radius:19px}
.me-page .overview-section-label{font-size:15px;padding:0 1px;font-weight:600;line-height:1.5}
.me-page .overview-card{padding:14px 0 17px;min-height:91px}
.me-page .overview-cell+.overview-cell{border-color:rgba(204,192,163,.4)}
.me-page .overview-label{font-size:11px;margin-top:5px}
.me-page .overview-amount-hint{font-size:9px;color:#9B844C;margin-top:2px}
.me-page .me-cash-section{margin:0;border-color:rgba(204,192,163,.4);padding-top:3px}
.me-page .me-cash-title{font-size:15px;font-weight:600;min-height:44px;padding:6px 1px 5px}
.me-page .me-cash-title>text:last-child{color:#8B7A54;margin-right:2px}
.me-page .me-cash-grid{gap:0;padding:4px 0 0}
.me-cash-grid>view{padding:0 6px;box-sizing:border-box}
.me-cash-grid>view+view{border-left:1px solid rgba(204,192,163,.4)}
.me-cash-grid.stacked>view+view{border-left:0;border-top:1px solid rgba(204,192,163,.25);padding-top:8px}
@media(max-width:350px){.ledger-home .ledger-journal-panel{margin-left:-5px;margin-right:-5px;padding-left:20px;padding-right:18px}.ledger-home .ledger-panel-month{gap:0}.ledger-home .ledger-panel-month-label{font-size:16px}.ledger-home .ledger-book-month-actions{gap:0}.ledger-home .ledger-panel-paw{right:18px;width:42px}.ledger-home .ledger-summary-cell{padding:10px 8px!important}.ledger-summary-caption{gap:3px}.ledger-summary-caption .ledger-panel-label{font-size:12px}.ledger-summary-caption>image{width:21px;height:21px}}
.ledger-home .ledger-book-main-number{padding-bottom:6px}

.ledger-home .ledger-journal-panel{padding-top:17px;padding-bottom:17px}.ledger-home .ledger-panel-month{justify-content:space-between;padding-right:24px}.ledger-home .ledger-panel-main{padding-top:10px}.ledger-home .ledger-summary-bottom{margin-top:28px}.ledger-home .ledger-book-spine{top:38px;bottom:auto;height:160px;display:block}.ledger-book-spine>image{position:absolute;left:0}.ledger-book-spine>image:nth-child(1){top:0}.ledger-book-spine>image:nth-child(2){top:56px}.ledger-book-spine>image:nth-child(3){top:137px}.ledger-home .ledger-panel-paw{top:102px;right:43px}@media(max-width:350px){.ledger-home .ledger-panel-month{padding-right:24px}.ledger-home .ledger-panel-paw{right:25px}}
.me-page .overview-shell{margin-left:-7px;margin-right:-7px;padding-top:10px;padding-bottom:10px}.me-page .overview-card{padding-top:6px;padding-bottom:6px;min-height:80px}.me-page .me-cash-grid{padding-top:1px}.me-cash-grid scroll-view{line-height:1.4}.me-cash-grid .overview-label{margin-top:4px}

.edge-top,.edge-bottom{background-image:url("data:image/png;base64,")}.edge-left,.edge-right{background-image:url("data:image/png;base64,")}.ledger-home .ledger-book-main-number::after{background-image:url("data:image/png;base64,")}
