/* Scoped to the two cash tabs; forms and the item analysis retain their layout. */
.ledger-home,.ledger-statistics{padding-top:12px}
.ledger-journal-panel{position:relative;background:#FFF8DF;border:1px solid #7D786C;border-radius:24px 21px 23px 20px;padding:8px 16px 14px;margin:0 0 14px;box-shadow:0 2px 0 rgba(180,158,90,.04)}
.ledger-panel-month,.calendar-month{display:flex;align-items:center;justify-content:center;gap:0;min-height:44px;padding:0 27px}
.ledger-panel-month-label{position:relative;display:flex;align-items:center;justify-content:center;gap:8px;min-height:44px;box-sizing:border-box;font-size:16px;font-weight:650;white-space:nowrap;line-height:1.5;padding:9px 2px}
.ledger-panel-month-label::after{content:"";position:absolute;left:4px;right:16px;bottom:4px;height:3px;background:#F6D667;border-radius:50%;transform:rotate(-1deg);pointer-events:none}
.ledger-caret,.ledger-month-chevron{display:block;box-sizing:border-box;width:8px;height:8px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;border-radius:1px;flex:none;pointer-events:none}
.ledger-caret{transform:rotate(45deg);margin-top:-4px;color:#66665D}
.ledger-month-chevron.previous{transform:rotate(135deg);margin-left:4px}
.ledger-month-chevron.next{transform:rotate(-45deg);margin-right:4px}
.ledger-home .ledger-month-arrow,.ledger-statistics .ledger-month-arrow{width:44px!important;min-width:44px;max-width:44px;height:44px;min-height:44px;padding:0!important;border:0!important;border-radius:50%;background:transparent!important;box-shadow:none!important;color:#56564E;line-height:1;flex:0 0 44px}
.ledger-home .ledger-month-arrow[disabled],.ledger-statistics .ledger-month-arrow[disabled]{background:transparent!important;color:#B8B6AA!important;opacity:1}
.ledger-home .ledger-month-arrow.ledger-month-hover,.ledger-statistics .ledger-month-arrow.ledger-month-hover{background:rgba(244,206,99,.12)!important}
.ledger-panel-info{position:absolute;top:6px;right:3px;width:44px!important;max-width:44px;min-width:44px;height:44px;display:flex;align-items:center;justify-content:center;background:transparent;padding:0;font-size:14px;font-weight:650!important}
.ledger-panel-info::before{content:"";position:absolute;width:16px;height:16px;border:1px solid #66645B;border-radius:50%;pointer-events:none}
.ledger-panel-paw{position:absolute;right:15px;top:54px;width:21px;height:21px;opacity:.8;pointer-events:none}
.ledger-panel-main{text-align:center;padding:10px 0 2px}
.ledger-panel-label{font-size:13px;color:#706D61;line-height:1.6}
.ledger-journal-panel .ledger-money-main{font-size:32px;font-weight:700;line-height:1.55;margin:2px 0}
.ledger-panel-refund{font-size:11px;color:#777368;line-height:1.6;margin-top:2px}
.ledger-journal-panel .ledger-summary-bottom{margin-top:12px;padding-top:10px;gap:12px;text-align:center;border-color:#E4DCC0}
.ledger-journal-panel .ledger-summary-cell+.ledger-summary-cell{border-color:#E4DCC0}
.ledger-journal-panel .ledger-money-small{font-size:20px;line-height:1.6}
.ledger-summary-bottom.panel-stacked{flex-direction:column;gap:8px}
.ledger-summary-bottom.panel-stacked .ledger-summary-cell+.ledger-summary-cell{border-left:0;padding-left:0}
.ledger-measure-probes{position:fixed;left:-100000px;top:0;white-space:nowrap;visibility:hidden;pointer-events:none;height:1px;overflow:visible}
.ledger-panel-probe,.calendar-digit-probe,.calendar-prefix-probe,.calendar-unit-probe{display:inline-block;white-space:nowrap;line-height:1.5}
.calendar-digit-probe,.calendar-unit-probe{font-size:10px}.calendar-prefix-probe{font-size:9px}
.ledger-flow-toolbar{display:flex;align-items:center;justify-content:space-between;min-height:48px;margin:0 0 2px;gap:8px}
.ledger-flow-actions{display:flex;gap:8px;flex:none}
.ledger-icon-button{position:relative;display:flex;align-items:center;justify-content:center;background:white;border:1px solid #E7E6E1;width:44px!important;min-width:44px;max-width:44px;height:44px;padding:0;border-radius:50%}
.ledger-icon-button.is-active{background:#FFF4CA;border-color:#E6D486}
.ledger-search-mark{position:relative;width:14px;height:14px;border:1.5px solid #555650;border-radius:50%;box-sizing:border-box;margin:-3px 3px 0 0;pointer-events:none}
.ledger-search-mark::after{content:"";position:absolute;right:-5px;bottom:-3px;width:7px;height:1.5px;background:#555650;transform:rotate(45deg);border-radius:2px}
.ledger-filter-mark{width:18px;pointer-events:none}
.ledger-filter-mark view{position:relative;height:1px;background:#555650;margin:4px 0}
.ledger-filter-mark view::after{content:"";position:absolute;width:4px;height:4px;top:-2px;left:4px;border-radius:50%;background:#555650}
.ledger-filter-mark view:nth-child(2)::after{left:11px}
.ledger-filter-count{position:absolute;right:-2px;top:-2px;min-width:15px;height:15px;border-radius:50%;background:#F3D36D;color:#51431F;font-size:10px;line-height:15px;text-align:center}
.ledger-inline-search{display:flex;align-items:center;padding:0 4px 0 12px;margin:8px 0}
.ledger-inline-search input{flex:1;min-width:0;min-height:44px}
.ledger-search-close{display:flex;align-items:center;justify-content:center;width:44px!important;max-width:44px;min-width:44px;height:44px;padding:0;background:transparent;font-size:23px;color:#888}
.ledger-query-chip{display:flex;align-items:center;justify-content:space-between;gap:8px;width:auto!important;max-width:100%;min-height:44px;padding:8px 12px;background:#FFF6DB;border-radius:14px;font-size:12px;overflow-wrap:anywhere;text-align:left}
.ledger-day-heading{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:4px 8px;background:#F8F7F4;padding:6px 8px;color:#73746E;font-size:11px;line-height:1.6}
.ledger-day-heading>text{flex:none}
.ledger-day-totals{min-width:0;text-align:right;overflow-wrap:anywhere}
.ledger-home .ledger-day{margin-top:8px}
.ledger-home .ledger-row{min-height:66px;padding:10px 0!important}
.ledger-history-entry{text-align:center;margin:6px 0 0}
.ledger-home .ledger-footnote{text-align:center;margin-top:0}
.ledger-statistics .ledger-segments{max-width:250px;margin:0 auto 22px}
.ledger-calendar{position:relative;background:#FFF;border:1px solid #7D7C75;border-radius:21px 19px 20px 18px;padding:8px 8px 10px;margin-top:8px;box-sizing:border-box}
.calendar-binding{position:absolute;width:10px;height:24px;top:-10px;background:#FFE897;border:1px solid #706E64;border-radius:7px;transform:rotate(4deg);box-shadow:1px 1px 0 rgba(0,0,0,.08);pointer-events:none;z-index:1}
.calendar-binding.binding-left{left:30px;transform:rotate(-4deg)}
.calendar-binding.binding-right{right:30px}
.calendar-header-paw{position:absolute;right:9px;top:14px;width:17px;height:17px;opacity:.8;pointer-events:none}
.calendar-month{padding:0 20px}
.calendar-month-totals{display:flex;gap:10px;margin:5px 4px 10px;font-size:13px}
.calendar-month-totals>view{flex:1;min-width:0;display:flex;align-items:center;gap:4px}
.calendar-month-totals scroll-view{min-width:0;flex:1;font-weight:600}
.calendar-total-label{font-size:10px;flex:none;color:#74736C}
.calendar-weekdays{display:flex;background:#FFFCF3;border-bottom:.5px solid #EEEDE8;border-top:.5px solid #EEEDE8;border-radius:9px 9px 0 0;font-size:12px;color:#8C8A82}
.calendar-weekdays>view{width:14.285714%;text-align:center;line-height:30px;min-height:30px}
.calendar-weekdays .weekend{color:#A45D77}
.calendar-grid{display:flex;flex-wrap:wrap;width:100%}
.calendar-day,.calendar-blank{box-sizing:border-box;flex:0 0 14.285714%;width:14.285714%!important;max-width:14.285714%;min-width:44px;min-height:72px;border-right:.5px solid #EEEDE8;border-bottom:.5px solid #EEEDE8}
.calendar-day{position:relative;display:flex!important;flex-direction:column;align-items:center;justify-content:flex-start;margin:0!important;padding:6px 2px 4px!important;border-radius:0;background:#FFF;line-height:1.4!important;color:#34352F;font-weight:400!important;white-space:normal}
.calendar-day::after{border:0!important}
.calendar-day.selected-day{background:#FFF3BD;border-radius:10px}
.calendar-date{position:relative;width:100%;font-size:15px;line-height:24px;min-height:24px;font-weight:600}
.calendar-day.is-today .calendar-date::after{content:"";position:absolute;bottom:1px;left:calc(50% - 6px);width:12px;height:2px;border-radius:50%;background:#E8BD42}
.calendar-day.future,.calendar-day.future[disabled]{background:white;color:#B7B7B1}
.calendar-selected-paw{position:absolute;right:2px;top:2px;width:10px;height:10px;opacity:.8;pointer-events:none}
.calendar-refund-marker{position:absolute;left:0;top:1px;border:.5px solid #8B777E;border-radius:3px;font-size:7px;line-height:10px;width:10px;color:#886E78;font-weight:400}
.calendar-amount{display:flex;align-items:center;justify-content:center;width:100%;min-height:16px;line-height:16px;font-size:10px;white-space:nowrap;text-align:center;overflow:hidden}
.calendar-amount>text{flex:none;margin-right:1px;font-size:9px}
.calendar-amount scroll-view{flex:0 1 auto;min-width:0;width:auto;max-width:100%}
.calendar-amount scroll-view text{white-space:nowrap;display:inline-block}
.expense{color:#956528}.income{color:#A64D71}.refund{color:#7B6470}
.calendar-legend{display:flex;justify-content:center;flex-wrap:wrap;gap:7px 14px;font-size:10px;color:#888279;margin-top:10px}
.calendar-note{font-size:10px;line-height:1.7;color:#969184;text-align:center;margin:4px 4px 0}
.calendar-selected-detail{background:#FFF;border:1px solid #EEECE6;border-radius:18px;padding:14px;margin-top:12px}
.calendar-selected-detail>.ledger-section{font-size:16px}
.calendar-exact-totals{display:flex;flex-wrap:wrap;gap:6px 14px;margin:7px 0 2px;font-size:12px}
.calendar-exact-totals>view{display:flex;align-items:center;gap:5px;min-width:0;max-width:100%}
.calendar-exact-totals>view>text{flex:none}
.calendar-exact-totals scroll-view{min-width:0;width:auto;font-weight:600}
.calendar-selected-detail .ledger-row{min-height:62px;padding:9px 0!important}
.calendar-selected-detail .ledger-row:last-child{border-bottom:0}
.ledger-home .ledger-journal-panel{margin-left:5px;padding:10px 14px 16px 20px;border:1.4px solid #72644C;border-radius:19px 8px 21px 15px;box-shadow:2px 3px 0 #F4E9C6}.ledger-home .ledger-panel-month{justify-content:space-between;gap:0;padding:0 38px 0 0;flex-wrap:wrap}.ledger-book-month-actions{display:flex;flex:none}.ledger-home .ledger-panel-month-label{font-size:16px}.ledger-home .ledger-panel-month-label::after{display:none}.ledger-home .ledger-panel-info{right:0;top:10px}.ledger-home .ledger-panel-main{text-align:left;padding:15px 0 2px}.ledger-home .ledger-money-main{margin-top:5px}.ledger-book-main-number{position:relative;padding-bottom:4px}.ledger-book-main-number::after{content:"";position:absolute;bottom:2px;left:1px;width:100%;height:4px;border-radius:50%;background:#F6D65C;transform:rotate(-1deg);pointer-events:none}.ledger-home .ledger-panel-paw{top:90px;right:19px;width:27px;height:27px;opacity:.45}.ledger-home .ledger-summary-bottom{border-top:0;padding-top:0;text-align:left;gap:8px}.ledger-home .ledger-summary-cell{min-width:0;background:rgba(255,255,255,.78);border:1px solid #F0EAD8;border-radius:15px;padding:10px!important;box-sizing:border-box}.ledger-home .ledger-summary-cell+.ledger-summary-cell{border-left:1px solid #F0EAD8}.ledger-book-spine{position:absolute;left:-7px;top:38px;bottom:34px;width:14px;display:flex;flex-direction:column;justify-content:space-between;pointer-events:none}.ledger-book-spine>view{height:6px;border:1.5px solid #72644C;border-radius:5px;background:#FFF8DF}.ledger-book-fold{position:absolute;right:-1px;top:-1px;width:18px;height:18px;border-left:1px solid #72644C;border-bottom:1px solid #72644C;border-radius:0 7px 0 2px;background:linear-gradient(45deg,#F6EAC1 48%,#FFFCF2 50%);pointer-events:none}.ledger-home .ledger-summary-bottom.panel-stacked .ledger-summary-cell{width:100%}.ledger-home .ledger-summary-bottom.panel-stacked{gap:8px}
.ledger-statistics .ledger-rank .ledger-section-row scroll-view{width:auto;min-width:0;max-width:100%;font-size:14px}
@media(max-width:350px){
 .ledger-journal-panel{padding-left:12px;padding-right:12px}
 .ledger-panel-month{padding-left:17px;padding-right:17px}
 .ledger-panel-month-label{font-size:14px}
 .ledger-panel-info{right:0}
 .ledger-journal-panel .ledger-summary-bottom{flex-direction:row}
 .ledger-journal-panel .ledger-summary-bottom.panel-stacked{flex-direction:column}
 .ledger-journal-panel .ledger-summary-cell+.ledger-summary-cell{border-left:1px solid #E4DCC0;padding-left:12px}
 .ledger-journal-panel .panel-stacked .ledger-summary-cell+.ledger-summary-cell{border-left:0;padding-left:0}
 .ledger-statistics{padding-left:5px;padding-right:5px}
 .ledger-calendar{padding-left:0;padding-right:0}
 .ledger-statistics .ledger-card,.calendar-selected-detail{margin-left:9px;margin-right:9px}
 .calendar-month-totals{margin-left:8px;margin-right:8px;gap:6px}
 .calendar-total-label{font-size:9px}
 .calendar-day,.calendar-blank{min-height:74px}
 .calendar-day{padding-left:0!important;padding-right:0!important}
 .calendar-amount,.calendar-digit-probe,.calendar-unit-probe{font-size:9.5px}
 .calendar-amount>text,.calendar-prefix-probe{font-size:8px}
 .ledger-day-heading{font-size:10px}
}
