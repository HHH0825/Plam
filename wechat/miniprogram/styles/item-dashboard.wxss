.item-dashboard-cost{position:relative;background:#FFF8DF;border:1px solid #EEE4C6;border-radius:20px;padding:16px;margin:0 0 10px;min-width:0}
.item-dashboard-caption{font-size:14px;font-weight:650;color:#45453E;padding-right:40px}
.item-dashboard-main{font-size:32px;font-weight:700;line-height:1.5;margin-top:3px;width:100%}
.item-dashboard-scope{font-size:11px;line-height:1.7;color:#868279;overflow-wrap:anywhere}
.item-dashboard-info{position:absolute;right:1px;top:1px;width:44px!important;min-width:44px;max-width:44px;height:44px;display:flex;align-items:center;justify-content:center;background:transparent;padding:0;font-size:13px;border-radius:50%;color:#66645B}
.item-dashboard-info::before{content:"";position:absolute;width:15px;height:15px;border:1px solid #777266;border-radius:50%;pointer-events:none}
.item-dashboard-paw{position:absolute;right:50px;top:14px;width:22px;height:22px;opacity:.75;pointer-events:none}
.item-dashboard-breakdown{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 12px;border-top:1px solid #E7DFC3;margin-top:12px;padding-top:10px}
.item-dashboard-breakdown.stacked{grid-template-columns:minmax(0,1fr)}
.item-dashboard-cell{min-width:0}
.item-dashboard-label{font-size:12px;line-height:1.6;color:#77746B;overflow-wrap:anywhere}
.item-dashboard-value{font-weight:650;line-height:1.6;width:100%}
.item-dashboard-states{display:flex;background:white;border:1px solid #E9E7E2;border-radius:16px;margin-bottom:10px;padding:10px 0}
.item-dashboard-states>view{flex:1;min-width:0;text-align:center;padding:0 10px}
.item-dashboard-states>view+view{border-left:1px solid #EEECE6}
.item-dashboard-states scroll-view{font-size:22px;font-weight:650;line-height:1.6}
.item-dashboard-unit{font-size:12px;font-weight:400}
.item-dashboard-card{background:white;border:1px solid #E9E7E2;border-radius:18px;padding:14px;margin-bottom:10px;min-width:0}
.item-dashboard-section{font-size:16px;line-height:1.5;font-weight:650;color:#383832}
.item-dashboard-track{display:flex;height:20px;border-radius:12px;overflow:hidden;background:#EEEDE8;margin:10px 0}
.item-dashboard-track>view{height:100%;flex:none;box-sizing:border-box;border-right:1px solid white}
.item-dashboard-track>view:last-child{border-right:0}
.item-dashboard-legend{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px 10px}
.item-dashboard-legend.four{grid-template-columns:repeat(2,minmax(0,1fr))}
.item-dashboard-legend>view{min-width:0;font-size:12px;line-height:1.6}
.item-dashboard-legend-label{display:flex;align-items:flex-start;gap:5px;color:#77746B}
.item-dashboard-legend-label>text{min-width:0;overflow-wrap:anywhere}
.item-dashboard-dot{flex:none;width:9px;height:9px;border-radius:50%;margin-top:5px}
.item-dashboard-legend scroll-view{font-weight:600}
.item-dashboard-reminder{display:flex;align-items:center;gap:8px;width:100%!important;min-width:0;max-width:100%;min-height:44px;border:1px solid #F0EEE9;border-radius:13px;background:white;padding:8px 10px;margin-top:7px!important;text-align:left;white-space:normal;font-size:13px;line-height:1.6}
.item-dashboard-reminder>image{width:18px;height:18px;flex:none;pointer-events:none}
.item-dashboard-reminder>text:not(.item-dashboard-chevron){flex:1;min-width:0;overflow-wrap:anywhere}
.item-dashboard-chevron{font-size:22px;line-height:1.2;flex:none;color:#716C60}
.item-dashboard-all{display:flex;align-items:center;justify-content:flex-end;min-height:44px;width:100%!important;max-width:100%;padding:6px 0 0;background:transparent;color:#888276;font-size:11px}
.item-dashboard-report{display:flex;align-items:center;gap:10px;width:100%!important;max-width:100%;min-width:0;min-height:64px;padding:10px 14px;background:#FFF8E5;border:1px solid #EEE4C6;border-radius:17px;font-size:14px;text-align:left}
.item-dashboard-report>image{width:32px;height:32px;flex:none;pointer-events:none}
.item-dashboard-report>view{flex:1;min-width:0}
.item-dashboard-compat{font-size:11px;line-height:1.7;color:#8C7554;margin:4px 0 10px;overflow-wrap:anywhere}
.item-dashboard-probe{display:inline-block;white-space:nowrap;line-height:1.6}
@media(max-width:350px){.item-dashboard{margin:0 9px}.item-dashboard-cost{padding:14px}.item-dashboard-legend,.item-dashboard-legend.four{grid-template-columns:minmax(0,1fr)}.item-dashboard-legend>view{display:flex;align-items:center;gap:10px}.item-dashboard-legend-label{flex:1;min-width:0}.item-dashboard-legend scroll-view{width:auto;min-width:0;max-width:65%}}
