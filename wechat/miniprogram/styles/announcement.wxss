.announcement-host .member-announcement-entry{display:inline-flex;align-items:center;justify-content:center;flex:none;width:44px!important;max-width:44px!important;height:44px;min-height:44px;margin:0;padding:0;background:transparent;border-radius:13px;line-height:44px}.member-announcement-entry image{display:block;width:32px;height:32px}.member-announcement-entry::after{border:0}.member-announcement-entry:active{background:#FFF0BB}
.member-announcement-mask{position:fixed;z-index:1000;inset:0;display:flex;align-items:center;justify-content:center;box-sizing:border-box;padding:18px 16px calc(18px + env(safe-area-inset-bottom));background:rgba(55,48,31,.32)}
.member-announcement-window{display:flex;flex-direction:column;width:100%;max-width:420px;max-height:82vh;min-width:0;box-sizing:border-box;border:1px solid #E8D49A;border-radius:22px;background:#FFFDF5;box-shadow:0 14px 48px #40351D24;overflow:hidden}
.member-announcement-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;flex:none;padding:16px 12px 12px 20px;border-bottom:1px solid #F1E9D2;font-size:19px;font-weight:600;color:#6E592D;line-height:1.5}.member-announcement-eyebrow{display:block;font-size:10px;font-weight:400;color:#A48D55;margin-bottom:3px;letter-spacing:2px}
.announcement-host .member-announcement-close{display:block;width:44px!important;max-width:44px!important;min-width:44px;min-height:44px;flex:none;margin:0;padding:0;background:#FFF4D5;border-radius:50%;font-size:25px;font-weight:400;line-height:44px;color:#9A8248}
.member-announcement-scroll{display:block;height:340px;max-height:calc(78vh - 165px);min-height:0;box-sizing:border-box}.member-announcement-scroll.announcement-short{height:180px}.member-announcement-body{padding:17px 20px 20px;font-size:13px;line-height:1.95;color:#87734E;overflow-wrap:anywhere}.member-announcement-title{font-weight:600;color:#715A2A}.member-announcement-body>view+view{margin-top:14px}
.member-announcement-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;flex:none;padding:10px 16px;border-top:1px solid #F1E9D2}.announcement-host .member-announcement-footer .member-feedback-link{min-height:44px;margin:0;padding:8px 0;line-height:28px;white-space:normal}.announcement-host .member-announcement-done{width:auto!important;max-width:none;min-height:44px;flex:none;margin:0;padding:8px 17px;background:#FFE68A;border-radius:22px;color:#6D5828;font-size:12px;font-weight:600;line-height:28px}.member-announcement-close::after,.member-announcement-done::after{border:0}
.member-announcement-flight{position:fixed;z-index:1002;width:72px;height:72px;pointer-events:none;animation:notice-letter-return 520ms cubic-bezier(.4,0,.65,1) both}
.announcement-closing .member-announcement-window{pointer-events:none;transform-origin:center;animation:notice-letter-fold 170ms ease-in both}
.member-announcement-mask.announcement-closing{animation:notice-shade-away 520ms ease-out both}
.member-announcement-entry.announcement-received image{animation:notice-icon-receive 340ms ease-out both}
@keyframes notice-letter-fold{0%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(.78,.12) translateY(12px)}}
@keyframes notice-letter-return{0%{opacity:0;transform:translate(0,0) scale(.7) rotate(0deg)}20%{opacity:1;transform:translate(0,0) scale(1) rotate(-5deg)}65%{opacity:1;transform:translate(var(--notice-mid-x),var(--notice-mid-y)) scale(.72) rotate(-14deg)}94%{opacity:1;transform:translate(var(--notice-dx),var(--notice-dy)) scale(.44) rotate(0deg)}100%{opacity:0;transform:translate(var(--notice-dx),var(--notice-dy)) scale(.4) rotate(0deg)}}
@keyframes notice-shade-away{0%,20%{background:rgba(55,48,31,.32)}100%{background:rgba(55,48,31,0)}}
@keyframes notice-icon-receive{0%{transform:scale(1)}40%{transform:scale(1.23) rotate(-7deg)}75%{transform:scale(.96) rotate(2deg)}100%{transform:scale(1) rotate(0deg)}}
@media(prefers-reduced-motion:reduce){.member-announcement-flight{display:none}.announcement-closing .member-announcement-window{animation:notice-reduced-fade 100ms ease-out both}.member-announcement-entry.announcement-received image{animation:none}.member-announcement-mask.announcement-closing{animation:notice-shade-away 100ms ease-out both}}
@keyframes notice-reduced-fade{to{opacity:0}}
.announcement-host .member-feedback-link{width:auto;max-width:none;background:transparent;color:#8c6e24;font-size:12px;font-weight:500;border:0}.member-feedback-link::after{border:0}.announcement-fading .member-announcement-window{animation:notice-reduced-fade 100ms ease-out both}.member-announcement-mask.announcement-fading{animation:notice-shade-away 100ms ease-out both}
