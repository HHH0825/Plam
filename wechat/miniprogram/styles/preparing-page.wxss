.feature-page{padding-top:26px;padding-bottom:calc(120px + env(safe-area-inset-bottom));min-height:100vh}
.feature-wash{position:absolute;z-index:-1;left:0;right:0;top:0;height:320px;background:linear-gradient(180deg,rgba(255,247,224,.8),rgba(255,247,224,0));pointer-events:none}
.feature-page .eyebrow{letter-spacing:.5px}.feature-page .title{font-size:32px;margin-top:12px;margin-bottom:10px}.feature-page .subtitle{font-size:14px}
.preparing-card{margin-top:26px;padding:24px 18px;border:1px solid #EAEAEA;border-radius:24px;background:#FFFFFF;text-align:center;box-shadow:0 3px 0 #FFF6D9}
.preparing-cat{display:block;width:150px;height:138px;margin:0 auto 14px;pointer-events:none}
.preparing-state{display:inline-block;border-radius:999px;background:#FFF6CF;color:#7A632F;font-size:12px;padding:5px 12px;line-height:1.6}
.preparing-message{font-size:20px;font-weight:700;line-height:1.5;margin-top:15px;overflow-wrap:anywhere}.preparing-description{font-size:13px;line-height:1.8;color:#777;margin-top:10px;overflow-wrap:anywhere}
.preparing-tags{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:20px}.preparing-tags text{padding:5px 9px;border-radius:9px;font-size:12px;color:#777;background:#F8F8F6}
.feature-page .preparing-analysis{margin:24px 0 0;min-height:48px;border-radius:16px;gap:8px;width:100%;font-size:14px}
@media(max-width:350px){.feature-page{padding-left:14px;padding-right:14px}.preparing-card{padding-left:14px;padding-right:14px}}
