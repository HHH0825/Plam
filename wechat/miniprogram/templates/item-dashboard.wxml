<view class="item-dashboard {{motionPanelClass}}">
 <view wx:if="{{itemStatsError}}" class="ledger-error" role="alert">{{itemStatsError}}<button class="ledger-text-button" bindtap="loadItemStats" disabled="{{itemStatsLoading}}">重新读取物品统计</button></view>
 <view wx:if="{{itemStatsLoading && !itemStats}}" class="ledger-empty"><cat-loading label="正在整理物品统计…"/></view>
 <block wx:if="{{itemStats}}">
  <view class="item-dashboard-cost">
   <button class="item-dashboard-info" bindtap="itemStatsInfo" aria-label="查看物品成本说明">i</button><image class="item-dashboard-paw" src="/assets/purchase-entry/progress-paw.png" aria-hidden="true" mode="aspectFit"/>
   <view class="item-dashboard-caption">累计净成本</view><scroll-view class="item-dashboard-main" scroll-x style="font-size:{{itemLayout.main}}px"><text class="ledger-nowrap">{{itemStats.netAvailable ? '¥' : ''}}{{itemStats.netText}}</text></scroll-view><view class="item-dashboard-scope">全部物品累计 · 含已处置</view>
   <view class="item-dashboard-breakdown {{itemLayout.stacked ? 'stacked' : ''}}"><view wx:for="{{itemStats.breakdown}}" wx:key="key" class="item-dashboard-cell"><view class="item-dashboard-label">{{item.label}}</view><scroll-view scroll-x class="item-dashboard-value" style="font-size:{{itemLayout.small}}px"><text class="ledger-nowrap">{{item.available ? '¥' : ''}}{{item.text}}</text></scroll-view></view></view>
  </view>
  <view wx:if="{{!itemStats.compatible}}" class="item-dashboard-compat">部分统计字段暂不可用，请同步服务端后重新读取。<button class="ledger-text-button" bindtap="loadItemStats" disabled="{{itemStatsLoading}}">重新读取</button></view>
  <view class="item-dashboard-states"><view wx:for="{{itemStats.states}}" wx:key="key"><view class="item-dashboard-label">{{item.label}}</view><scroll-view scroll-x><text class="ledger-nowrap">{{item.text}}<text class="item-dashboard-unit">{{item.available ? ' 件' : ''}}</text></text></scroll-view></view></view>
  <view class="item-dashboard-card"><view class="item-dashboard-section">购入金额分布</view><view class="item-dashboard-scope">按全部物品购买价</view>
   <view wx:if="{{itemStats.distribution.error}}" class="item-dashboard-compat">{{itemStats.distribution.error}}<button class="ledger-text-button" bindtap="loadItemStats" disabled="{{itemStatsLoading}}">重新读取分类</button></view>
   <block wx:else><view class="item-dashboard-track" aria-hidden="true"><view wx:if="{{!itemStats.distribution.empty}}" wx:for="{{itemStats.distribution.rows}}" wx:key="key" style="width:{{item.percent}}%;background:{{item.color}}"/></view><view wx:if="{{itemStats.distribution.empty}}" class="item-dashboard-scope">暂无购买金额分布</view><view class="item-dashboard-legend {{itemStats.distribution.rows.length > 3 ? 'four' : ''}}"><view wx:for="{{itemStats.distribution.rows}}" wx:key="key"><view class="item-dashboard-legend-label"><view class="item-dashboard-dot" style="background:{{item.color}}" aria-hidden="true"/><text>{{item.name}}</text></view><scroll-view scroll-x><text class="ledger-nowrap">¥{{item.amountText}}</text></scroll-view></view></view></block>
  </view>
  <view class="ledger-measure-probes" aria-hidden="true"><text wx:for="{{itemMainSizes}}" wx:key="*this" class="item-dashboard-probe" data-field="net" data-size="{{item}}" style="font-size:{{item}}px;font-weight:700">{{itemStats.netAvailable ? '¥' : ''}}{{itemStats.netText}}</text><block wx:for="{{itemSmallSizes}}" wx:key="*this" wx:for-item="size"><text wx:for="{{itemStats.breakdown}}" wx:key="key" class="item-dashboard-probe" data-field="{{item.key}}" data-size="{{size}}" style="font-size:{{size}}px;font-weight:650">{{item.available ? '¥' : ''}}{{item.text}}</text></block></view>
 </block>
 <view class="item-dashboard-card"><view class="item-dashboard-section">小小发现</view><view wx:if="{{itemInsightsError}}" class="ledger-error">{{itemInsightsError}}<button class="ledger-text-button" bindtap="loadItemInsights" disabled="{{itemInsightsLoading}}">重新读取分析</button></view><view wx:elif="{{itemInsightsLoading && !itemReminders.length}}" class="item-dashboard-scope"><cat-loading label="正在整理提醒…"/></view><block wx:else><view wx:if="{{!itemReminders.length}}" class="item-dashboard-scope">暂时没有需要留意的物品</view><button wx:for="{{itemReminders}}" wx:key="key" class="item-dashboard-reminder" data-kind="{{item.kind}}" bindtap="itemAnalysis"><image src="{{item.paw}}" mode="aspectFit" aria-hidden="true"/><text>{{item.headline}}</text><text class="item-dashboard-chevron" aria-hidden="true">›</text></button></block><button class="item-dashboard-all" bindtap="itemAnalysis">查看全部分析 ›</button></view>
 <button class="item-dashboard-report" bindtap="itemMonthly"><image src="/assets/ledger-nav/ledger.png" mode="aspectFit" aria-hidden="true"/><view><text>本月收藏小报</text><view class="item-dashboard-scope">{{itemMonth}}</view></view><text class="item-dashboard-chevron" aria-hidden="true">›</text></button>
</view>
