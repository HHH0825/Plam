<template name="ledger-summary">
 <view class="ledger-summary ledger-journal-panel {{motionPanelClass}}">
  <view class="ledger-drawn-frame" aria-hidden="true"><view class="book-edge edge-top"/><view class="book-edge edge-bottom"/><view class="book-edge edge-left"/><view class="book-edge edge-right"/><image class="book-corner corner-tl" src="/assets/cash-fidelity/frame-tl.png"/><image class="book-corner corner-tr" src="/assets/cash-fidelity/frame-tr.png"/><image class="book-corner corner-bl" src="/assets/cash-fidelity/frame-bl.png"/><image class="book-corner corner-br" src="/assets/cash-fidelity/frame-br.png"/></view><view class="ledger-book-spine" aria-hidden="true"><image src="/assets/cash-fidelity/binding.png"/><image src="/assets/cash-fidelity/binding.png"/><image src="/assets/cash-fidelity/binding.png"/></view><image class="ledger-book-fold" src="/assets/cash-fidelity/fold.png" aria-hidden="true"/>
  <view class="ledger-panel-month"><picker mode="date" fields="month" value="{{month}}" end="{{maxMonth}}" start="0001-01" bindchange="monthChange" aria-label="选择月份"><view class="ledger-panel-month-label">{{monthLabel}}<view class="ledger-caret" aria-hidden="true"/></view></picker><view class="ledger-book-month-actions"><button class="ledger-month-arrow" hover-class="ledger-month-hover" bindtap="previous" aria-label="上个月"><view class="ledger-month-chevron previous" aria-hidden="true"/></button><button class="ledger-month-arrow" hover-class="ledger-month-hover" bindtap="next" disabled="{{!canNext}}" aria-label="下个月"><view class="ledger-month-chevron next" aria-hidden="true"/></button></view></view>
  <button class="ledger-panel-info" bindtap="summaryInfo" aria-label="查看收支说明">i</button><image class="ledger-panel-paw" src="/assets/cash-fidelity/pink-paw.png" mode="aspectFit" aria-hidden="true"/>
  <view class="ledger-panel-main"><view class="ledger-panel-label">{{summary.expense_label}}</view><scroll-view class="ledger-main-region ledger-money-main" scroll-x style="font-size:{{panelLayout.mainSize}}px"><text class="ledger-nowrap ledger-book-main-number">¥{{summary.expenseText}}</text></scroll-view><view wx:if="{{summary.refund !== '0.00'}}" class="ledger-panel-refund"><scroll-view scroll-x><text class="ledger-nowrap">原支出 ¥{{summary.grossText}} · 已扣退款 ¥{{summary.refundText}}</text></scroll-view></view></view>
  <view class="ledger-summary-bottom {{panelLayout.stacked ? 'panel-stacked' : ''}}"><view class="ledger-summary-cell"><view class="ledger-summary-caption"><image src="/assets/cash-fidelity/wallet.png" mode="aspectFit" aria-hidden="true"/><view class="ledger-panel-label">本月收入</view></view><scroll-view class="ledger-money-small" scroll-x style="font-size:{{panelLayout.smallSize}}px"><text class="ledger-nowrap">¥{{summary.incomeText}}</text></scroll-view></view><view class="ledger-summary-cell"><view class="ledger-summary-caption"><image src="/assets/cash-fidelity/bars.png" mode="aspectFit" aria-hidden="true"/><view class="ledger-panel-label">{{summary.net_label}}</view></view><scroll-view class="ledger-money-small" scroll-x style="font-size:{{panelLayout.smallSize}}px"><text class="ledger-nowrap">¥{{summary.netText}}</text></scroll-view></view></view>
 </view>
 <view class="ledger-measure-probes" aria-hidden="true"><text wx:for="{{mainSizes}}" wx:key="*this" class="ledger-panel-probe" data-field="main" data-size="{{item}}" style="font-size:{{item}}px;font-weight:700">¥{{summary.expenseText}}</text><block wx:for="{{smallSizes}}" wx:key="*this"><text class="ledger-panel-probe" data-field="income" data-size="{{item}}" style="font-size:{{item}}px;font-weight:650">¥{{summary.incomeText}}</text><text class="ledger-panel-probe" data-field="net" data-size="{{item}}" style="font-size:{{item}}px;font-weight:650">¥{{summary.netText}}</text></block></view>
</template>
<template name="ledger-gate">
 <view class="ledger-card ledger-empty"><image class="ledger-gate-art" src="/assets/white-doodle/cat-book.png" mode="aspectFit"/><view class="ledger-section">{{supported ? '从今天，慢慢记清楚' : '功能正在准备中'}}</view><view class="ledger-muted">{{supported ? '日常收支与物品相关付款，放进同一本账。已有记录可核对后导入。' : '请同步新版服务端后使用记账，物品功能仍可正常使用。'}}</view><button wx:if="{{supported}}" class="ledger-primary" bindtap="enable" disabled="{{loading}}">开启记账</button><button wx:else class="ledger-secondary" bindtap="load" disabled="{{loading}}">重新检查</button></view>
</template>
