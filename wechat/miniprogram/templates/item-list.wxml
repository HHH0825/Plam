<view style="{{memberThemeStyle}}" class="member-themed {{memberThemeClass}} page collection-page announcement-host {{isArchive ? 'archive-page' : 'held-page'}}">
  <view wx:if="{{!decorError}}" class="decor-health" aria-hidden="true"><image class="decor-probe" src="/assets/item-doodle/corner-tl.png" binderror="decorFailed"/><image class="decor-probe" src="/assets/item-doodle/corner-tr.png" binderror="decorFailed"/><image class="decor-probe" src="/assets/item-doodle/corner-bl.png" binderror="decorFailed"/><image class="decor-probe" src="/assets/item-doodle/corner-br.png" binderror="decorFailed"/><image class="decor-probe" src="/assets/item-doodle/edge-top.png" binderror="decorFailed"/><image class="decor-probe" src="/assets/item-doodle/edge-bottom.png" binderror="decorFailed"/><image class="decor-probe" src="/assets/item-doodle/edge-left.png" binderror="decorFailed"/><image class="decor-probe" src="/assets/item-doodle/edge-right.png" binderror="decorFailed"/></view>
  <view class="collection-hero">
    <view wx:if="{{!isArchive}}" class="held-hero-wash" aria-hidden="true"></view>
    <view wx:if="{{!decorError}}" class="hero-doodles" aria-hidden="true"><image class="doodle hero-paw" src="/assets/item-doodle/paw.png" binderror="decorFailed"/><image class="doodle hero-star" src="/assets/item-doodle/star.png" binderror="decorFailed"/><image class="doodle hero-dot" src="/assets/item-doodle/dot.png" binderror="decorFailed"/><image class="doodle hero-dot-small" src="/assets/item-doodle/dot.png" binderror="decorFailed"/></view>
    <view class="page-heading collection-heading">
      <view class="heading-copy"><view class="eyebrow {{!isArchive && updateNotice ? 'with-update' : ''}}"><text class="collection-eyebrow-label">{{isArchive ? '猫爪物帐 · 已归档的故事' : '生活收藏册'}}</text><button wx:if="{{!isArchive && updateNotice}}" class="item-update-entry member-announcement-entry {{announcementPulse ? 'announcement-received' : ''}}" bindtap="openUpdateNotice" aria-label="更新公告{{updateNoticeUnread ? '，有未读消息' : ''}}" aria-haspopup="dialog"><image wx:if="{{!updateNoticeIconError}}" class="member-announcement-icon" src="/assets/membership/announcement.png" mode="aspectFit" aria-hidden="true" binderror="updateNoticeIconFailed"/><text wx:else class="update-icon-fallback">公告</text><view wx:if="{{updateNoticeUnread}}" class="update-unread" aria-hidden="true">!</view></button></view><view class="heading-title"><text class="title"><block wx:if="{{isArchive}}">已处置档案</block><block wx:else><text class="held-title-word">我的</text><text class="held-title-word">物品</text></block></text><image wx:if="{{!decorError}}" class="title-underline" src="/assets/item-doodle/underline.png" aria-hidden="true" binderror="decorFailed"/></view><view wx:if="{{isArchive}}" class="subtitle">{{items.length}} 份档案，留住曾经的相伴。</view><view wx:else class="subtitle held-subtitle"><text class="held-count {{items.length >= 1000000 ? 'held-count-long' : ''}}">{{items.length}}</text><text> 件持有物品 · </text><text class="held-slow">慢慢收藏</text></view></view>
      <image wx:if="{{isArchive}}" class="collection-kitten" src="/assets/disposed-archive/entry.png" mode="aspectFit" aria-hidden="true"/>
      <image wx:elif="{{!heroArtError}}" class="collection-kitten held-kitten" src="/assets/items-header/cat-box.png" mode="aspectFit" aria-hidden="true" binderror="heroArtFailed"/>
    </view>
  </view>
  <view wx:if="{{isArchive}}" class="search-wrap"><text class="search-symbol" aria-hidden="true">⌕</text><input class="search" placeholder="搜索物品" placeholder-class="search-placeholder" value="{{query}}" bindinput="search" aria-label="搜索物品名称、分类或备注"/></view>
  <view class="collection-tools">
    <view wx:if="{{!isArchive}}" class="purchase-entries {{entriesStacked ? 'entries-stacked' : ''}}">
      <button class="wishlist-entry" bindtap="wishlist"><image wx:if="{{!entryIconErrors.wishlist}}" class="purchase-entry-icon" src="/assets/items-header/entry-wishlist.png" mode="aspectFit" data-key="wishlist" binderror="entryIconFailed" aria-hidden="true"/><text class="purchase-entry-label">想买清单</text></button>
      <button class="subscription-entry" bindtap="expenses"><image wx:if="{{!entryIconErrors.subscription}}" class="purchase-entry-icon" src="/assets/items-header/entry-subscription.png" mode="aspectFit" data-key="subscription" binderror="entryIconFailed" aria-hidden="true"/><text class="purchase-entry-label">订阅/分期</text></button>
      <button class="storage-entry" bindtap="locations"><image wx:if="{{!entryIconErrors.storage}}" class="purchase-entry-icon" src="/assets/items-header/entry-storage.png" mode="aspectFit" data-key="storage" binderror="entryIconFailed" aria-hidden="true"/><text class="purchase-entry-label">收纳位置</text></button>
    </view>
    <view class="collection-results-tools {{!isArchive && searchOpen ? 'search-expanded' : ''}}"><text wx:if="{{isArchive}}" class="result-copy">{{shown.length}} 件{{status ? ' · ' + statusOptions[statusIndex] : ''}}{{category ? ' · ' + category : ''}}</text><view class="collection-filter-sort">
      <view wx:if="{{!isArchive}}" class="held-search-region {{searchOpen ? 'expanded' : ''}}"><button class="held-search-control {{searchOpen || query ? 'applied' : ''}}" bindtap="toggleSearch" aria-label="{{searchOpen ? '收起物品搜索' : '搜索物品'}}"><view class="held-search-mark" aria-hidden="true"/></button><input wx:if="{{searchOpen}}" class="held-inline-input" placeholder="搜索物品" value="{{query}}" focus="{{searchFocus}}" bindinput="search" maxlength="120" cursor-spacing="24" aria-label="搜索物品名称、分类或备注"/><button wx:if="{{searchOpen && query}}" class="held-search-close" bindtap="clearSearch" aria-label="清空搜索关键词">×</button></view>
      <button class="filter-control {{filterCount ? 'applied' : ''}}" bindtap="openFilters" aria-label="筛选物品"><view class="filter-surface"><image wx:if="{{!entryIconErrors.filter}}" class="control-icon" src="/assets/purchase-entry/filter.png" data-key="filter" binderror="entryIconFailed" aria-hidden="true"/><text wx:if="{{isArchive}}">筛选</text><text wx:if="{{filterCount}}" class="filter-count">{{filterCount}}</text></view></button>
      <picker class="sort-picker" range="{{sortOptions}}" value="{{sortIndex}}" bindchange="sortChange" aria-label="{{'排序，当前：' + sortOptions[sortIndex]}}"><view class="sort-control"><image wx:if="{{!entryIconErrors.sort}}" class="control-icon" src="/assets/purchase-entry/sort.png" data-key="sort" binderror="entryIconFailed" aria-hidden="true"/><text wx:if="{{isArchive || !searchOpen}}">{{sortLabels[sortIndex]}}</text></view></picker>
    </view></view>
  </view>
  <button wx:if="{{!isArchive && query && !searchOpen}}" class="held-query-chip" bindtap="clearSearch" aria-label="清除物品搜索词"><text>搜索：{{query}}</text><text aria-hidden="true">×</text></button>
  <view wx:if="{{(isArchive && query) || status || category}}" class="result-row"><button class="clear-filter" bindtap="clearFilters">清除筛选</button></view>
  <view wx:if="{{error}}" class="card error-panel">{{error}}<button class="button light" bindtap="load">重新读取</button></view>
  <view wx:if="{{loading}}" class="empty"><cat-loading label="小猫正在整理物品…"/></view>
  <view wx:elif="{{!error && shown.length === 0}}" class="empty"><image class="empty-cat" src="{{items.length ? '/assets/white-doodle/cat-search.png' : '/assets/white-doodle/cat-book.png'}}" mode="aspectFit" aria-hidden="true"/><text class="empty-title">{{items.length ? '没有符合条件的物品' : isArchive ? '还没有已处置的物品档案' : '先记录一件常用的物品'}}</text><view>{{items.length ? '换个关键词，或清除筛选。' : isArchive ? '处置后的物品会保存在这里。' : '点击底部猫爪，记录第一件物品'}}</view><button wx:if="{{isArchive && !items.length}}" class="button light archive-return" bindtap="backToItems">返回物品页</button></view>
  <view wx:else class="collection list">
    <view wx:for="{{shown}}" wx:key="id" id="item-{{item.id}}" class="card item-card {{decorError ? 'decor-fallback' : ''}} {{item.photo_url ? 'photo-target' : ''}}" data-id="{{item.id}}" bindtap="open">
      <view wx:if="{{!decorError}}" class="sketch-frame" aria-hidden="true"><view class="sketch-corner corner-tl"></view><view class="sketch-corner corner-tr"></view><view class="sketch-corner corner-bl"></view><view class="sketch-corner corner-br"></view><view class="sketch-edge edge-top"></view><view class="sketch-edge edge-bottom"></view><view class="sketch-edge edge-left"></view><view class="sketch-edge edge-right"></view></view>
      <view class="item-top metric-region {{metricLayouts[item.id].kind === 'wide' ? 'metrics-below' : ''}}" data-id="{{item.id}}"><view class="item-photo-column"><view class="item-art"><image wx:if="{{photoPaths[item.id]}}" class="thumbnail" src="{{photoPaths[item.id]}}" mode="aspectFill" data-id="{{item.id}}" binderror="photoFailed"/><image wx:elif="{{!artErrors[item.id]}}" class="type-art" src="{{item.art}}" mode="aspectFit" data-id="{{item.id}}" binderror="artFailed"/><view wx:else class="art-symbol">{{item.icon}}</view><text wx:if="{{photoStates[item.id] === 'loading'}}" class="photo-loading">读取中…</text></view><text wx:if="{{photoStates[item.id] === 'unavailable'}}" class="photo-unavailable">照片暂不可用</text><button wx:if="{{photoStates[item.id] === 'error'}}" class="photo-retry" data-id="{{item.id}}" catchtap="retryPhoto" aria-label="重试照片">重试照片</button></view>
        <view class="item-summary metric-available" data-id="{{item.id}}"><image wx:if="{{!decorError}}" class="card-doodle" src="{{index % 3 === 0 ? '/assets/item-doodle/paw.png' : index % 3 === 1 ? '/assets/item-doodle/star.png' : '/assets/item-doodle/arc.png'}}" aria-hidden="true" binderror="decorFailed"/>
          <view class="item-name">{{item.name}}</view><view class="item-meta"><text class="item-category">{{item.category}}</text><text class="pill status-{{item.status}}">{{item.statusText}}</text><text wx:if="{{item.is_pinned}}" class="pin-label">置顶</text></view>
        </view>
        <view class="item-cost {{metricLayouts[item.id].kind !== 'columns' ? 'metrics-stacked' : ''}}" style="--metric-number-size:{{metricLayouts[item.id].size || 24}}px">
          <view class="item-days"><text class="metric-label">{{isArchive ? '曾持有天数' : '相伴天数'}}</text><scroll-view class="metric-scroll" scroll-x="{{true}}" style="height:{{metricLayouts[item.id].height || 39}}px"><view class="metric-value"><view class="days-number"><image wx:if="{{!decorError}}" class="days-mark" src="{{isArchive ? '/assets/disposed-archive/mark.png' : '/assets/item-doodle/mark.png'}}" aria-hidden="true" binderror="decorFailed"/><text>{{item.holding_days}}</text></view><text class="metric-unit">天</text></view></scroll-view></view>
          <view class="item-daily"><text class="metric-label">{{isArchive ? '历史日均净成本' : '日均净成本'}}</text><scroll-view class="metric-scroll" scroll-x="{{true}}" style="height:{{metricLayouts[item.id].height || 39}}px"><view class="metric-value"><text class="daily-number">{{item.dailyNet}}</text><text wx:if="{{item.dailyNet !== '暂无'}}" class="metric-unit">/天</text></view></scroll-view></view>
        </view>
        <view class="metric-probes" aria-hidden="true"><view class="metric-probe metric-probe-days" data-id="{{item.id}}" data-size="days" style="font-size:24px">{{item.holding_days}}<text class="metric-probe-unit">天</text></view><view wx:for="{{[24,22,20]}}" wx:for-item="size" wx:key="*this" class="metric-probe" data-id="{{item.id}}" data-size="{{size}}" style="font-size:{{size}}px">{{item.dailyNet}}<text wx:if="{{item.dailyNet !== '暂无'}}" class="metric-probe-unit">/天</text></view></view>
      </view>
    </view>
  </view>
  <view wx:if="{{!decorError}}" class="collection-end-doodles" aria-hidden="true"><image class="doodle end-dot" src="/assets/item-doodle/dot.png" binderror="decorFailed"/><image class="doodle end-paw" src="/assets/item-doodle/paw.png" binderror="decorFailed"/><image class="doodle end-star" src="/assets/item-doodle/star.png" binderror="decorFailed"/></view>
  <view wx:if="{{filterOpen}}" class="filter-overlay {{motionClosing === 'filterOpen' ? 'motion-closing' : ''}}"><view class="filter-mask" bindtap="closeFilters" catchtouchmove="stopSheetTouch"></view><view class="filter-sheet" role="dialog" aria-label="筛选物品"><view class="sheet-heading"><text>筛选物品</text><button class="sheet-close" size="mini" bindtap="closeFilters" aria-label="关闭筛选">×</button></view><scroll-view class="sheet-body" scroll-y="{{true}}">
      <view wx:if="{{!isArchive}}"><view class="filter-label">物品状态</view><view class="filter-choices"><button wx:for="{{statusOptions}}" wx:key="*this" size="mini" class="filter-choice {{draftStatusIndex === index ? 'chosen' : ''}}" data-index="{{index}}" bindtap="chooseDraftStatus">{{item}}</button></view></view>
      <view class="filter-label">物品分类</view><view class="filter-choices"><button wx:for="{{draftCategories}}" wx:key="*this" size="mini" class="filter-choice {{draftCategoryIndex === index ? 'chosen' : ''}}" data-index="{{index}}" bindtap="chooseDraftCategory">{{item}}</button></view>
    </scroll-view><view class="sheet-actions"><button class="sheet-reset" bindtap="resetDraftFilters">重置</button><button class="sheet-apply" bindtap="applyFilters">查看结果</button></view></view></view>
</view>
