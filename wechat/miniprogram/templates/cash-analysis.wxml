<view wx:if="{{cashAnalysisError}}" class="ledger-card ledger-error" role="alert">{{cashAnalysisError}}<button class="ledger-text-button" bindtap="load">重新读取分类统计</button></view>
<block wx:if="{{cashAnalysis}}">
 <view class="ledger-card cash-analysis-card"><view class="cash-analysis-heading"><image src="/assets/cash-fidelity/pink-paw.png" mode="aspectFit" aria-hidden="true"/><view class="ledger-section">本月花在哪里</view><button class="cash-all-categories" bindtap="toggleCategories">{{categoriesExpanded ? '收起分类' : '查看全部分类'}} ›</button></view><view class="cash-analysis-note cash-analysis-scope">按原支出分类 · 退款另列</view>
  <view class="cash-analysis-chart"><cash-donut class="cash-analysis-ring" rows="{{cashAnalysis.rows}}" amount="{{cashAnalysis.summary.grossDisplay}}"/><view class="cash-analysis-legend"><view wx:for="{{cashAnalysis.rows}}" wx:key="key"><view class="cash-legend-name"><view class="cash-color-dot" style="background:{{item.color}}" aria-hidden="true"/><text>{{item.name}}</text></view><scroll-view scroll-x><text class="ledger-nowrap">{{item.display}}</text></scroll-view></view></view></view>
  <view wx:if="{{cashAnalysis.empty}}" class="cash-analysis-note">本月暂无原支出，退款仍单独列出。</view>
  <view class="cash-analysis-refund"><view>已退款<scroll-view scroll-x><text class="ledger-nowrap">{{cashAnalysis.summary.refundDisplay}}</text></scroll-view></view><view>{{cashAnalysis.summary.expense_label === '本月退款结余' ? '退款结余' : '实际支出'}}<scroll-view scroll-x><text class="ledger-nowrap">{{cashAnalysis.summary.expenseDisplay}}</text></scroll-view></view></view>
  <view wx:if="{{categoriesExpanded}}" class="cash-category-list"><view wx:for="{{cashAnalysis.categories}}" wx:key="key"><text>{{item.name}}</text><view class="cash-analysis-note">原支出 <scroll-view scroll-x><text class="ledger-nowrap">{{item.grossDisplay}}</text></scroll-view>退款 <scroll-view scroll-x><text class="ledger-nowrap">{{item.refundDisplay}}</text></scroll-view>{{item.expense_label === '本月退款结余' ? '退款结余' : '净支出'}} <scroll-view scroll-x><text class="ledger-nowrap">{{item.expenseDisplay}}</text></scroll-view></view></view></view>
 </view>
 <view class="ledger-card cash-discoveries"><view class="cash-analysis-heading"><image src="/assets/cash-fidelity/pink-paw.png" mode="aspectFit" aria-hidden="true"/><view class="ledger-section">本月小发现</view></view><view wx:if="{{cashAnalysis.empty}}" class="cash-analysis-note">还没有可展示的支出发现</view><view wx:else class="cash-discoveries-grid"><view><image src="/assets/cash-fidelity/fork.png" mode="aspectFit" aria-hidden="true"/><view>花费最多：<text>{{cashAnalysis.topCategory}}</text></view></view><view><image src="/assets/cash-fidelity/calendar.png" mode="aspectFit" aria-hidden="true"/><view>支出最高日：<text>{{cashAnalysis.topDate}}</text></view></view></view></view>
 <button wx:if="{{!reportPreview}}" class="cash-report-entry" bindtap="cashReport"><image src="/assets/cash-fidelity/reading-cat.png" mode="aspectFit" aria-hidden="true"/><view><text>{{cashReportMonth}}月收支小报</text><view class="cash-analysis-note">把这个月整理成一张小报</view></view><text>生成小报 ›</text></button>
</block>
