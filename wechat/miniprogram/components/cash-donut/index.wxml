<view class="cash-donut" style="width:{{size}}px;height:{{size}}px" aria-label="分类原支出占比"><image wx:if="{{imagePath}}" class="cash-donut-image" src="{{imagePath}}" data-path="{{imagePath}}" mode="aspectFit" binderror="imageFailed" aria-hidden="true"/><view wx:else class="cash-donut-placeholder" style="{{placeholderStyle}}" aria-hidden="true"/><view wx:if="{{!plain}}" class="cash-donut-center"><text>原支出</text><scroll-view scroll-x><text class="cash-donut-amount">{{amount}}</text></scroll-view></view><text wx:if="{{renderError}}" class="cash-donut-error" role="status">图表暂不可用</text><canvas id="ring-renderer" type="2d" class="cash-donut-renderer" aria-hidden="true"/></view>
