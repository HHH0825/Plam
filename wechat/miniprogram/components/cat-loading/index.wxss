:host{display:block}.cat-loader{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:20px 10px;color:#8b7d60;opacity:0;transition:opacity .12s;min-height:116px;box-sizing:border-box}.cat-loader.visible{opacity:1}.cat-loader-frame{width:96px;height:96px;overflow:hidden;position:relative}.cat-loader-strip{position:absolute;left:0;top:0;width:288px;height:96px;max-width:none;animation:cat-sort 1.65s steps(1,end) infinite}.cat-loader-dots{display:flex;gap:5px}.cat-loader-dots .cat-dot{width:5px;height:5px;background:#ffd452;border-radius:50%;animation:cat-dot 1s ease-in-out infinite}.cat-loader-dots .cat-dot:nth-child(2){animation-delay:.15s}.cat-loader-dots .cat-dot:nth-child(3){animation-delay:.3s}.cat-loader-label{font-size:13px;line-height:1.6;text-align:center;white-space:normal}.compact{min-height:44px;padding:6px;flex-direction:row;gap:8px}.compact .cat-loader-frame{width:40px;height:40px}.compact .cat-loader-strip{width:120px;height:40px;animation-name:cat-sort-small}.compact .cat-loader-dots{display:none}.paw-loader{display:inline-flex;flex-direction:row;min-height:24px;padding:0 4px;gap:8px}.cat-paw{width:22px;height:24px;position:relative;animation:cat-paw-hop .8s ease-in-out infinite}.cat-paw .cat-paw-pad{position:absolute;background:currentColor;border-radius:50%;width:5px;height:7px;top:4px;left:2px;transform:rotate(-25deg)}.cat-paw .cat-paw-pad:nth-child(2){left:7px;top:0;transform:rotate(-8deg)}.cat-paw .cat-paw-pad:nth-child(3){left:13px;top:1px;transform:rotate(15deg)}.cat-paw .cat-paw-pad:nth-child(4){left:18px;top:6px;transform:rotate(30deg)}.cat-paw .cat-paw-pad:last-child{width:15px;height:12px;top:11px;left:5px;border-radius:50% 50% 40% 40%;transform:rotate(0)}.reduce-motion .cat-loader-strip,.reduce-motion .cat-paw,.reduce-motion .cat-loader-dots .cat-dot{animation:none}@keyframes cat-sort{0%,100%{transform:translateX(0)}33%{transform:translateX(-96px)}66%{transform:translateX(-192px)}}@keyframes cat-sort-small{0%,100%{transform:translateX(0)}33%{transform:translateX(-40px)}66%{transform:translateX(-80px)}}@keyframes cat-dot{0%,70%,100%{opacity:.35;transform:translateY(0)}35%{opacity:1;transform:translateY(-3px)}}@keyframes cat-paw-hop{0%,100%{transform:translateY(0) rotate(-8deg)}50%{transform:translateY(-4px) rotate(7deg)}}@media (prefers-reduced-motion:reduce){.cat-loader-strip,.cat-paw,.cat-loader-dots .cat-dot{animation:none}}

.cat-loader:not(.visible) .cat-loader-strip,.cat-loader:not(.visible) .cat-paw,.cat-loader:not(.visible) .cat-loader-dots .cat-dot{animation-play-state:paused}
