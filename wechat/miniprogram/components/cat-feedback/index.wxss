.cat-working{position:fixed;left:50%;bottom:calc(90px + env(safe-area-inset-bottom));transform:translateX(-50%);padding:2px 10px;background:rgba(255,253,245,.96);border:1px solid #f0e5c1;border-radius:18px;box-shadow:0 5px 18px #79643013;z-index:1100;pointer-events:none;max-width:85vw;width:max-content}.cat-dialog-mask{position:fixed;inset:0;z-index:1800;display:flex;align-items:center;justify-content:center;padding:24px;background:rgba(37,35,31,.4);box-sizing:border-box}.cat-dialog{background:#fffef8;width:100%;max-width:340px;border:1px solid #eadba8;border-radius:24px;position:relative;padding:25px 22px 20px;box-shadow:0 18px 60px #2a210b25;text-align:center;max-height:85vh;overflow-y:auto;box-sizing:border-box;color:#302e28;animation:cat-welcome-in .22s ease-out}.cat-dialog .cat-dialog-button{margin:0;min-height:44px;box-sizing:border-box;white-space:normal;font-size:14px;line-height:1.5;display:flex;justify-content:center;align-items:center}.cat-dialog .cat-dialog-button::after{border:0}.cat-dialog .cat-dialog-close{position:sticky;float:right;margin-top:-17px;margin-right:-14px;top:-20px;width:44px;min-height:44px;padding:0;background:#fffef8e8;font-size:25px;font-weight:300;color:#39382e;z-index:2;border-radius:50%}.greeting-art{height:112px;clear:both;position:relative;margin-top:-7px}.greeting-art>.greeting-image{width:170px;height:112px;position:relative;z-index:1}.greeting-sun{position:absolute;width:65px;height:65px;border-radius:50%;background:#fff0a8;left:calc(50% - 62px);top:-5px;box-shadow:0 0 0 8px #fff7d8}.cat-dialog-title{font-size:22px;line-height:1.5;font-weight:750;margin:8px 0 10px}.cat-dialog-copy{font-size:13px;line-height:1.85;color:#69665a;overflow-wrap:anywhere}.cat-dialog-copy .cat-dialog-text{display:block}.greeting-reward{display:flex;align-items:center;justify-content:center;gap:8px;margin:20px 0;color:#6e6243;font-size:12px;line-height:1.6}.seed-icon{width:17px;height:13px;flex-shrink:0;background:#ffd45c;border:1.6px solid #76512c;border-radius:58% 42% 60% 40%;transform:rotate(-23deg);box-shadow:inset -3px -2px 0 #edb432}.cat-dialog .cat-dialog-primary{background:#ffe15a;color:#302b1d;border-radius:12px;padding:12px 8px;width:100%;font-weight:700;min-height:46px}.capacity-cat{clear:both;display:block;width:144px;height:124px;margin:-6px auto 3px}.capacity-count{font-size:13px;color:#8e8060;margin:4px 0 12px}.capacity-count .cat-dialog-text{color:#d69d27;font-weight:650;font-size:16px}.capacity-dialog .cat-dialog-copy{margin-bottom:20px}.cat-dialog .cat-dialog-secondary{width:100%;border:1px solid #79715c;background:#fff;border-radius:12px;padding:10px;margin-top:9px;font-weight:600}.cat-dialog .cat-dialog-later{background:none;color:#a29b88;width:100%;margin-top:3px;font-size:12px}@keyframes cat-welcome-in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}@media (max-width:340px){.cat-dialog-mask{padding:18px}.cat-dialog{padding:22px 17px 16px}.cat-dialog-title{font-size:20px}.cat-dialog-copy{font-size:12px}.greeting-art{height:103px}.greeting-art>.greeting-image{height:103px}.greeting-reward{margin:16px 0}}@media (prefers-reduced-motion:reduce){.cat-dialog{animation:none}}
